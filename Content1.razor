using System;
using System.IO;
using System.Security.Cryptography;
using Microsoft.AspNetCore.DataProtection;
using Microsoft.Extensions.Configuration;

namespace CorpWiki.Infrastructure.Security;

/// <summary>
/// Cifra/descifra cadenas de conexión usando Data Protection API,
/// protegido con DPAPI (ligado a tu usuario de Windows). Solo para desarrollo local.
/// </summary>
public static class ConnectionStringProtector
{
    private const string Purpose = "CorpWiki.ConnectionStrings.v1";
    private const string EncryptedPrefix = "ENC:";

    private static string GetKeysPath(IConfiguration configuration)
    {
        var path = configuration["DataProtection:KeysPath"]
                   ?? Path.Combine(AppContext.BaseDirectory, "..", "..", "..", "keys-DO-NOT-COMMIT");
        return Path.GetFullPath(path);
    }

    private static IDataProtector CreateProtector(IConfiguration configuration)
    {
        var keysPath = GetKeysPath(configuration);
        Directory.CreateDirectory(keysPath);

        var provider = DataProtectionProvider.Create(
            new DirectoryInfo(keysPath),
            builder =>
            {
                builder.SetApplicationName("CorpWiki");

                if (OperatingSystem.IsWindows())
                {
                    builder.ProtectKeysWithDpapiNG();
                }
            });

        return provider.CreateProtector(Purpose);
    }

    public static string Protect(string plainText, IConfiguration configuration)
    {
        var protector = CreateProtector(configuration);
        return EncryptedPrefix + protector.Protect(plainText);
    }

    public static string Resolve(string value, IConfiguration configuration)
    {
        if (string.IsNullOrEmpty(value) || !value.StartsWith(EncryptedPrefix, StringComparison.Ordinal))
            return value;

        var protector = CreateProtector(configuration);
        var cipherText = value[EncryptedPrefix.Length..];

        try
        {
            return protector.Unprotect(cipherText);
        }
        catch (CryptographicException ex)
        {
            throw new InvalidOperationException(
                "No se pudo descifrar la cadena de conexión. " +
                "Verifique que DataProtection:KeysPath sea la misma carpeta con la que se cifró originalmente.", ex);
        }
    }
}






