private void NotifyResponsibleAssigned(
    Guid incidentId, string incidentCode, string incidentTitle, string areaName,
    SecurityUser target, Guid actorUserId, string actorName, NotificationType notifType)
{
    if (target.Id == actorUserId) return; // no notificar cuando alguien se autoasigna

    _ = Task.Run(async () =>
    {
        try
        {
            await _notificationService.CreateIncidentNotificationAsync(
                recipientUserId: target.Id,
                actorUserId: actorUserId,
                incidentId: incidentId,
                type: notifType);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error creando notificación in-app de incidencia {Codigo} para {UserId}", incidentCode, target.Id);
        }

        if (string.IsNullOrWhiteSpace(target.Email)) return;

        try
        {
            await _emailSender.EnviarCorreoIncidenciaAsignadaAsync(
                target.Email, actorName, incidentCode, incidentTitle, areaName,
                DateTime.Now.ToString("dd/MM/yyyy"));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error enviando correo de incidencia {Codigo} a {UserId}", incidentCode, target.Id);
        }
    });
}








