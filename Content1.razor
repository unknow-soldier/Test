Task<bool> InviteObserverAsync(Guid incidentId, Guid userId, Guid actorUserId, bool actingAsAdmin = false);
Task<bool> RemoveObserverAsync(Guid incidentId, Guid userId, Guid actorUserId, bool actingAsAdmin = false);




public async Task<bool> InviteObserverAsync(Guid incidentId, Guid userId, Guid actorUserId, bool actingAsAdmin = false)
{
    await using var db = await _dbFactory.CreateDbContextAsync();

    var incident = await db.Incidents.FirstOrDefaultAsync(i => i.Id == incidentId);
    if (incident == null) return false;

    if (!actingAsAdmin)
    {
        var fueResponsable = await db.IncidentParticipants.AnyAsync(p =>
            p.IncidentId == incidentId && p.SecurityUserId == actorUserId && p.Role == IncidentParticipantRole.Responsable);
        if (!fueResponsable) return false;
    }

    var user = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == userId);
    if (user == null) return false;

    var existingRow = await db.IncidentParticipants.FirstOrDefaultAsync(p =>
        p.IncidentId == incidentId && p.SecurityUserId == userId && p.RemovedAt == null);
    if (existingRow != null) return true; // ya tiene algún acceso activo

    var now = DateTime.Now;
    db.IncidentParticipants.Add(new IncidentParticipant
    {
        Id = Guid.NewGuid(), IncidentId = incidentId, SecurityUserId = userId,
        AreaId = incident.CurrentAreaId, Role = IncidentParticipantRole.Observador, AssignedAt = now
    });

    var actor = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == actorUserId);
    await LogActivityAsync(db, incidentId, IncidentActivityType.Editada, actorUserId,
        $"{actor?.FullName ?? "-"} invitó a {user.FullName} como observador.", now, newValue: user.FullName);

    await db.SaveChangesAsync();
    return true;
}

public async Task<bool> RemoveObserverAsync(Guid incidentId, Guid userId, Guid actorUserId, bool actingAsAdmin = false)
{
    await using var db = await _dbFactory.CreateDbContextAsync();

    if (!actingAsAdmin)
    {
        var fueResponsable = await db.IncidentParticipants.AnyAsync(p =>
            p.IncidentId == incidentId && p.SecurityUserId == actorUserId && p.Role == IncidentParticipantRole.Responsable);
        if (!fueResponsable) return false;
    }

    var row = await db.IncidentParticipants.FirstOrDefaultAsync(p =>
        p.IncidentId == incidentId && p.SecurityUserId == userId &&
        p.Role == IncidentParticipantRole.Observador && p.RemovedAt == null);
    if (row == null) return false;

    row.RemovedAt = DateTime.Now;

    var user = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == userId);
    var actor = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == actorUserId);
    await LogActivityAsync(db, incidentId, IncidentActivityType.Editada, actorUserId,
        $"{actor?.FullName ?? "-"} quitó a {user?.FullName ?? "-"} como observador.", DateTime.Now);

    await db.SaveChangesAsync();
    return true;
}






