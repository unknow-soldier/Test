public static class ConnectionStringProtector
{
    // Clave fija de 32 bytes en Base64
    private static readonly byte[] StaticKey = Convert.FromBase64String("z9xO7vP1/qK4mO2jL8nB5aC0fR3uW6xY9sV2oE5hHIg=");

    public static string DecryptConnectionString(string? connectionString)
    {
        if (string.IsNullOrWhiteSpace(connectionString))
            return string.Empty;

        // Si la cadena no está encriptada, la retorna intacta
        if (!connectionString.StartsWith("ENC(", StringComparison.OrdinalIgnoreCase) && 
            !connectionString.StartsWith("ENC:", StringComparison.OrdinalIgnoreCase))
        {
            return connectionString;
        }

        // Extraer el texto base64 dentro de ENC(...) o después de ENC:
        string cipherTextBase64 = connectionString;
        if (cipherTextBase64.StartsWith("ENC(", StringComparison.OrdinalIgnoreCase) && cipherTextBase64.EndsWith(")"))
        {
            cipherTextBase64 = cipherTextBase64.Substring(4, cipherTextBase64.Length - 5);
        }
        else if (cipherTextBase64.StartsWith("ENC:", StringComparison.OrdinalIgnoreCase))
        {
            cipherTextBase64 = cipherTextBase64.Substring(4);
        }

        return DecryptAesGcm(cipherTextBase64.Trim());
    }

    private static string DecryptAesGcm(string cipherTextBase64)
    {
        byte[] fullBytes = Convert.FromBase64String(cipherTextBase64);

        // Estructura: Nonce (12 bytes) + Tag (16 bytes) + CipherText
        ReadOnlySpan<byte> nonce = fullBytes.AsSpan(0, 12);
        ReadOnlySpan<byte> tag = fullBytes.AsSpan(12, 16);
        ReadOnlySpan<byte> cipherBytes = fullBytes.AsSpan(28);

        byte[] decryptedBytes = new byte[cipherBytes.Length];

        using var aesGcm = new AesGcm(StaticKey, 16);
        aesGcm.Decrypt(nonce, cipherBytes, tag, decryptedBytes);

        return Encoding.UTF8.GetString(decryptedBytes);
    }
}







