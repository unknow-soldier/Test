using CorpWiki.Application.DTOs.Incidents;
using CorpWiki.Domain.Entities;
using CorpWiki.Domain.Entities.Incidents;
using CorpWiki.Domain.Entities.Security;

namespace CorpWiki.Application.Interfaces;

/// <summary>
/// Contrato del servicio de Incidencias, respaldado por EF Core / SQL Server.
/// Todos los usuarios referenciados son SecurityUser (no existe más IncidentUser).
/// La relación Incidencia-Usuario es N:N vía IncidentParticipant.
/// </summary>
public interface IIncidentService
{
    // Áreas
    Task<IReadOnlyList<Area>> GetAreasAsync();
    Task<Area?> GetAreaByIdAsync(Guid id);

    // Usuarios
    Task<IReadOnlyList<SecurityUser>> GetUsersAsync();
    Task<IReadOnlyList<SecurityUser>> GetUsersByAreaAsync(Guid areaId);
    Task<SecurityUser?> GetUserByIdAsync(Guid id);

    // Incidencias
    Task<IReadOnlyList<Incident>> GetIncidentsAsync();
    Task<IReadOnlyList<IncidentActivityFeedDto>> GetRecentActivityAsync(int take = 12);
    Task<Incident?> GetIncidentByIdAsync(Guid id);
    Task<IReadOnlyList<IncidentSummaryDto>> GetIncidentSummariesAsync();
    Task<IncidentDetailDto?> GetIncidentDetailAsync(Guid id);

    Task<Incident> CreateIncidentAsync(
        string title,
        string description,
        Guid areaId,
        IncidentPriority priority,
        Guid createdByUserId,
        Guid? initialResponsibleUserId,
        List<ArticleContentBlock>? content = null);

    Task AssignResponsibleAsync(Guid incidentId, Guid userId, Guid actorUserId);
    Task ChangeStatusAsync(Guid incidentId, IncidentStatus newStatus, Guid actorUserId);
    Task AddCommentAsync(Guid incidentId, Guid authorUserId, string text);
    Task AddAttachmentAsync(Guid incidentId, string fileName, string fileType, Guid uploadedByUserId);
    Task TransferIncidentAsync(Guid incidentId, Guid toAreaId, Guid toUserId, string reason, Guid actorUserId);
    Task CloseIncidentAsync(Guid incidentId, Guid actorUserId);
    Task UpdateIncidentContentAsync(Guid incidentId, List<ArticleContentBlock> content, Guid actorUserId);

    /// <summary>Devuelve false si actorUserId no es el creador o si la incidencia no está Cerrada.</summary>
    Task<bool> ReactivateIncidentAsync(Guid incidentId, Guid actorUserId);

    // Participantes (N:N Incident-SecurityUser)
    Task<IReadOnlyList<SecurityUser>> GetParticipantsAsync(Guid incidentId);
    Task AddParticipantAsync(Guid incidentId, Guid securityUserId, IncidentParticipantRole role, Guid actorUserId);
    Task RemoveParticipantAsync(Guid incidentId, Guid securityUserId, Guid actorUserId);

    // Comentarios / Transferencias / Actividad / Adjuntos / Artículos
    Task<IReadOnlyList<IncidentComment>> GetCommentsByIncidentAsync(Guid incidentId);
    Task<IReadOnlyList<IncidentTransfer>> GetTransfersByIncidentAsync(Guid incidentId);
    Task<IReadOnlyList<IncidentActivityEntry>> GetActivityByIncidentAsync(Guid incidentId);
    Task<IReadOnlyList<IncidentAttachment>> GetAttachmentsByIncidentAsync(Guid incidentId);
    Task<IReadOnlyList<IncidentRelatedArticle>> GetRelatedArticlesAsync(Guid incidentId);

    // KPIs / Dashboard
    Task<IncidentKpiSnapshotDto> GetKpiSnapshotAsync();
    Task<IReadOnlyList<AreaLoadDto>> GetLoadByAreaAsync();
    Task<IReadOnlyList<ResponsibleLoadDto>> GetLoadByResponsibleAsync();
}





using CorpWiki.Application.DTOs.Incidents;
using CorpWiki.Application.Helpers;
using CorpWiki.Application.Interfaces;
using CorpWiki.Domain.Entities;
using CorpWiki.Domain.Entities.Incidents;
using CorpWiki.Domain.Entities.Security;
using CorpWiki.Infrastructure.Persistence;
using Microsoft.EntityFrameworkCore;

namespace CorpWiki.Infrastructure.Services;

/// <summary>
/// Implementación real de IIncidentService respaldada por EF Core / SQL Server.
/// Reemplaza a MockIncidentService. Registrar como Scoped en Program.cs.
/// </summary>
public class IncidentService : IIncidentService
{
    private readonly DaviWikiDbContext _db;

    public IncidentService(DaviWikiDbContext db)
    {
        _db = db;
    }

    // =========================================================================
    // ÁREAS / USUARIOS
    // =========================================================================

    public async Task<IReadOnlyList<Area>> GetAreasAsync() =>
        await _db.Areas.OrderBy(a => a.Name).ToListAsync();

    public async Task<Area?> GetAreaByIdAsync(Guid id) =>
        await _db.Areas.FirstOrDefaultAsync(a => a.Id == id);

    public async Task<IReadOnlyList<SecurityUser>> GetUsersAsync() =>
        await _db.SecurityUsers.Where(u => u.IsActive).OrderBy(u => u.FullName).ToListAsync();

    public async Task<IReadOnlyList<SecurityUser>> GetUsersByAreaAsync(Guid areaId) =>
        await _db.SecurityUsers.Where(u => u.IsActive && u.AreaId == areaId)
            .OrderBy(u => u.FullName).ToListAsync();

    public async Task<SecurityUser?> GetUserByIdAsync(Guid id) =>
        await _db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == id);

    // =========================================================================
    // LECTURA DE INCIDENCIAS
    // =========================================================================

    public async Task<IReadOnlyList<Incident>> GetIncidentsAsync() =>
        await _db.Incidents.OrderByDescending(i => i.UpdatedAt).ToListAsync();

    public async Task<Incident?> GetIncidentByIdAsync(Guid id) =>
        await _db.Incidents.FirstOrDefaultAsync(i => i.Id == id);

    public async Task<IReadOnlyList<IncidentSummaryDto>> GetIncidentSummariesAsync()
    {
        var incidents = await _db.Incidents
            .OrderByDescending(i => i.UpdatedAt)
            .ToListAsync();

        var result = new List<IncidentSummaryDto>();
        foreach (var incident in incidents)
            result.Add(await ToSummaryDtoAsync(incident));

        return result;
    }

    public async Task<IncidentDetailDto?> GetIncidentDetailAsync(Guid id)
    {
        var incident = await GetIncidentByIdAsync(id);
        if (incident == null) return null;

        var (activeHours, deadHours) = await ComputeHoursAsync(id);
        var area = await GetAreaByIdAsync(incident.CurrentAreaId);
        var originArea = await GetAreaByIdAsync(incident.OriginAreaId);
        var responsible = incident.CurrentResponsibleId.HasValue
            ? await GetUserByIdAsync(incident.CurrentResponsibleId.Value)
            : null;
        var creator = await GetUserByIdAsync(incident.CreatedByUserId);

        var comments = await GetCommentsByIncidentAsync(id);
        var transfers = await GetTransfersByIncidentAsync(id);
        var activity = await GetActivityByIncidentAsync(id);
        var attachments = await GetAttachmentsByIncidentAsync(id);
        var related = await GetRelatedArticlesAsync(id);
        var segments = await _db.IncidentTimeSegments
            .Where(s => s.IncidentId == id)
            .OrderBy(s => s.StartedAt)
            .ToListAsync();

        var commentDtos = new List<IncidentCommentDto>();
        foreach (var c in comments.OrderBy(c => c.CreatedAt))
            commentDtos.Add(await ToCommentDtoAsync(c));

        var transferDtos = new List<IncidentTransferDto>();
        foreach (var t in transfers.OrderBy(t => t.TransferredAt))
            transferDtos.Add(await ToTransferDtoAsync(t));

        var activityDtos = new List<IncidentActivityDto>();
        foreach (var a in activity.OrderBy(a => a.OccurredAt))
            activityDtos.Add(await ToActivityDtoAsync(a));

        var segmentDtos = new List<IncidentTimeSegmentDto>();
        foreach (var s in segments)
            segmentDtos.Add(await ToSegmentDtoAsync(s));

        return new IncidentDetailDto
        {
            Id = incident.Id,
            Code = incident.Code,
            Title = incident.Title,
            Description = incident.Description,
            Status = incident.Status,
            Priority = incident.Priority,
            OriginAreaId = incident.OriginAreaId,
            OriginAreaName = originArea?.Name ?? "-",
            OriginAreaColor = originArea?.Color ?? "#334155",
            CurrentAreaId = incident.CurrentAreaId,
            CurrentAreaName = area?.Name ?? "-",
            CurrentAreaColor = area?.Color ?? "#334155",
            CreatedByName = creator?.FullName ?? "-",
            CreatedByUserId = incident.CreatedByUserId,
            CreatedByAvatarColorFrom = creator?.AvatarColorFrom,
            CreatedByAvatarColorTo = creator?.AvatarColorTo,
            CreatedByInitials = GetInitials(creator?.FullName),
            ResponsibleId = incident.CurrentResponsibleId,
            ResponsibleName = responsible?.FullName,
            ResponsibleInitials = GetInitials(responsible?.FullName),
            ResponsibleAvatarColorFrom = responsible?.AvatarColorFrom,
            ResponsibleAvatarColorTo = responsible?.AvatarColorTo,
            CreatedAt = incident.CreatedAt,
            UpdatedAt = incident.UpdatedAt,
            ClosedAt = incident.ClosedAt,
            ReactivationCount = incident.ReactivationCount,
            TotalActiveHours = activeHours,
            TotalDeadHours = deadHours,
            TotalHours = activeHours + deadHours,
            Comments = commentDtos,
            Transfers = transferDtos,
            Activity = activityDtos,
            TimeSegments = segmentDtos,
            Attachments = attachments.OrderBy(a => a.UploadedAt).ToList(),
            RelatedArticles = related.ToList(),
            Content = incident.Content
        };
    }

    public async Task<IReadOnlyList<IncidentComment>> GetCommentsByIncidentAsync(Guid incidentId) =>
        await _db.IncidentComments.Where(c => c.IncidentId == incidentId).ToListAsync();

    public async Task<IReadOnlyList<IncidentTransfer>> GetTransfersByIncidentAsync(Guid incidentId) =>
        await _db.IncidentTransfers.Where(t => t.IncidentId == incidentId).ToListAsync();

    public async Task<IReadOnlyList<IncidentActivityEntry>> GetActivityByIncidentAsync(Guid incidentId) =>
        await _db.IncidentActivityEntries.Where(a => a.IncidentId == incidentId).ToListAsync();

    public async Task<IReadOnlyList<IncidentAttachment>> GetAttachmentsByIncidentAsync(Guid incidentId) =>
        await _db.IncidentAttachments.Where(a => a.IncidentId == incidentId).ToListAsync();

    public async Task<IReadOnlyList<IncidentRelatedArticle>> GetRelatedArticlesAsync(Guid incidentId)
    {
        var incident = await GetIncidentByIdAsync(incidentId);
        if (incident == null || incident.RelatedArticleIds.Count == 0)
            return new List<IncidentRelatedArticle>();

        // NOTA: IncidentRelatedArticle en tu modelo actual no tiene tabla propia
        // ni FK a IncidentId; si la migras a tabla real, cambia esto por una query
        // directa filtrando por IncidentId. Por ahora se asume un catálogo aparte
        // (p.ej. tabla ArticleReferences) que se busca por Id.
        return await _db.IncidentRelatedArticles
            .Where(a => incident.RelatedArticleIds.Contains(a.Id))
            .ToListAsync();
    }

    // =========================================================================
    // PARTICIPANTES (N:N)
    // =========================================================================

    public async Task<IReadOnlyList<SecurityUser>> GetParticipantsAsync(Guid incidentId)
    {
        return await _db.IncidentParticipants
            .Where(p => p.IncidentId == incidentId && p.RemovedAt == null)
            .Include(p => p.SecurityUser)
            .Select(p => p.SecurityUser)
            .ToListAsync();
    }

    public async Task AddParticipantAsync(Guid incidentId, Guid securityUserId, IncidentParticipantRole role, Guid actorUserId)
    {
        var exists = await _db.IncidentParticipants.AnyAsync(p =>
            p.IncidentId == incidentId && p.SecurityUserId == securityUserId && p.RemovedAt == null);
        if (exists) return;

        _db.IncidentParticipants.Add(new IncidentParticipant
        {
            Id = Guid.NewGuid(),
            IncidentId = incidentId,
            SecurityUserId = securityUserId,
            Role = role,
            AssignedAt = DateTime.Now
        });

        var user = await GetUserByIdAsync(securityUserId);
        var actor = await GetUserByIdAsync(actorUserId);
        await LogActivityAsync(incidentId, IncidentActivityType.Editada, actorUserId,
            $"{actor?.FullName ?? "-"} agregó a {user?.FullName ?? "-"} como {role} en la incidencia.", DateTime.Now);

        await _db.SaveChangesAsync();
    }

    public async Task RemoveParticipantAsync(Guid incidentId, Guid securityUserId, Guid actorUserId)
    {
        var participant = await _db.IncidentParticipants.FirstOrDefaultAsync(p =>
            p.IncidentId == incidentId && p.SecurityUserId == securityUserId && p.RemovedAt == null);
        if (participant == null) return;

        participant.RemovedAt = DateTime.Now;

        var user = await GetUserByIdAsync(securityUserId);
        var actor = await GetUserByIdAsync(actorUserId);
        await LogActivityAsync(incidentId, IncidentActivityType.Editada, actorUserId,
            $"{actor?.FullName ?? "-"} quitó a {user?.FullName ?? "-"} de la incidencia.", DateTime.Now);

        await _db.SaveChangesAsync();
    }

    // =========================================================================
    // ESCRITURA
    // =========================================================================

    public async Task<Incident> CreateIncidentAsync(
        string title,
        string description,
        Guid areaId,
        IncidentPriority priority,
        Guid createdByUserId,
        Guid? initialResponsibleUserId,
        List<ArticleContentBlock>? content = null)
    {
        var now = DateTime.Now;
        var count = await _db.Incidents.CountAsync();
        var code = $"INC-{(count + 1):D4}";

        var incident = new Incident
        {
            Id = Guid.NewGuid(),
            Code = code,
            Title = title.Trim(),
            Description = description?.Trim() ?? string.Empty,
            OriginAreaId = areaId,
            CurrentAreaId = areaId,
            CreatedByUserId = createdByUserId,
            CurrentResponsibleId = initialResponsibleUserId,
            Priority = priority,
            Status = initialResponsibleUserId.HasValue ? IncidentStatus.Asignada : IncidentStatus.Nueva,
            CreatedAt = now,
            UpdatedAt = now,
            Content = content ?? new()
        };

        _db.Incidents.Add(incident);

        // El creador siempre queda como participante.
        _db.IncidentParticipants.Add(new IncidentParticipant
        {
            Id = Guid.NewGuid(),
            IncidentId = incident.Id,
            SecurityUserId = createdByUserId,
            Role = IncidentParticipantRole.Colaborador,
            AssignedAt = now
        });

        var creator = await GetUserByIdAsync(createdByUserId);
        await LogActivityAsync(incident.Id, IncidentActivityType.Creada, createdByUserId,
            $"{creator?.FullName ?? "Alguien"} creó la incidencia \"{incident.Title}\".", now);

        _db.IncidentTimeSegments.Add(new IncidentTimeSegment
        {
            Id = Guid.NewGuid(),
            IncidentId = incident.Id,
            AreaId = areaId,
            UserId = initialResponsibleUserId,
            StartedAt = now,
            IsActiveWork = initialResponsibleUserId.HasValue
        });

        if (initialResponsibleUserId.HasValue)
        {
            _db.IncidentParticipants.Add(new IncidentParticipant
            {
                Id = Guid.NewGuid(),
                IncidentId = incident.Id,
                SecurityUserId = initialResponsibleUserId.Value,
                Role = IncidentParticipantRole.Responsable,
                AssignedAt = now
            });

            var responsible = await GetUserByIdAsync(initialResponsibleUserId.Value);
            await LogActivityAsync(incident.Id, IncidentActivityType.Asignada, createdByUserId,
                $"Asignada a {responsible?.FullName ?? "-"} al crearse.", now);
        }

        await _db.SaveChangesAsync();
        return incident;
    }

    public async Task AssignResponsibleAsync(Guid incidentId, Guid userId, Guid actorUserId)
    {
        var incident = await GetIncidentByIdAsync(incidentId);
        if (incident == null) return;

        var now = DateTime.Now;
        await CloseTimeSegmentAsync(incidentId, now);

        incident.CurrentResponsibleId = userId;
        if (incident.Status == IncidentStatus.Nueva) incident.Status = IncidentStatus.Asignada;
        incident.UpdatedAt = now;

        _db.IncidentTimeSegments.Add(new IncidentTimeSegment
        {
            Id = Guid.NewGuid(),
            IncidentId = incidentId,
            AreaId = incident.CurrentAreaId,
            UserId = userId,
            StartedAt = now,
            IsActiveWork = true
        });

        // Asegura que el nuevo responsable también quede como participante.
        var alreadyParticipant = await _db.IncidentParticipants.AnyAsync(p =>
            p.IncidentId == incidentId && p.SecurityUserId == userId && p.RemovedAt == null);
        if (!alreadyParticipant)
        {
            _db.IncidentParticipants.Add(new IncidentParticipant
            {
                Id = Guid.NewGuid(),
                IncidentId = incidentId,
                SecurityUserId = userId,
                Role = IncidentParticipantRole.Responsable,
                AssignedAt = now
            });
        }

        var user = await GetUserByIdAsync(userId);
        await LogActivityAsync(incidentId, IncidentActivityType.Asignada, actorUserId,
            $"{user?.FullName ?? "-"} fue asignado como responsable.", now);

        await _db.SaveChangesAsync();
    }

    public async Task ChangeStatusAsync(Guid incidentId, IncidentStatus newStatus, Guid actorUserId)
    {
        var incident = await GetIncidentByIdAsync(incidentId);
        if (incident == null) return;

        var now = DateTime.Now;
        incident.Status = newStatus;
        incident.UpdatedAt = now;

        var actor = await GetUserByIdAsync(actorUserId);
        await LogActivityAsync(incidentId, IncidentActivityType.CambioEstado, actorUserId,
            $"{actor?.FullName ?? "-"} cambió el estado a {IncidentLabels.Status(newStatus)}.", now);

        await _db.SaveChangesAsync();
    }

    public async Task AddCommentAsync(Guid incidentId, Guid authorUserId, string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        var now = DateTime.Now;

        _db.IncidentComments.Add(new IncidentComment
        {
            Id = Guid.NewGuid(),
            IncidentId = incidentId,
            AuthorUserId = authorUserId,
            Text = text.Trim(),
            CreatedAt = now
        });

        var incident = await GetIncidentByIdAsync(incidentId);
        if (incident != null) incident.UpdatedAt = now;

        var author = await GetUserByIdAsync(authorUserId);
        await LogActivityAsync(incidentId, IncidentActivityType.ComentarioAgregado, authorUserId,
            $"{author?.FullName ?? "-"} comentó en la incidencia.", now);

        await _db.SaveChangesAsync();
    }

    public async Task AddAttachmentAsync(Guid incidentId, string fileName, string fileType, Guid uploadedByUserId)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return;
        var now = DateTime.Now;

        _db.IncidentAttachments.Add(new IncidentAttachment
        {
            Id = Guid.NewGuid(),
            IncidentId = incidentId,
            FileName = fileName.Trim(),
            FileType = string.IsNullOrWhiteSpace(fileType) ? "file" : fileType,
            SizeLabel = "-", // el tamaño real debería venir de quien sube el archivo
            UploadedByUserId = uploadedByUserId,
            UploadedAt = now
        });

        var uploader = await GetUserByIdAsync(uploadedByUserId);
        await LogActivityAsync(incidentId, IncidentActivityType.ArchivoAdjuntado, uploadedByUserId,
            $"{uploader?.FullName ?? "-"} adjuntó \"{fileName}\".", now);

        await _db.SaveChangesAsync();
    }

    public async Task TransferIncidentAsync(Guid incidentId, Guid toAreaId, Guid toUserId, string reason, Guid actorUserId)
    {
        var incident = await GetIncidentByIdAsync(incidentId);
        if (incident == null) return;

        var now = DateTime.Now;
        await CloseTimeSegmentAsync(incidentId, now);

        _db.IncidentTransfers.Add(new IncidentTransfer
        {
            Id = Guid.NewGuid(),
            IncidentId = incidentId,
            FromUserId = incident.CurrentResponsibleId ?? actorUserId,
            ToUserId = toUserId,
            FromAreaId = incident.CurrentAreaId,
            ToAreaId = toAreaId,
            Reason = string.IsNullOrWhiteSpace(reason) ? "Sin motivo especificado." : reason.Trim(),
            TransferredAt = now
        });

        var fromArea = await GetAreaByIdAsync(incident.CurrentAreaId);
        var toArea = await GetAreaByIdAsync(toAreaId);
        var toUser = await GetUserByIdAsync(toUserId);

        incident.CurrentAreaId = toAreaId;
        incident.CurrentResponsibleId = toUserId;
        incident.Status = IncidentStatus.PendienteOtraArea;
        incident.UpdatedAt = now;

        _db.IncidentTimeSegments.Add(new IncidentTimeSegment
        {
            Id = Guid.NewGuid(),
            IncidentId = incidentId,
            AreaId = toAreaId,
            UserId = toUserId,
            StartedAt = now,
            IsActiveWork = false
        });

        var alreadyParticipant = await _db.IncidentParticipants.AnyAsync(p =>
            p.IncidentId == incidentId && p.SecurityUserId == toUserId && p.RemovedAt == null);
        if (!alreadyParticipant)
        {
            _db.IncidentParticipants.Add(new IncidentParticipant
            {
                Id = Guid.NewGuid(),
                IncidentId = incidentId,
                SecurityUserId = toUserId,
                Role = IncidentParticipantRole.Responsable,
                AssignedAt = now
            });
        }

        await LogActivityAsync(incidentId, IncidentActivityType.Transferida, actorUserId,
            $"Transferida de {fromArea?.Name ?? "-"} a {toArea?.Name ?? "-"} (nuevo responsable: {toUser?.FullName ?? "-"}).", now);

        await _db.SaveChangesAsync();
    }

    public async Task CloseIncidentAsync(Guid incidentId, Guid actorUserId)
    {
        var incident = await GetIncidentByIdAsync(incidentId);
        if (incident == null) return;

        var now = DateTime.Now;
        await CloseTimeSegmentAsync(incidentId, now);

        incident.Status = IncidentStatus.Cerrada;
        incident.ClosedAt = now;
        incident.UpdatedAt = now;

        var actor = await GetUserByIdAsync(actorUserId);
        await LogActivityAsync(incidentId, IncidentActivityType.Cerrada, actorUserId,
            $"{actor?.FullName ?? "-"} cerró la incidencia.", now);

        await _db.SaveChangesAsync();
    }

    public async Task<bool> ReactivateIncidentAsync(Guid incidentId, Guid actorUserId)
    {
        var incident = await GetIncidentByIdAsync(incidentId);
        if (incident == null) return false;
        if (incident.CreatedByUserId != actorUserId) return false;
        if (incident.Status != IncidentStatus.Cerrada) return false;

        var now = DateTime.Now;
        incident.Status = IncidentStatus.Reactivada;
        incident.ClosedAt = null;
        incident.ReactivationCount++;
        incident.UpdatedAt = now;

        _db.IncidentTimeSegments.Add(new IncidentTimeSegment
        {
            Id = Guid.NewGuid(),
            IncidentId = incidentId,
            AreaId = incident.CurrentAreaId,
            UserId = incident.CurrentResponsibleId,
            StartedAt = now,
            IsActiveWork = true
        });

        var actor = await GetUserByIdAsync(actorUserId);
        await LogActivityAsync(incidentId, IncidentActivityType.Reactivada, actorUserId,
            $"{actor?.FullName ?? "-"} (creador) reactivó la incidencia.", now);

        await _db.SaveChangesAsync();
        return true;
    }

    public async Task UpdateIncidentContentAsync(Guid incidentId, List<ArticleContentBlock> content, Guid actorUserId)
    {
        var incident = await GetIncidentByIdAsync(incidentId);
        if (incident == null) return;

        incident.Content = content;
        incident.UpdatedAt = DateTime.Now;

        var actor = await GetUserByIdAsync(actorUserId);
        await LogActivityAsync(incident.Id, IncidentActivityType.Editada, actorUserId,
            $"{actor?.FullName ?? "Alguien"} actualizó la descripción detallada.", DateTime.Now);

        await _db.SaveChangesAsync();
    }

    // =========================================================================
    // KPIs
    // =========================================================================

    public async Task<IncidentKpiSnapshotDto> GetKpiSnapshotAsync()
    {
        var incidents = await _db.Incidents.ToListAsync();
        var active = incidents.Where(i => i.Status != IncidentStatus.Cerrada).ToList();
        var closed = incidents.Where(i => i.Status == IncidentStatus.Cerrada).ToList();

        var avgResolutionHours = closed.Count > 0
            ? closed.Average(i => (i.ClosedAt!.Value - i.CreatedAt).TotalHours)
            : 0;

        double avgDeadHours = 0;
        if (incidents.Count > 0)
        {
            var totalDead = 0.0;
            foreach (var i in incidents)
                totalDead += (await ComputeHoursAsync(i.Id)).DeadHours;
            avgDeadHours = totalDead / incidents.Count;
        }

        var loadByArea = await GetLoadByAreaAsync();
        var loadByResponsible = await GetLoadByResponsibleAsync();
        var areas = await GetAreasAsync();

        var avgTimeByArea = new List<AreaAvgTimeDto>();
        foreach (var area in areas)
        {
            avgTimeByArea.Add(new AreaAvgTimeDto
            {
                AreaName = area.Name,
                AreaColor = area.Color,
                AvgHours = Math.Round(await AverageHoursForAreaAsync(area.Id), 1)
            });
        }

        return new IncidentKpiSnapshotDto
        {
            ActiveCount = active.Count,
            ClosedCount = closed.Count,
            ReactivatedCount = incidents.Count(i => i.ReactivationCount > 0),
            AvgResolutionHours = Math.Round(avgResolutionHours, 1),
            AvgDeadHours = Math.Round(avgDeadHours, 1),
            TopAreaByLoad = loadByArea.OrderByDescending(a => a.Count).FirstOrDefault(),
            TopResponsible = loadByResponsible.OrderByDescending(r => r.Count).FirstOrDefault(),
            LoadByArea = loadByArea.ToList(),
            LoadByResponsible = loadByResponsible.ToList(),
            StatusDistribution = Enum.GetValues<IncidentStatus>()
                .Select(s => new StatusCountDto { Status = s, Count = incidents.Count(i => i.Status == s) })
                .Where(d => d.Count > 0)
                .ToList(),
            PriorityDistribution = Enum.GetValues<IncidentPriority>()
                .Select(p => new PriorityCountDto { Priority = p, Count = incidents.Count(i => i.Priority == p) })
                .Where(d => d.Count > 0)
                .ToList(),
            AvgTimeByArea = avgTimeByArea
        };
    }

    public async Task<IReadOnlyList<AreaLoadDto>> GetLoadByAreaAsync()
    {
        var areas = await _db.Areas.ToListAsync();
        var result = new List<AreaLoadDto>();

        foreach (var area in areas)
        {
            var count = await _db.Incidents.CountAsync(i =>
                i.CurrentAreaId == area.Id && i.Status != IncidentStatus.Cerrada);

            result.Add(new AreaLoadDto
            {
                AreaName = area.Name,
                AreaColor = area.Color,
                Count = count
            });
        }

        return result.OrderByDescending(a => a.Count).ToList();
    }

    public async Task<IReadOnlyList<ResponsibleLoadDto>> GetLoadByResponsibleAsync()
    {
        var grouped = await _db.Incidents
            .Where(i => i.CurrentResponsibleId.HasValue && i.Status != IncidentStatus.Cerrada)
            .GroupBy(i => i.CurrentResponsibleId!.Value)
            .Select(g => new { UserId = g.Key, Count = g.Count() })
            .OrderByDescending(g => g.Count)
            .Take(10)
            .ToListAsync();

        var result = new List<ResponsibleLoadDto>();
        foreach (var g in grouped)
        {
            var user = await GetUserByIdAsync(g.UserId);
            result.Add(new ResponsibleLoadDto
            {
                UserName = user?.FullName ?? "-",
                Initials = GetInitials(user?.FullName),
                Count = g.Count
            });
        }

        return result;
    }

    public async Task<IReadOnlyList<IncidentActivityFeedDto>> GetRecentActivityAsync(int take = 12)
    {
        var entries = await _db.IncidentActivityEntries
            .OrderByDescending(a => a.OccurredAt)
            .Take(take)
            .ToListAsync();

        var result = new List<IncidentActivityFeedDto>();
        foreach (var a in entries)
        {
            var incident = await GetIncidentByIdAsync(a.IncidentId);
            var actor = await GetUserByIdAsync(a.ActorUserId);
            result.Add(new IncidentActivityFeedDto
            {
                Id = a.Id,
                IncidentId = a.IncidentId,
                IncidentCode = incident?.Code ?? "-",
                IncidentTitle = incident?.Title ?? "-",
                Type = a.Type,
                ActorName = actor?.FullName ?? "-",
                Description = a.Description,
                OccurredAt = a.OccurredAt
            });
        }

        return result;
    }

