    public async Task<bool> CanUserAccessIncidentAsync(Guid incidentId, Guid userId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var incident = await db.Incidents.FirstOrDefaultAsync(i => i.Id == incidentId);
        if (incident == null) return false;
        if (incident.CreatedByUserId == userId) return true;

        return await db.IncidentParticipants.AnyAsync(p =>
            p.IncidentId == incidentId && p.SecurityUserId == userId &&
            p.Role == IncidentParticipantRole.Responsable);
    }

