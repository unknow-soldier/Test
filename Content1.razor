
private bool _isAdmin;

protected override async Task OnInitializedAsync()
{
    var authState = await _authStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;

    if (user.Identity is { IsAuthenticated: true })
    {
        _fullName = user.FindFirst("FullName")?.Value
            ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Usuario";
        _role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Usuario";
        _initials = GetInitials(_fullName);
    }

    _isAdmin = await SecurityService.IsAdminAsync();

    var authorId = await SecurityService.GetCurrentAuthorIdAsync();
    var me = (await Authors.GetAuthorsAsync()).FirstOrDefault(a => a.Id == authorId);
    if (me is null) { _isLoading = false; return; }

    _authorId = authorId;
    _categories = (await Categories.GetCategoriesAsync()).ToList();

    await ReloadAsync();

    _isLoading = false;
}








