public async Task<Guid> GetCurrentAuthorIdAsync()
{
    var securityUserId = await GetCurrentUserIdAsync(); // ya lee ClaimTypes.NameIdentifier, se reutiliza

    var authState = await _authStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;
    var userName = user.Identity?.Name ?? "Usuario Anónimo";
    var userEmail = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "anonimo@corp.com";

    var authors = await _authors.GetAuthorsAsync();
    var author = authors.FirstOrDefault(a => a.FullName == userName)
        ?? await _authors.CreateAuthorAsync(userName, userEmail);

    // Backfill: si el Author existe pero nunca quedó vinculado al login actual
    // (o el login cambió), lo sincronizamos para que ArticleOwnershipHandler funcione.
    if (securityUserId != Guid.Empty && author.SecurityUserId != securityUserId)
    {
        await _authors.LinkSecurityUserAsync(author.Id, securityUserId);
        author.SecurityUserId = securityUserId;
    }

    return author.Id;
}








// En la interfaz de autores (IAuthorDataService / IAuthorData, la que uses)
Task LinkSecurityUserAsync(Guid authorId, Guid securityUserId);




// En su implementación
public async Task LinkSecurityUserAsync(Guid authorId, Guid securityUserId)
{
    await using var db = await _dbFactory.CreateDbContextAsync();
    var author = await db.Authors.FirstOrDefaultAsync(a => a.Id == authorId);
    if (author is null) return;

    author.SecurityUserId = securityUserId;
    await db.SaveChangesAsync();
}



private bool _isLoading = true;

protected override async Task OnInitializedAsync()
{
    _original = await Data.GetArticleByIdAsync(ArticleId);
    if (_original is null)
    {
        _notFound = true;
        _isLoading = false;
        return;
    }

    _canEdit = await CheckOwnershipAsync();
    if (!_canEdit)
    {
        _isLoading = false;
        return;
    }

    _isAdmin = await SecurityService.IsAdminAsync();

    _categories = (await Categories.GetCategoriesAsync()).OrderBy(c => c.Name).ToList();
    _tags = (await Tags.GetPopularTagsAsync(40)).OrderBy(t => t.Name).ToList();

    _breadcrumb = new()
    {
        new("Inicio", "/"),
        new("Artículos", "/articulos"),
        new(_original.Title, null)
    };

    _model.Title = _original.Title;
    _model.Summary = _original.Summary;
    _model.CategoryId = _original.CategoryId;
    _model.AuthorId = _original.AuthorId;
    _model.TagIds = new List<Guid>(_original.TagIds);
    _model.CoverImageMediaId = _original.CoverImageMediaId;
    _model.IsFeatured = _original.IsFeatured;

    if (_original.CoverImageMediaId is Guid mediaId)
    {
        var media = await Media.GetMediaFileAsync(mediaId);
        _coverPreviewUrl = media?.Url;
    }

    _isLoading = false;
}




@if (_isLoading)
{
    <div class="page-loading">
        <div class="skeleton skeleton--title"></div>
        <div class="skeleton skeleton--line"></div>
        <div class="skeleton skeleton--line" style="width:60%"></div>
        <div class="skeleton skeleton--block"></div>
    </div>
}
else if (_notFound)
{
    <div class="empty-state">
        <Icon Name="file-text" Class="empty-state__icon" />
        <h3>No encontramos este artículo</h3>
        <a class="btn btn--primary" href="/articulos">Volver a Artículos</a>
    </div>
}
else if (!_canEdit)
{
    <div class="empty-state">
        <Icon Name="shield-off" Class="empty-state__icon" />
        <h3>No podés editar este artículo</h3>
        <p>Solo el autor original o un administrador de contenido pueden modificarlo.</p>
        <a class="btn btn--primary" href="/articulos">Volver a Artículos</a>
    </div>
}
else
{
    <Breadcrumb Items="_breadcrumb" />
    @* ...resto del formulario, sin cambios... *@
}




.page-loading { max-width: 720px; }
.skeleton {
    background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%);
    background-size: 200% 100%;
    animation: shimmer 1.4s ease-in-out infinite;
    border-radius: 8px;
}
.skeleton--title { height: 28px; width: 40%; margin-bottom: 18px; }
.skeleton--line { height: 14px; width: 80%; margin-bottom: 10px; }
.skeleton--block { height: 220px; width: 100%; margin-top: 20px; border-radius: 12px; }

@keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}