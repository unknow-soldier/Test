public async Task<bool> UpdateCommentAsync(Guid commentId, string content)
{
    await using var db = await _dbFactory.CreateDbContextAsync();
    var userId = await _securityService.GetCurrentUserIdAsync();
    if (userId == Guid.Empty) return false;
    if (string.IsNullOrWhiteSpace(content)) return false;

    var comment = await db.ArticleComments.FirstOrDefaultAsync(c => c.Id == commentId);
    if (comment == null || comment.UserId != userId) return false;

    if (comment.StatusId == (int)CommentStatusEnum.Deleted) return false; // no se edita un eliminado

    db.CommentAuditLogs.Add(new CommentAuditLog
    {
        Id = Guid.NewGuid(),
        CommentId = comment.Id,
        PreviousStatusId = comment.StatusId,
        NewStatusId = (int)CommentStatusEnum.Edited,
        PreviousContent = comment.Content,
        ChangedByUserId = userId,
        ChangedAt = DateTime.UtcNow
    });

    comment.Content = content.Trim();
    comment.UpdatedAt = DateTime.UtcNow;
    comment.StatusId = (int)CommentStatusEnum.Edited;
    await db.SaveChangesAsync();

    var updated = await db.ArticleComments.Include(c => c.User).FirstAsync(c => c.Id == commentId);
    var likesCount = await db.ArticleCommentLikes.CountAsync(l => l.CommentId == commentId);
    var isLikedByCurrentUser = await db.ArticleCommentLikes.AnyAsync(l => l.CommentId == commentId && l.UserId == userId);

    var dto = new CommentDto
    {
        Id = updated.Id,
        ParentCommentId = updated.ParentCommentId,
        Content = updated.Content,
        CreatedAt = updated.CreatedAt,
        UpdatedAt = updated.UpdatedAt,
        UserId = updated.UserId,
        StatusId = updated.StatusId,
        AuthorName = updated.User?.FullName ?? "Usuario",
        AuthorInitials = GetInitials(updated.User?.FullName),
        AuthorColorFrom = updated.User?.AvatarColorFrom ?? "#6366f1",
        AuthorColorTo = updated.User?.AvatarColorTo ?? "#8b5cf6",
        LikesCount = likesCount,
        IsLikedByCurrentUser = isLikedByCurrentUser,
        CanEditOrDelete = true
    };

    await _commentBroadcaster.CommentUpdatedAsync(updated.ArticleId, dto);
    return true;
}








public async Task<bool> DeleteCommentAsync(Guid commentId)
{
    await using var db = await _dbFactory.CreateDbContextAsync();
    var userId = await _securityService.GetCurrentUserIdAsync();
    if (userId == Guid.Empty) return false;

    var comment = await db.ArticleComments.FirstOrDefaultAsync(c => c.Id == commentId);
    if (comment == null || comment.UserId != userId) return false;

    if (comment.StatusId == (int)CommentStatusEnum.Deleted) return true; // idempotente

    db.CommentAuditLogs.Add(new CommentAuditLog
    {
        Id = Guid.NewGuid(),
        CommentId = comment.Id,
        PreviousStatusId = comment.StatusId,
        NewStatusId = (int)CommentStatusEnum.Deleted,
        PreviousContent = comment.Content,
        ChangedByUserId = userId,
        ChangedAt = DateTime.UtcNow
    });

    comment.StatusId = (int)CommentStatusEnum.Deleted;
    // Content, UserId, ParentCommentId, Replies: intactos. No se toca nada más.

    await db.SaveChangesAsync();

    await _commentBroadcaster.CommentStatusChangedAsync(comment.ArticleId, comment.Id, comment.StatusId);
    return true;
}







private Task OnCommentStatusChangedAsync(Guid articleId, Guid commentId, int newStatusId)
{
    if (_article is null || articleId != _article.Id) return Task.CompletedTask;

    return InvokeAsync(() =>
    {
        var target = _comments.FirstOrDefault(c => c.Id == commentId)
                     ?? _comments.SelectMany(c => c.Replies).FirstOrDefault(r => r.Id == commentId);

        if (target != null)
        {
            target.StatusId = newStatusId;
        }
        StateHasChanged();
    });
}






