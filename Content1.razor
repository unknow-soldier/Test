    public async Task<bool> CloseIncidentAsync(Guid incidentId, Guid actorUserId, bool actingAsAdmin = false)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        var incident = await db.Incidents.FirstOrDefaultAsync(i => i.Id == incidentId);
        if (incident == null) return false;

        if (!actingAsAdmin)
        {
            var isResponsible = await db.IncidentParticipants.AnyAsync(p =>
                p.IncidentId == incidentId && p.SecurityUserId == actorUserId &&
                p.Role == IncidentParticipantRole.Responsable && p.RemovedAt == null);
            if (!isResponsible) return false;
        }

        var now = DateTime.Now;
        await CloseTimeSegmentAsync(db, incidentId, now);

        incident.Status = IncidentStatus.Cerrada;
        incident.ClosedAt = now;
        incident.UpdatedAt = now;

        var actor = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == actorUserId);
        await LogActivityAsync(db, incidentId, IncidentActivityType.Cerrada, actorUserId,
            $"{actor?.FullName ?? "-"} cerró la incidencia.", now);

        await db.SaveChangesAsync();
        return true;
    }

    public async Task<bool> ReactivateIncidentAsync(Guid incidentId, Guid actorUserId, bool actingAsAdmin = false)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();
        var incident = await db.Incidents.FirstOrDefaultAsync(i => i.Id == incidentId);
        if (incident == null) return false;
        if (!actingAsAdmin && incident.CreatedByUserId != actorUserId) return false;
        if (incident.Status != IncidentStatus.Cerrada) return false;

        var now = DateTime.Now;
        incident.Status = IncidentStatus.Reactivada;
        incident.ClosedAt = null;
        incident.ReactivationCount++;
        incident.UpdatedAt = now;

        await OpenSegmentForCurrentStateAsync(db, incident, now);

        var actor = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == actorUserId);
        await LogActivityAsync(db, incidentId, IncidentActivityType.Reactivada, actorUserId,
            $"{actor?.FullName ?? "-"} reactivó la incidencia.", now);

        await db.SaveChangesAsync();
        return true;
    }

