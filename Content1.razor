    public async Task<IncidentDetailDto?> GetIncidentDetailAsync(Guid id)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var incident = await db.Incidents.FirstOrDefaultAsync(i => i.Id == id);
        if (incident == null) return null;

        var (activeHours, deadHours) = await ComputeHoursAsync(db, id);
        var area = await db.Areas.FirstOrDefaultAsync(a => a.Id == incident.CurrentAreaId);
        var originArea = await db.Areas.FirstOrDefaultAsync(a => a.Id == incident.OriginAreaId);
        var creator = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == incident.CreatedByUserId);
        var responsibles = await GetResponsiblesInternalAsync(db, id);

        var comments = await db.IncidentComments.Where(c => c.IncidentId == id).ToListAsync();
        var transfers = await db.IncidentTransfers.Where(t => t.IncidentId == id).ToListAsync();
        var activity = await db.IncidentActivityEntries.Where(a => a.IncidentId == id).ToListAsync();
        var attachments = await db.IncidentAttachments.Where(a => a.IncidentId == id).ToListAsync();
        var relatedArticles = await db.IncidentArticleLinks.Where(l => l.IncidentId == id)
            .Include(l => l.Article).Select(l => l.Article).ToListAsync();
        var segments = await db.IncidentTimeSegments.Where(s => s.IncidentId == id).OrderBy(s => s.StartedAt).ToListAsync();
        var participantRows = await db.IncidentParticipants.Where(p => p.IncidentId == id)
            .Include(p => p.SecurityUser).Include(p => p.Area).OrderBy(p => p.AssignedAt).ToListAsync();

        var commentDtos = new List<IncidentCommentDto>();
        foreach (var c in comments.OrderBy(c => c.CreatedAt))
            commentDtos.Add(await ToCommentDtoAsync(db, c));

        var transferDtos = new List<IncidentTransferDto>();
        foreach (var t in transfers.OrderBy(t => t.TransferredAt))
            transferDtos.Add(await ToTransferDtoAsync(db, t));

        var activityDtos = new List<IncidentActivityDto>();
        foreach (var a in activity.OrderBy(a => a.OccurredAt))
            activityDtos.Add(await ToActivityDtoAsync(db, a));

        var segmentDtos = new List<IncidentTimeSegmentDto>();
        foreach (var s in segments)
            segmentDtos.Add(await ToSegmentDtoAsync(db, s));

        return new IncidentDetailDto
        {
            Id = incident.Id,
            Code = incident.Code,
            Title = incident.Title,
            Description = incident.Description,
            Status = incident.Status,
            Priority = incident.Priority,
            OriginAreaId = incident.OriginAreaId,
            OriginAreaName = originArea?.Name ?? "-",
            OriginAreaColor = originArea?.Color ?? "#334155",
            CurrentAreaId = incident.CurrentAreaId,
            CurrentAreaName = area?.Name ?? "-",
            CurrentAreaColor = area?.Color ?? "#334155",
            CreatedByUserId = incident.CreatedByUserId,
            CreatedByName = creator?.FullName ?? "-",
            CreatedByInitials = GetInitials(creator?.FullName),
            CreatedByAvatarColorFrom = creator?.AvatarColorFrom,
            CreatedByAvatarColorTo = creator?.AvatarColorTo,
            Responsibles = responsibles,
            CreatedAt = incident.CreatedAt,
            UpdatedAt = incident.UpdatedAt,
            ClosedAt = incident.ClosedAt,
            ReactivationCount = incident.ReactivationCount,
            TotalActiveHours = activeHours,
            TotalDeadHours = deadHours,
            TotalHours = activeHours + deadHours,
            SlaHours = IncidentSlaHelper.SlaHoursFor(incident.Priority),
            IsOverdue = IncidentSlaHelper.IsOverdue(incident.Priority, incident.CreatedAt, incident.ClosedAt),
            Comments = commentDtos,
            Transfers = transferDtos,
            Activity = activityDtos,
            TimeSegments = segmentDtos,
            Attachments = attachments.OrderBy(a => a.UploadedAt).ToList(),
            RelatedArticles = relatedArticles.Select(a => new RelatedArticleSummaryDto { Id = a.Id, Title = a.Title, Slug = a.Slug }).ToList(),
            Content = incident.Content,
            Participants = participantRows.Select(p => new IncidentParticipantDto
            {
                UserId = p.SecurityUserId,
                FullName = p.SecurityUser.FullName,
                Initials = GetInitials(p.SecurityUser.FullName),
                Position = p.SecurityUser.Position,
                AvatarColorFrom = p.SecurityUser.AvatarColorFrom,
                AvatarColorTo = p.SecurityUser.AvatarColorTo,
                AreaName = p.Area.Name,
                Role = p.Role,
                AssignedAt = p.AssignedAt,
                RemovedAt = p.RemovedAt
            }).ToList()
        };
    }

