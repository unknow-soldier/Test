    private async Task CloseTimeSegmentAsync(DaviWikiDbContext db, Guid incidentId, DateTime endedAt)
    {
        var open = await db.IncidentTimeSegments
            .Where(s => s.IncidentId == incidentId && s.EndedAt == null)
            .OrderByDescending(s => s.StartedAt)
            .FirstOrDefaultAsync();
        if (open != null) open.EndedAt = endedAt;
    }

    private async Task OpenSegmentForCurrentStateAsync(DaviWikiDbContext db, Incident incident, DateTime now)
    {
        var responsibleIds = await db.IncidentParticipants
            .Where(p => p.IncidentId == incident.Id && p.Role == IncidentParticipantRole.Responsable && p.RemovedAt == null)
            .Select(p => p.SecurityUserId)
            .ToListAsync();

        db.IncidentTimeSegments.Add(new IncidentTimeSegment
        {
            Id = Guid.NewGuid(),
            IncidentId = incident.Id,
            AreaId = incident.CurrentAreaId,
            UserId = responsibleIds.Count > 0 ? responsibleIds[0] : (Guid?)null,
            StartedAt = now,
            IsActiveWork = responsibleIds.Count > 0
        });
    }

    private async Task LogActivityAsync(DaviWikiDbContext db, Guid incidentId, IncidentActivityType type, Guid actorUserId, string description, DateTime occurredAt)
    {
        db.IncidentActivityEntries.Add(new IncidentActivityEntry
        {
            Id = Guid.NewGuid(), IncidentId = incidentId, Type = type,
            ActorUserId = actorUserId, Description = description, OccurredAt = occurredAt
        });
        await Task.CompletedTask;
    }

    private async Task<double> AverageHoursForAreaAsync(DaviWikiDbContext db, Guid areaId, List<Guid>? restrictToIncidentIds = null)
    {
        var query = db.IncidentTimeSegments.Where(s => s.AreaId == areaId);
        if (restrictToIncidentIds != null) query = query.Where(s => restrictToIncidentIds.Contains(s.IncidentId));
        var segments = await query.ToListAsync();
        return segments.Count > 0 ? segments.Average(s => s.Duration.TotalHours) : 0;
    }

    private async Task<(double ActiveHours, double DeadHours)> ComputeHoursAsync(DaviWikiDbContext db, Guid incidentId)
    {
        var segments = await db.IncidentTimeSegments.Where(s => s.IncidentId == incidentId).ToListAsync();
        var active = segments.Where(s => s.IsActiveWork).Sum(s => s.Duration.TotalHours);
        var dead = segments.Where(s => !s.IsActiveWork).Sum(s => s.Duration.TotalHours);
        return (Math.Round(active, 1), Math.Round(dead, 1));
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "??";
        var initials = string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(p => p[0])).ToUpperInvariant();
        return initials.Length > 2 ? initials[..2] : initials;
    }

    // =========================================================================
    // NOTIFICACIONES EN SEGUNDO PLANO
    // =========================================================================

    /// <summary>Dispara notificación in-app + correo en segundo plano. Deliberadamente
    /// no toca ningún DbContext del método que la invoca: _notificationService y
    /// _emailSender crean sus propias conexiones cortas por su cuenta.</summary>
    private void NotifyResponsibleAssigned(
        Guid incidentId, string incidentCode, string incidentTitle, string areaName,
        SecurityUser target, Guid actorUserId, string actorName, NotificationType notifType)
    {
        if (target.Id == actorUserId) return;

        var targetId = target.Id;
        var targetEmail = target.Email;

        _ = Task.Run(async () =>
        {
            try
            {
                await _notificationService.CreateIncidentNotificationAsync(
                    recipientUserId: targetId, actorUserId: actorUserId, incidentId: incidentId, type: notifType);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error creando notificación in-app de incidencia {Codigo} para {UserId}", incidentCode, targetId);
            }

            if (string.IsNullOrWhiteSpace(targetEmail)) return;

            try
            {
                await _emailSender.EnviarCorreoIncidenciaAsignadaAsync(
                    targetEmail, actorName, incidentCode, incidentTitle, areaName, DateTime.Now.ToString("dd/MM/yyyy"));
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error enviando correo de incidencia {Codigo} a {UserId}", incidentCode, targetId);
            }
        });
    }

