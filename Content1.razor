<div style="min-width:150px;">
    <span class="incident-meta-grid__label"><Icon Name="alarm-clock" />SLA (@_detail.SlaHours h)</span>
    <div style="margin-top:6px;">
        @if (_detail.Status == IncidentStatus.Cerrada)
        {
            <span class="badge badge--outline">Cerrada</span>
        }
        else if (_detail.IsOverdue)
        {
            <span class="badge" style="color:#ef4444;border:1px solid #ef4444;">Fuera de SLA</span>
        }
        else
        {
            <span class="badge" style="color:#22c55e;border:1px solid #22c55e;">Dentro de SLA</span>
        }
    </div>
</div>




@if (CanDelete)
{
    <button class="btn btn--danger btn--sm" style="margin-top: var(--space-2);" @onclick="RequestDeleteConfirmation">
        <Icon Name="trash-2" /> Eliminar incidencia
    </button>
}






private bool CanDelete => _isAdmin || (_detail?.Participants.Any(p =>
    p.UserId == _currentUserId && p.Role == IncidentParticipantRole.Responsable) ?? false);

private void RequestDeleteConfirmation()
{
    _confirmTitle = "Eliminar incidencia";
    _confirmMessage = $"¿Seguro que quieres eliminar \"{_detail!.Title}\"? Esta acción no se puede deshacer.";
    _confirmButtonText = "Sí, eliminar";
    _confirmButtonClass = "btn--danger";
    _pendingAction = DeleteIncidentAction;
    _showConfirmModal = true;
}

private async Task DeleteIncidentAction()
{
    if (_detail is null) return;
    var ok = await Incidents.DeleteIncidentAsync(_detail.Id, ActorId, _isAdmin);
    if (ok)
    {
        Toast.Show("Incidencia eliminada.", ToastVariant.Success, "trash-2");
        Nav.NavigateTo("/incidencias/listado");
    }
    else
    {
        Toast.Show("No se pudo eliminar la incidencia.", ToastVariant.Warning, "alert-triangle");
    }
}