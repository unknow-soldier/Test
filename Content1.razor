@using CorpWiki.Application.DTOs.Incidents
@using CorpWiki.Application.Helpers

<a class="incident-row" href="@($"/incidencias/{Item.Id}")">
    <div class="incident-row__main">
        <span class="incident-row__code">@Item.Code</span>
        <h4 class="incident-row__title">@Item.Title</h4>
        <div class="incident-row__badges">
            <IncidentStatusBadge Status="Item.Status" />
            <IncidentPriorityBadge Priority="Item.Priority" />
            <AreaBadge Name="@Item.AreaName" Color="@Item.AreaColor" ShowIcon="false" Small="true" />
        </div>
    </div>

    <div class="incident-row__meta">
        <div class="incident-row__responsibles">
            @if (Item.Responsibles.Count == 0)
            {
                <span class="incident-row__no-responsible">Sin responsables</span>
            }
            else
            {
                @foreach (var r in Item.Responsibles.Take(3))
                {
                    <UserAvatar FullName="@r.FullName" Initials="@r.Initials"
                                ColorFrom="@r.AvatarColorFrom" ColorTo="@r.AvatarColorTo"
                                Size="UserAvatar.AvatarSize.Sm" />
                }
                @if (Item.Responsibles.Count > 3)
                {
                    <span class="incident-row__more">+@(Item.Responsibles.Count - 3)</span>
                }
            }
        </div>

        <div class="incident-row__stats">
            <span><Icon Name="message-circle" /> @Item.CommentsCount</span>
            <span><Icon Name="arrow-right" /> @Item.TransfersCount</span>
            <span><Icon Name="clock" /> @Item.UpdatedAt.ToRelativeLabel()</span>
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public IncidentSummaryDto Item { get; set; } = null!;
}




<div class="incident-meta-grid__item">
    <span class="incident-meta-grid__label"><Icon Name="user-check" />Responsables</span>
    <span class="incident-meta-grid__value">
        @if (_detail.Responsibles.Count == 0)
        {
            <span>Sin responsables</span>
        }
        else
        {
            <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
                @foreach (var r in _detail.Responsibles)
                {
                    <UserAvatar FullName="@r.FullName" Initials="@r.Initials"
                                ColorFrom="@r.AvatarColorFrom" ColorTo="@r.AvatarColorTo" Size="UserAvatar.AvatarSize.Sm" />
                }
                <span>@string.Join(", ", _detail.Responsibles.Select(r => r.FullName))</span>
            </div>
        }
    </span>
</div>





<div class="incident-meta-grid__item">
    <span class="incident-meta-grid__label"><Icon Name="user-check" />Responsables</span>
    <span class="incident-meta-grid__value">
        @if (_detail.Responsibles.Count == 0)
        {
            <span>Sin responsables</span>
        }
        else
        {
            <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
                @foreach (var r in _detail.Responsibles)
                {
                    <UserAvatar FullName="@r.FullName" Initials="@r.Initials"
                                ColorFrom="@r.AvatarColorFrom" ColorTo="@r.AvatarColorTo" Size="UserAvatar.AvatarSize.Sm" />
                }
                <span>@string.Join(", ", _detail.Responsibles.Select(r => r.FullName))</span>
            </div>
        }
    </span>
</div>






@if (_activeTab == "gestion")
{
    <div class="detail-tabs__panel">
        <div class="management-grid">

            <div class="card widget">
                <h4 class="widget__title"><Icon Name="users" />Equipo responsable actual</h4>
                @if (_detail.Responsibles.Count == 0)
                {
                    <p class="section-header__subtitle">Nadie tiene esta incidencia asignada en este momento.</p>
                }
                else
                {
                    @foreach (var r in _detail.Responsibles)
                    {
                        <div class="activity-row">
                            <UserAvatar FullName="@r.FullName" Initials="@r.Initials"
                                        ColorFrom="@r.AvatarColorFrom" ColorTo="@r.AvatarColorTo" Size="UserAvatar.AvatarSize.Sm" />
                            <div style="flex:1; min-width:0;">
                                <p class="activity-row__text"><strong>@r.FullName</strong></p>
                                <p class="activity-row__time">@r.AreaName</p>
                            </div>
                        </div>
                    }
                }

                @if (IsCurrentUserResponsible)
                {
                    <button class="btn btn--secondary btn--sm" style="margin-top: var(--space-3);" @onclick="RequestSelfRemoveConfirmation">
                        <Icon Name="user-x" /> Desresponsabilizarme
                    </button>
                }
            </div>

            @if (_detail.Status != IncidentStatus.Cerrada && (_detail.Responsibles.Count == 0 || IsCurrentUserResponsible))
            {
                <div class="card widget">
                    <h4 class="widget__title"><Icon Name="user-check" />Sumar responsable de mi equipo</h4>
                    <p class="form-hint">Solo personas de @_detail.CurrentAreaName.</p>
                    <div class="form-group">
                        <select class="input" @bind="_addResponsibleUserId">
                            <option value="">Seleccioná un compañero</option>
                            @foreach (var u in _currentAreaUsers.Where(u => !_detail.Responsibles.Any(r => r.Id == u.Id)))
                            {
                                <option value="@u.Id">@u.FullName - @u.Position</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn--secondary btn--sm" @onclick="AddResponsibleAction" disabled="@(!_addResponsibleUserId.HasValue)">
                        Agregar
                    </button>
                </div>
            }

            <div class="card widget">
                <h4 class="widget__title"><Icon Name="refresh-cw" />Cambiar estado</h4>
                <div class="form-group">
                    <select class="input" @bind="_newStatus">
                        @foreach (var s in Enum.GetValues<IncidentStatus>())
                        {
                            <option value="@s">@IncidentLabels.Status(s)</option>
                        }
                    </select>
                </div>
                <button class="btn btn--secondary btn--sm" @onclick="ChangeStatusAction">Actualizar estado</button>
            </div>

            @if (IsCurrentUserResponsible)
            {
                <div class="card widget" style="margin-bottom: var(--space-5);">
                    <h4 class="widget__title"><Icon Name="arrow-right" />Reenviar a otra área</h4>
                    <p class="form-hint">Al reenviar, todo tu equipo actual deja de ser responsable.</p>
                    <div class="form-group">
                        <select class="input" value="@(_delegateAreaId?.ToString() ?? "")" @onchange="OnDelegateAreaChanged">
                            <option value="">Área destino</option>
                            @foreach (var area in _areas.Where(a => a.Id != _detail.CurrentAreaId))
                            {
                                <option value="@area.Id">@area.Name</option>
                            }
                        </select>
                    </div>

                    @if (_delegateAreaId.HasValue)
                    {
                        <div class="form-group">
                            <label class="form-label">Nuevo(s) responsable(s)</label>
                            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                @foreach (var u in _delegateAreaUsers)
                                {
                                    var uid = u.Id;
                                    <button type="button" class="chip @(_delegateUserIds.Contains(uid) ? "chip--active" : "")"
                                            @onclick="() => ToggleDelegateUser(uid)">
                                        @u.FullName
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <div class="form-group">
                        <textarea class="input" rows="2" placeholder="Motivo del reenvío" @bind="_delegateReason"></textarea>
                    </div>

                    <button class="btn btn--secondary btn--sm" @onclick="DelegateAction"
                            disabled="@(!_delegateAreaId.HasValue || _delegateUserIds.Count == 0)">
                        Reenviar
                    </button>
                </div>
            }

            @if (_detail.Transfers.Count > 0)
            {
                <div class="widget card">
                    <h4 class="widget__title"><Icon Name="arrow-right" />Historial de transferencias (@_detail.Transfers.Count)</h4>
                    @foreach (var t in _detail.Transfers.OrderByDescending(t => t.TransferredAt))
                    {
                        <div class="activity-row">
                            <div class="activity-row__icon" style="background:rgba(236,72,153,0.14); color:#ec4899;">
                                <Icon Name="arrow-right" />
                            </div>
                            <div style="flex:1; min-width:0;">
                                <p class="activity-row__text">@t.FromAreaName &rarr; <strong>@t.ToAreaName</strong> (@t.ToUserName)</p>
                                <p class="activity-row__time">@t.Reason · @t.TransferredAt.ToRelativeLabel()</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}





@{
    var responsibleIds = ResponsibleIds;
