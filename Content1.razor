BEGIN TRANSACTION;

BEGIN TRY
    -- Variable con el ID del artículo que vas a eliminar
    DECLARE @ArticleId UNIQUEIDENTIFIER = 'ED0B06B2-CE1B-4A41-8F04-07EBEE003A16'; 

    -- 1. ELIMINAR REGISTROS DE LAS TABLAS HIJAS (Dependientes)
    DELETE FROM [dbo].[article_attachments]    WHERE [ArticleId] = @ArticleId;
    DELETE FROM [dbo].[article_content_blocks] WHERE [ArticleId] = @ArticleId;
    
    -- La tabla article_related tiene dos relaciones hacia articles:
    DELETE FROM [dbo].[article_related]        WHERE [ArticleId] = @ArticleId OR [RelatedArticleId] = @ArticleId;
    
    DELETE FROM [dbo].[article_tags]           WHERE [ArticleId] = @ArticleId;
    DELETE FROM [dbo].[article_versions]       WHERE [ArticleId] = @ArticleId;
    DELETE FROM [dbo].[collection_articles]    WHERE [ArticleId] = @ArticleId;
    DELETE FROM [dbo].[article_comments]       WHERE [ArticleId] = @ArticleId;
    DELETE FROM [dbo].[article_favorites]      WHERE [ArticleId] = @ArticleId;
    DELETE FROM [dbo].[article_history]        WHERE [ArticleId] = @ArticleId;
    DELETE FROM [dbo].[article_ratings]        WHERE [ArticleId] = @ArticleId;

    -- 2. ELIMINAR EL REGISTRO EN LA TABLA PRINCIPAL
    DELETE FROM [dbo].[articles]               WHERE [Id] = @ArticleId;

    -- Confirmar los cambios si todo salió bien
    COMMIT TRANSACTION;
    PRINT 'Artículo y todas sus dependencias eliminados correctamente.';

END TRY
BEGIN CATCH
    -- Si ocurre algún error (ej. otra restricción no contemplada), revierte todo
    ROLLBACK TRANSACTION;
    
    PRINT 'Error al eliminar. Se revirtió la transacción.';
    THROW;
END CATCH;
