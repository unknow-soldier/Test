<div class="comments-list">
    @foreach (var c in _comments.Where(c => c.ShouldRender))
    {
        <CommentCard Id="@c.Id"
                     ParentCommentId="@c.ParentCommentId"
                     RootCommentId="null"
                     AuthorName="@c.AuthorName"
                     AuthorInitials="@c.AuthorInitials"
                     AuthorColorFrom="@c.AuthorColorFrom"
                     AuthorColorTo="@c.AuthorColorTo"
                     Content="@c.Content"
                     IsDeleted="@c.IsDeleted"
                     IsEdited="@c.IsEdited"
                     CreatedAt="@c.CreatedAt"
                     Likes="@c.LikesCount"
                     IsLiked="@c.IsLikedByCurrentUser"
                     CanEditOrDelete="@(c.CanEditOrDelete && !c.IsDeleted)"
                     ReplyingToAuthorName="@c.ReplyingToAuthorName"
                     Replies="@(c.Replies.Where(r => r.ShouldRender).ToList())"
                     OnLike="HandleCommentLike"
                     OnReply="HandleCommentReply"
                     OnEdit="HandleCommentEdit"
                     OnDelete="HandleCommentDelete" />
    }
</div>






// ICommentDataService.cs
Task<IReadOnlyList<CommentAuditLogDto>> GetAuditLogAsync(Guid commentId);







// CommentAuditLogDto.cs (Application/DTOs)
public class CommentAuditLogDto
{
    public int PreviousStatusId { get; set; }
    public int NewStatusId { get; set; }
    public string? PreviousContent { get; set; }
    public string ChangedByUserName { get; set; } = string.Empty;
    public DateTime ChangedAt { get; set; }
}





// CommentDataService.cs
public async Task<IReadOnlyList<CommentAuditLogDto>> GetAuditLogAsync(Guid commentId)
{
    await using var db = await _dbFactory.CreateDbContextAsync();

    return await db.CommentAuditLogs
        .Where(l => l.CommentId == commentId)
        .OrderByDescending(l => l.ChangedAt)
        .Join(db.SecurityUsers,
              l => l.ChangedByUserId,
              u => u.Id,
              (l, u) => new CommentAuditLogDto
              {
                  PreviousStatusId = l.PreviousStatusId,
                  NewStatusId = l.NewStatusId,
                  PreviousContent = l.PreviousContent,
                  ChangedByUserName = u.FullName,
                  ChangedAt = l.ChangedAt
              })
        .ToListAsync();
}





