public async Task<bool> ChangeStatusAsync(Guid incidentId, IncidentStatus newStatus, Guid actorUserId, bool actingAsAdmin = false)
{
    if (newStatus != IncidentStatus.EnDesarrollo && newStatus != IncidentStatus.Resuelta) return false;

    var incident = await GetIncidentByIdAsync(incidentId);
    if (incident == null || incident.Status == IncidentStatus.Cerrada) return false;
    if (incident.Status == newStatus) return true;

    if (!actingAsAdmin)
    {
        var isResponsible = await _db.IncidentParticipants.AnyAsync(p =>
            p.IncidentId == incidentId && p.SecurityUserId == actorUserId &&
            p.Role == IncidentParticipantRole.Responsable && p.RemovedAt == null);
        if (!isResponsible) return false;
    }

    var now = DateTime.Now;
    var wasResolved = incident.Status == IncidentStatus.Resuelta;
    incident.Status = newStatus;
    incident.UpdatedAt = now;

    if (newStatus == IncidentStatus.Resuelta)
        await CloseTimeSegmentAsync(incidentId, now);
    else if (wasResolved)
        await OpenSegmentForCurrentStateAsync(incident, now);

    var actor = await GetUserByIdAsync(actorUserId);
    await LogActivityAsync(incidentId, IncidentActivityType.CambioEstado, actorUserId,
        $"{actor?.FullName ?? "-"} cambió el estado a {IncidentLabels.Status(newStatus)}.", now);

    await _db.SaveChangesAsync();
    return true;
}

public async Task<bool> CloseIncidentAsync(Guid incidentId, Guid actorUserId, bool actingAsAdmin = false)
{
    var incident = await GetIncidentByIdAsync(incidentId);
    if (incident == null) return false;

    if (!actingAsAdmin)
    {
        var isResponsible = await _db.IncidentParticipants.AnyAsync(p =>
            p.IncidentId == incidentId && p.SecurityUserId == actorUserId &&
            p.Role == IncidentParticipantRole.Responsable && p.RemovedAt == null);
        if (!isResponsible) return false;
    }

    var now = DateTime.Now;
    await CloseTimeSegmentAsync(incidentId, now);

    incident.Status = IncidentStatus.Cerrada;
    incident.ClosedAt = now;
    incident.UpdatedAt = now;

    var actor = await GetUserByIdAsync(actorUserId);
    await LogActivityAsync(incidentId, IncidentActivityType.Cerrada, actorUserId,
        $"{actor?.FullName ?? "-"} cerró la incidencia.", now);

    await _db.SaveChangesAsync();
    return true;
}

public async Task<bool> ReactivateIncidentAsync(Guid incidentId, Guid actorUserId, bool actingAsAdmin = false)
{
    var incident = await GetIncidentByIdAsync(incidentId);
    if (incident == null) return false;
    if (!actingAsAdmin && incident.CreatedByUserId != actorUserId) return false;
    if (incident.Status != IncidentStatus.Cerrada) return false;

    var now = DateTime.Now;
    incident.Status = IncidentStatus.Reactivada;
    incident.ClosedAt = null;
    incident.ReactivationCount++;
    incident.UpdatedAt = now;

    await OpenSegmentForCurrentStateAsync(incident, now);

    var actor = await GetUserByIdAsync(actorUserId);
    await LogActivityAsync(incidentId, IncidentActivityType.Reactivada, actorUserId,
        $"{actor?.FullName ?? "-"} reactivó la incidencia.", now);

    await _db.SaveChangesAsync();
    return true;
}

public async Task<bool> AddResponsibleAsync(Guid incidentId, Guid userId, Guid actorUserId, bool actingAsAdmin = false)
{
    var incident = await GetIncidentByIdAsync(incidentId);
    if (incident == null || incident.Status == IncidentStatus.Cerrada) return false;

    var user = await GetUserByIdAsync(userId);
    if (user == null || user.AreaId != incident.CurrentAreaId) return false; // invariante, no se salta ni para admin

    var activeResponsibles = await _db.IncidentParticipants
        .Where(p => p.IncidentId == incidentId && p.Role == IncidentParticipantRole.Responsable && p.RemovedAt == null)
        .ToListAsync();

    if (activeResponsibles.Any(p => p.SecurityUserId == userId)) return true;

    if (!actingAsAdmin)
    {
        var actorIsResponsible = activeResponsibles.Any(p => p.SecurityUserId == actorUserId);
        if (activeResponsibles.Count > 0 && !actorIsResponsible) return false;
    }

    var now = DateTime.Now;

    _db.IncidentParticipants.Add(new IncidentParticipant
    {
        Id = Guid.NewGuid(), IncidentId = incidentId, SecurityUserId = userId,
        AreaId = incident.CurrentAreaId, Role = IncidentParticipantRole.Responsable, AssignedAt = now
    });

    if (activeResponsibles.Count == 0 && incident.Status != IncidentStatus.Resuelta)
    {
        await CloseTimeSegmentAsync(incidentId, now);
        _db.IncidentTimeSegments.Add(new IncidentTimeSegment
        {
            Id = Guid.NewGuid(), IncidentId = incidentId, AreaId = incident.CurrentAreaId,
            UserId = userId, StartedAt = now, IsActiveWork = true
        });
    }

    incident.UpdatedAt = now;

    var actor = await GetUserByIdAsync(actorUserId);
    await LogActivityAsync(incidentId, IncidentActivityType.Asignada, actorUserId,
        $"{actor?.FullName ?? "-"} sumó a {user.FullName} como responsable.", now);

    if (userId != actorUserId)
        NotifyResponsibleAssigned(incidentId, incident.Code, incident.Title,
            (await GetAreaByIdAsync(incident.CurrentAreaId))?.Name ?? "-",
            user, actorUserId, actor?.FullName ?? "-", NotificationType.IncidentAssigned);

    await _db.SaveChangesAsync();
    return true;
}

public async Task<bool> RemoveResponsibleAsync(Guid incidentId, Guid userId, Guid actorUserId, bool actingAsAdmin = false)
{
    if (!actingAsAdmin && userId != actorUserId) return false;

    var participant = await _db.IncidentParticipants.FirstOrDefaultAsync(p =>
        p.IncidentId == incidentId && p.SecurityUserId == userId &&
        p.Role == IncidentParticipantRole.Responsable && p.RemovedAt == null);
    if (participant == null) return false;

    var now = DateTime.Now;
    participant.RemovedAt = now;

    var incident = await GetIncidentByIdAsync(incidentId);
    if (incident != null)
    {
        incident.UpdatedAt = now;

        var remaining = await _db.IncidentParticipants.CountAsync(p =>
            p.IncidentId == incidentId && p.Role == IncidentParticipantRole.Responsable &&
            p.RemovedAt == null && p.Id != participant.Id);

        if (remaining == 0 && incident.Status != IncidentStatus.Resuelta)
        {
            await CloseTimeSegmentAsync(incidentId, now);
            _db.IncidentTimeSegments.Add(new IncidentTimeSegment
            {
                Id = Guid.NewGuid(), IncidentId = incidentId, AreaId = incident.CurrentAreaId,
                UserId = null, StartedAt = now, IsActiveWork = false
            });
        }
    }

    var user = await GetUserByIdAsync(userId);
    var actor = await GetUserByIdAsync(actorUserId);
    await LogActivityAsync(incidentId, IncidentActivityType.Desresponsabilizada, actorUserId,
        $"{(actingAsAdmin && userId != actorUserId ? $"{actor?.FullName ?? "-"} quitó a {user?.FullName ?? "-"} como" : $"{user?.FullName ?? "-"} se desresponsabilizó de la")} incidencia.", now);

    await _db.SaveChangesAsync();
    return true;
}

public async Task<bool> DelegateToAreaAsync(Guid incidentId, Guid toAreaId, List<Guid> newResponsibleUserIds, string reason, Guid actorUserId, bool actingAsAdmin = false)
{
    if (newResponsibleUserIds == null || newResponsibleUserIds.Count == 0) return false;

    var incident = await GetIncidentByIdAsync(incidentId);
    if (incident == null) return false;

    var activeResponsibles = await _db.IncidentParticipants
        .Where(p => p.IncidentId == incidentId && p.Role == IncidentParticipantRole.Responsable && p.RemovedAt == null)
        .ToListAsync();

    if (!actingAsAdmin && !activeResponsibles.Any(p => p.SecurityUserId == actorUserId)) return false;

    var newUsers = new List<SecurityUser>();
    foreach (var uid in newResponsibleUserIds.Distinct())
    {
        var u = await GetUserByIdAsync(uid);
        if (u == null || u.AreaId != toAreaId) return false; // invariante, no se salta ni para admin
        newUsers.Add(u);
    }

    var now = DateTime.Now;
    await CloseTimeSegmentAsync(incidentId, now);

    foreach (var p in activeResponsibles)
        p.RemovedAt = now;

    var fromArea = await GetAreaByIdAsync(incident.CurrentAreaId);
    var toArea = await GetAreaByIdAsync(toAreaId);

    _db.IncidentTransfers.Add(new IncidentTransfer
    {
        Id = Guid.NewGuid(), IncidentId = incidentId,
        FromUserId = actorUserId, ToUserId = newUsers[0].Id,
        FromAreaId = incident.CurrentAreaId, ToAreaId = toAreaId,
        Reason = string.IsNullOrWhiteSpace(reason) ? "Sin motivo especificado." : reason.Trim(),
        TransferredAt = now
    });

    incident.CurrentAreaId = toAreaId;
    incident.Status = IncidentStatus.EnDesarrollo;
    incident.UpdatedAt = now;

    foreach (var u in newUsers)
    {
        _db.IncidentParticipants.Add(new IncidentParticipant
        {
            Id = Guid.NewGuid(), IncidentId = incidentId, SecurityUserId = u.Id,
            AreaId = toAreaId, Role = IncidentParticipantRole.Responsable, AssignedAt = now
        });
    }

    _db.IncidentTimeSegments.Add(new IncidentTimeSegment
    {
        Id = Guid.NewGuid(), IncidentId = incidentId, AreaId = toAreaId,
        UserId = newUsers[0].Id, StartedAt = now, IsActiveWork = true
    });

    var actor = await GetUserByIdAsync(actorUserId);
    var names = string.Join(", ", newUsers.Select(u => u.FullName));
    await LogActivityAsync(incidentId, IncidentActivityType.Transferida, actorUserId,
        $"{actor?.FullName ?? "-"} reenvió la incidencia de {fromArea?.Name ?? "-"} a {toArea?.Name ?? "-"} (nuevo(s) responsable(s): {names}).", now);

    foreach (var u in newUsers)
        NotifyResponsibleAssigned(incidentId, incident.Code, incident.Title, toArea?.Name ?? "-",
            u, actorUserId, actor?.FullName ?? "-", NotificationType.IncidentDelegated);

    await _db.SaveChangesAsync();
    return true;
}









private async Task<double> AverageHoursForAreaAsync(Guid areaId, List<Guid>? restrictToIncidentIds = null)
{
    var query = _db.IncidentTimeSegments.Where(s => s.AreaId == areaId);
    if (restrictToIncidentIds != null) query = query.Where(s => restrictToIncidentIds.Contains(s.IncidentId));
    var segments = await query.ToListAsync();
    return segments.Count > 0 ? segments.Average(s => s.Duration.TotalHours) : 0;
}

public async Task<IncidentKpiSnapshotDto> GetKpiSnapshotAsync(Guid? onlyForUserId = null)
{
    List<Guid>? accessibleIds = onlyForUserId.HasValue ? await GetAccessibleIncidentIdsAsync(onlyForUserId.Value) : null;

    var query = _db.Incidents.AsQueryable();
    if (accessibleIds != null) query = query.Where(i => accessibleIds.Contains(i.Id));
    var incidents = await query.ToListAsync();

    var active = incidents.Where(i => i.Status != IncidentStatus.Cerrada).ToList();
    var closed = incidents.Where(i => i.Status == IncidentStatus.Cerrada).ToList();

    var avgResolutionHours = closed.Count > 0
        ? closed.Average(i => (i.ClosedAt!.Value - i.CreatedAt).TotalHours)
        : 0;

    double avgDeadHours = 0;
    if (incidents.Count > 0)
    {
        var totalDead = 0.0;
        foreach (var i in incidents) totalDead += (await ComputeHoursAsync(i.Id)).DeadHours;
        avgDeadHours = totalDead / incidents.Count;
    }

    var loadByArea = await GetLoadByAreaAsync(onlyForUserId);
    var loadByResponsible = await GetLoadByResponsibleAsync(onlyForUserId);
    var areas = await GetAreasAsync();

    var avgTimeByArea = new List<AreaAvgTimeDto>();
    foreach (var area in areas)
    {
        avgTimeByArea.Add(new AreaAvgTimeDto
        {
            AreaName = area.Name, AreaColor = area.Color,
            AvgHours = Math.Round(await AverageHoursForAreaAsync(area.Id, accessibleIds), 1)
        });
    }

    return new IncidentKpiSnapshotDto
    {
        ActiveCount = active.Count,
        ClosedCount = closed.Count,
        ReactivatedCount = incidents.Count(i => i.ReactivationCount > 0),
        AvgResolutionHours = Math.Round(avgResolutionHours, 1),
        AvgDeadHours = Math.Round(avgDeadHours, 1),
        TopAreaByLoad = loadByArea.OrderByDescending(a => a.Count).FirstOrDefault(),
        TopResponsible = loadByResponsible.OrderByDescending(r => r.Count).FirstOrDefault(),
        LoadByArea = loadByArea.ToList(),
        LoadByResponsible = loadByResponsible.ToList(),
        StatusDistribution = Enum.GetValues<IncidentStatus>()
            .Select(s => new StatusCountDto { Status = s, Count = incidents.Count(i => i.Status == s) })
            .Where(d => d.Count > 0).ToList(),
        PriorityDistribution = Enum.GetValues<IncidentPriority>()
            .Select(p => new PriorityCountDto { Priority = p, Count = incidents.Count(i => i.Priority == p) })
            .Where(d => d.Count > 0).ToList(),
        AvgTimeByArea = avgTimeByArea
    };
}

public async Task<IReadOnlyList<AreaLoadDto>> GetLoadByAreaAsync(Guid? onlyForUserId = null)
{
    List<Guid>? accessibleIds = onlyForUserId.HasValue ? await GetAccessibleIncidentIdsAsync(onlyForUserId.Value) : null;
    var areas = await _db.Areas.ToListAsync();
    var result = new List<AreaLoadDto>();

    foreach (var area in areas)
    {
        var q = _db.Incidents.Where(i => i.CurrentAreaId == area.Id && i.Status != IncidentStatus.Cerrada);
        if (accessibleIds != null) q = q.Where(i => accessibleIds.Contains(i.Id));
        result.Add(new AreaLoadDto { AreaName = area.Name, AreaColor = area.Color, Count = await q.CountAsync() });
    }

    return result.OrderByDescending(a => a.Count).ToList();
}

public async Task<IReadOnlyList<ResponsibleLoadDto>> GetLoadByResponsibleAsync(Guid? onlyForUserId = null)
{
    var activeQuery = _db.IncidentParticipants
        .Where(p => p.Role == IncidentParticipantRole.Responsable && p.RemovedAt == null);

    if (onlyForUserId.HasValue)
    {
        var accessibleIds = await GetAccessibleIncidentIdsAsync(onlyForUserId.Value);
        activeQuery = activeQuery.Where(p => accessibleIds.Contains(p.IncidentId));
    }

    var grouped = await activeQuery
        .Join(_db.Incidents.Where(i => i.Status != IncidentStatus.Cerrada),
            p => p.IncidentId, i => i.Id, (p, i) => p.SecurityUserId)
        .GroupBy(uid => uid)
        .Select(g => new { UserId = g.Key, Count = g.Count() })
        .OrderByDescending(g => g.Count)
        .Take(10)
        .ToListAsync();

    var result = new List<ResponsibleLoadDto>();
    foreach (var g in grouped)
    {
        var user = await GetUserByIdAsync(g.UserId);
        result.Add(new ResponsibleLoadDto { UserName = user?.FullName ?? "-", Initials = GetInitials(user?.FullName), Count = g.Count });
    }
    return result;
}

public async Task<IReadOnlyList<IncidentActivityFeedDto>> GetRecentActivityAsync(int take = 12, Guid? onlyForUserId = null)
{
    var query = _db.IncidentActivityEntries.AsQueryable();
    if (onlyForUserId.HasValue)
    {
        var accessibleIds = await GetAccessibleIncidentIdsAsync(onlyForUserId.Value);
        query = query.Where(a => accessibleIds.Contains(a.IncidentId));
    }

    var entries = await query.OrderByDescending(a => a.OccurredAt).Take(take).ToListAsync();
    var result = new List<IncidentActivityFeedDto>();

    foreach (var a in entries)
    {
        var incident = await GetIncidentByIdAsync(a.IncidentId);
        var actor = await GetUserByIdAsync(a.ActorUserId);
        result.Add(new IncidentActivityFeedDto
        {
            Id = a.Id, IncidentId = a.IncidentId,
            IncidentCode = incident?.Code ?? "-", IncidentTitle = incident?.Title ?? "-",
            Type = a.Type, ActorName = actor?.FullName ?? "-",
            Description = a.Description, OccurredAt = a.OccurredAt
        });
    }
    return result;
}





