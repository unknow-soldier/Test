public class CommentDto
{
    public Guid Id { get; set; }
    public Guid? ParentCommentId { get; set; }
    public Guid UserId { get; set; }
    public string AuthorName { get; set; } = string.Empty;
    public string AuthorInitials { get; set; } = string.Empty;
    public string AuthorColorFrom { get; set; } = string.Empty;
    public string AuthorColorTo { get; set; } = string.Empty;
    public string Content { get; set; } = string.Empty;
    public DateTime CreatedAt { get; set; }
    public int LikesCount { get; set; }
    public bool IsLikedByCurrentUser { get; set; }
    public bool CanEditOrDelete { get; set; }
    public string? ReplyingToAuthorName { get; set; }
    public List<CommentDto> Replies { get; set; } = new();

    public int StatusId { get; set; }

    // Propiedades calculadas para el frontend — cero lógica en el componente
    public bool IsDeleted => StatusId == (int)CommentStatusEnum.Deleted;
    public bool IsEdited => StatusId == (int)CommentStatusEnum.Edited;

    // Un comentario borrado se oculta SOLO si no tiene hijos (recursivo:
    // basta con mirar Replies.Count, porque un hijo borrado con nietos
    // sigue estando en Replies igualmente).
    public bool ShouldRender => !IsDeleted || Replies.Count > 0;

    public CommentDto Clone() => (CommentDto)MemberwiseClone();
}








private async Task LogAuditAsync(ArticleComment comment, int newStatusId, Guid changedByUserId)
{
    _db.CommentAuditLogs.Add(new CommentAuditLog
    {
        Id = Guid.NewGuid(),
        CommentId = comment.Id,
        PreviousStatusId = comment.StatusId,
        NewStatusId = newStatusId,
        PreviousContent = comment.Content,
        ChangedByUserId = changedByUserId,
        ChangedAt = DateTime.UtcNow
    });
}

public async Task UpdateCommentAsync(Guid commentId, string newContent, Guid currentUserId)
{
    var comment = await _db.ArticleComments.FirstOrDefaultAsync(c => c.Id == commentId)
        ?? throw new InvalidOperationException("Comentario no encontrado");

    if (comment.StatusId == (int)CommentStatusEnum.Deleted)
        throw new InvalidOperationException("No se puede editar un comentario eliminado");

    await LogAuditAsync(comment, (int)CommentStatusEnum.Edited, currentUserId);

    comment.Content = newContent;
    comment.StatusId = (int)CommentStatusEnum.Edited;
    comment.UpdatedAt = DateTime.UtcNow;

    await _db.SaveChangesAsync();
}

public async Task DeleteCommentAsync(Guid commentId, Guid currentUserId)
{
    var comment = await _db.ArticleComments.FirstOrDefaultAsync(c => c.Id == commentId)
        ?? throw new InvalidOperationException("Comentario no encontrado");

    if (comment.StatusId == (int)CommentStatusEnum.Deleted) return; // idempotente

    await LogAuditAsync(comment, (int)CommentStatusEnum.Deleted, currentUserId);

    // NO se borra la fila. Content, UserId, ParentCommentId quedan intactos.
    comment.StatusId = (int)CommentStatusEnum.Deleted;

    await _db.SaveChangesAsync();
}









// Antes: event Action<Guid, Guid[]> CommentDeleted;  (rompía el árbol)
// Ahora:
event Func<Guid, Guid, int, Task>? CommentStatusChanged; // (articleId, commentId, newStatusId)









private Task OnCommentStatusChangedAsync(Guid articleId, Guid commentId, int newStatusId)
{
    if (_article is null || articleId != _article.Id) return Task.CompletedTask;

    return InvokeAsync(() =>
    {
        var target = _comments.FirstOrDefault(c => c.Id == commentId)
                     ?? _comments.SelectMany(c => c.Replies).FirstOrDefault(r => r.Id == commentId);

        if (target != null)
        {
            target.StatusId = newStatusId;
            // Si el propio comentario raíz queda como hoja borrada, se filtra
            // en el markup con ShouldRender — no hace falta quitarlo aquí.
        }
        StateHasChanged();
    });
}








<div class="comments-list">
    @foreach (var c in _comments.Where(c => c.ShouldRender))
    {
        <CommentCard Id="@c.Id"
                     ParentCommentId="@c.ParentCommentId"
                     RootCommentId="null"
                     AuthorName="@c.AuthorName"
                     AuthorInitials="@c.AuthorInitials"
                     AuthorColorFrom="@c.AuthorColorFrom"
                     AuthorColorTo="@c.AuthorColorTo"
                     Content="@c.Content"
                     IsDeleted="@c.IsDeleted"
                     IsEdited="@c.IsEdited"
                     CreatedAt="@c.CreatedAt"
                     Likes="@c.LikesCount"
                     IsLiked="@c.IsLikedByCurrentUser"
                     CanEditOrDelete="@c.CanEditOrDelete && !c.IsDeleted"
                     ReplyingToAuthorName="@c.ReplyingToAuthorName"
                     Replies="@c.Replies.Where(r => r.ShouldRender).ToList()"
                     OnLike="HandleCommentLike"
                     OnReply="HandleCommentReply"
                     OnEdit="HandleCommentEdit"
                     OnDelete="HandleCommentDelete" />
    }
</div>




@if (IsDeleted)
{
    <div class="comment comment--deleted">
        <p class="comment__placeholder"><em>Este comentario ha sido eliminado</em></p>
        @if (Replies.Count > 0)
        {
            <div class="comment__replies">
                @foreach (var r in Replies)
                {
                    <!-- recursión normal de CommentCard -->
                }
            </div>
        }
    </div>
}
else
{
    <!-- render normal + badge "(editado)" si IsEdited -->
}


