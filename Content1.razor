        builder.HasOne<SecurityUser>()
            .WithMany()
            .HasForeignKey(a => a.UploadedByUserId)
            .HasConstraintName("FK_IncidentAttachments_SecurityUsers_UploadedBy")
            .OnDelete(DeleteBehavior.Restrict);
