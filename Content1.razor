-- 1. TABLAS HIJAS: Tablas que dependen de 'articles' (DEBES ELIMINAR ESTAS PRIMERO)
SELECT 
    OBJECT_NAME(f.parent_object_id) AS Tabla_Hija_ADeletarPrimero,
    COL_NAME(fc.parent_object_id, fc.parent_column_id) AS Columna_FK_Hija,
    OBJECT_NAME(f.referenced_object_id) AS Tabla_Padre,
    f.name AS Nombre_FK
FROM sys.foreign_keys AS f
INNER JOIN sys.foreign_key_columns AS fc 
    ON f.object_id = fc.constraint_object_id
WHERE OBJECT_NAME(f.referenced_object_id) = 'articles'

UNION ALL

-- 2. TABLAS PADRE: Tablas de las que depende 'articles' (ESTAS LAS ELIMINAS AL FINAL)
SELECT 
    OBJECT_NAME(f.parent_object_id) AS Tabla_Actual,
    COL_NAME(fc.parent_object_id, fc.parent_column_id) AS Columna_FK_Actual,
    OBJECT_NAME(f.referenced_object_id) AS Tabla_Padre_ADeletarAlFinal,
    f.name AS Nombre_FK
FROM sys.foreign_keys AS f
INNER JOIN sys.foreign_key_columns AS fc 
    ON f.object_id = fc.constraint_object_id
WHERE OBJECT_NAME(f.parent_object_id) = 'articles';
