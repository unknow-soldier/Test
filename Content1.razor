public async Task LinkSecurityUserAsync(Guid authorId, Guid securityUserId)
{
    await using var db = await _dbFactory.CreateDbContextAsync();

    // 1. Buscar si el autor existe
    var author = await db.Authors.FirstOrDefaultAsync(a => a.Id == authorId);
    if (author is null) return;

    // 2. Verificar si el SecurityUser realmente existe en la BD
    var securityUserExists = await db.SecurityUsers.AnyAsync(s => s.Id == securityUserId);
    if (!securityUserExists)
    {
        // Si el usuario fue eliminado, no se puede hacer el vínculo.
        // Aquí puedes lanzar una excepción o simplemente retornar.
        return; 
    }

    // 3. Asignar y guardar
    author.SecurityUserId = securityUserId;
    await db.SaveChangesAsync();
}
