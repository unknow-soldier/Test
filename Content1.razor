using CorpWiki.Domain.Entities.Incidents;
using CorpWiki.Domain.Entities.Security;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace CorpWiki.Infrastructure.Persistence.Configurations.Incidents;

public class IncidentTimeSegmentConfiguration : IEntityTypeConfiguration<IncidentTimeSegment>
{
    public void Configure(EntityTypeBuilder<IncidentTimeSegment> builder)
    {
        builder.ToTable("IncidentTimeSegments");
        builder.HasKey(s => s.Id);

        // Duration es una propiedad calculada en memoria (no persistida).
        builder.Ignore(s => s.Duration);

        builder.HasOne<Incident>()
            .WithMany()
            .HasForeignKey(s => s.IncidentId)
            .HasConstraintName("FK_IncidentTimeSegments_Incidents")
            .OnDelete(DeleteBehavior.Cascade);

        builder.HasOne<Area>()
            .WithMany()
            .HasForeignKey(s => s.AreaId)
            .HasConstraintName("FK_IncidentTimeSegments_Areas")
            .OnDelete(DeleteBehavior.Restrict);

        builder.HasOne<SecurityUser>()
            .WithMany()
            .HasForeignKey(s => s.UserId)
            .HasConstraintName("FK_IncidentTimeSegments_SecurityUsers")
            .IsRequired(false)
            .OnDelete(DeleteBehavior.Restrict);

        builder.HasIndex(s => new { s.IncidentId, s.StartedAt });
    }
}






using CorpWiki.Domain.Entities.Incidents;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace CorpWiki.Infrastructure.Persistence.Configurations.Incidents;

public class IncidentRelatedArticleConfiguration : IEntityTypeConfiguration<IncidentRelatedArticle>
{
    public void Configure(EntityTypeBuilder<IncidentRelatedArticle> builder)
    {
        builder.ToTable("IncidentRelatedArticles");
        builder.HasKey(a => a.Id);

        builder.Property(a => a.Title).HasMaxLength(300).IsRequired();
        builder.Property(a => a.Url).HasMaxLength(500).IsRequired();
        builder.Property(a => a.Icon).HasMaxLength(50).IsRequired();
    }
}

public DbSet<IncidentTimeSegment> IncidentTimeSegments => Set<IncidentTimeSegment>();
public DbSet<IncidentRelatedArticle> IncidentRelatedArticles => Set<IncidentRelatedArticle>();

