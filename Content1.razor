WITH RECURSIVE nums200 (n) AS (
    SELECT 1 FROM SYSIBM.SYSDUMMY1
    UNION ALL
    SELECT n + 1 FROM nums200 WHERE n < 200
),
seq20000 (n) AS (
    SELECT (a.n - 1) * 200 + b.n
    FROM nums200 a, nums200 b
    WHERE (a.n - 1) * 200 + b.n <= 20000
)
INSERT INTO bcah96dta.LNPLAN02
    (CPAGPTM, CIDENTI, CNOMBRE, CEMAL, CCELULAR, CTASA, CTIPO, CSDOINI, CCUOTA, CPLAZO)
SELECT
    1700000000 + n,
    LPAD(CHAR(800000000000 + n), 13, '0'),
    CASE MOD(n,5)
        WHEN 0 THEN 'CARLOS ANDRES MEJIA LOPEZ'
        WHEN 1 THEN 'MARIA ELENA SOSA PORTILLO'
        WHEN 2 THEN 'JOSE LUIS RAMIREZ FLORES'
        WHEN 3 THEN 'ANA GABRIELA TORRES MARTINEZ'
        ELSE 'LUIS FERNANDO CASTILLO ORTIZ'
    END,
    'cliente' || CHAR(n) || '@correo.com',
    90000000 + MOD(n * 37, 9999999),
    DEC(10 + MOD(n, 15), 5, 3),
    CASE MOD(n,3)
        WHEN 0 THEN 'PRESTAMO PERSONAL'
        WHEN 1 THEN 'PRESTAMO HIPOTECARIO'
        ELSE 'PRESTAMO VEHICULAR'
    END,
    DEC(5000 + MOD(n * 123, 45000), 11, 2),
    DEC(300 + MOD(n * 17, 2200), 11, 2),
    6 + MOD(n, 54)
FROM seq20000;