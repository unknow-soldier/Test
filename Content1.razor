    private async Task<IncidentSummaryDto> ToSummaryDtoAsync(Incident incident)
    {
        var area = await GetAreaByIdAsync(incident.CurrentAreaId);
        var responsible = incident.CurrentResponsibleId.HasValue
            ? await GetUserByIdAsync(incident.CurrentResponsibleId.Value)
            : null;
        var (activeHours, deadHours) = await ComputeHoursAsync(incident.Id);
        var commentsCount = await _db.IncidentComments.CountAsync(c => c.IncidentId == incident.Id);
        var transfersCount = await _db.IncidentTransfers.CountAsync(t => t.IncidentId == incident.Id);

        return new IncidentSummaryDto
        {
            Id = incident.Id,
            Code = incident.Code,
            Title = incident.Title,
            Status = incident.Status,
            Priority = incident.Priority,
            AreaName = area?.Name ?? "-",
            AreaColor = area?.Color ?? "#334155",
            ResponsibleName = responsible?.FullName,
            ResponsibleInitials = responsible != null ? GetInitials(responsible.FullName) : null,
            CreatedAt = incident.CreatedAt,
            UpdatedAt = incident.UpdatedAt,
            CommentsCount = commentsCount,
            TransfersCount = transfersCount,
            TotalActiveHours = activeHours,
            TotalDeadHours = deadHours,
            ResponsibleAvatarColorFrom = responsible?.AvatarColorFrom,
            ResponsibleAvatarColorTo = responsible?.AvatarColorTo
        };
    }

