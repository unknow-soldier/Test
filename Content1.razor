INSERT INTO bcah96dta.LNPLAN01
    (PPAGPTM, PPAGNCUO, PPAGFHA, PPASDOINI, PAGOCAPIT, PAGOINTER, PPAGPROG, PPACAREXT, PPACUOTOT, PAGSDOFIN, PAGINTACU, PAGCARGO)
WITH RECURSIVE nums200 (n) AS (
    SELECT 1 FROM SYSIBM.SYSDUMMY1
    UNION ALL
    SELECT n + 1 FROM nums200 WHERE n < 200
),
seq20000 (n) AS (
    SELECT (a.n - 1) * 200 + b.n
    FROM nums200 a, nums200 b
    WHERE (a.n - 1) * 200 + b.n <= 20000
),
cuotas (c) AS (
    SELECT 1 FROM SYSIBM.SYSDUMMY1
    UNION ALL SELECT 2 FROM SYSIBM.SYSDUMMY1
    UNION ALL SELECT 3 FROM SYSIBM.SYSDUMMY1
)
SELECT
    1700000000 + s.n,
    c.c,
    INT(REPLACE(CHAR(ADD_MONTHS(DATE('2026-02-01'), c.c - 1), ISO), '-', '')),
    DEC(5000 + MOD(s.n * 123, 45000), 11, 2) - (c.c - 1) * DEC(200 + MOD(s.n,50), 11, 2),
    DEC(200 + MOD(s.n * 7, 900), 11, 2),
    DEC(50 + MOD(s.n * 3, 300), 11, 2),
    DEC(300 + MOD(s.n * 17, 2200), 11, 2),
    DEC(20 + MOD(s.n, 30), 11, 2),
    DEC(320 + MOD(s.n * 17, 2200), 11, 2),
    DEC(5000 + MOD(s.n * 123, 45000), 11, 2) - c.c * DEC(200 + MOD(s.n,50), 11, 2),
    c.c * DEC(50 + MOD(s.n * 3, 300), 11, 2),
    0.00
FROM seq20000 s, cuotas c