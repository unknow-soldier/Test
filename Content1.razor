    private async Task<IncidentSummaryDto> ToSummaryDtoAsync(DaviWikiDbContext db, Incident incident)
    {
        var area = await db.Areas.FirstOrDefaultAsync(a => a.Id == incident.CurrentAreaId);
        var responsibles = await GetResponsiblesInternalAsync(db, incident.Id);
        var (activeHours, deadHours) = await ComputeHoursAsync(db, incident.Id);
        var commentsCount = await db.IncidentComments.CountAsync(c => c.IncidentId == incident.Id);
        var transfersCount = await db.IncidentTransfers.CountAsync(t => t.IncidentId == incident.Id);

        var involved = await db.IncidentParticipants
            .Where(p => p.IncidentId == incident.Id)
            .Select(p => p.SecurityUserId)
            .Distinct()
            .ToListAsync();
        if (!involved.Contains(incident.CreatedByUserId)) involved.Add(incident.CreatedByUserId);

        var everResponsible = await db.IncidentParticipants
            .Where(p => p.IncidentId == incident.Id && p.Role == IncidentParticipantRole.Responsable)
            .Select(p => p.SecurityUserId)
            .Distinct()
            .ToListAsync();

        return new IncidentSummaryDto
        {
            Id = incident.Id,
            Code = incident.Code,
            Title = incident.Title,
            Status = incident.Status,
            Priority = incident.Priority,
            AreaName = area?.Name ?? "-",
            AreaColor = area?.Color ?? "#334155",
            Responsibles = responsibles,
            CreatedByUserId = incident.CreatedByUserId,
            InvolvedUserIds = involved,
            EverResponsibleUserIds = everResponsible,
            CreatedAt = incident.CreatedAt,
            UpdatedAt = incident.UpdatedAt,
            CommentsCount = commentsCount,
            TransfersCount = transfersCount,
            TotalActiveHours = activeHours,
            TotalDeadHours = deadHours,
            SlaHours = IncidentSlaHelper.SlaHoursFor(incident.Priority),
            IsOverdue = IncidentSlaHelper.IsOverdue(incident.Priority, incident.CreatedAt, incident.ClosedAt)
        };
    }

