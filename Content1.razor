using System;
using System.Security.Cryptography;
using System.Text;

namespace CorpWiki.Infrastructure.Security;

/// <summary>
/// Encriptación simétrica simple para ofuscar cadenas de conexión y secretos
/// en appsettings.json, evitando que queden en texto plano en el repo/servidor.
/// NOTA: la llave está embebida en el ensamblado — protege contra "mirones" y
/// filtraciones accidentales del JSON, no contra alguien con acceso al binario.
/// </summary>
public static class ConfigObfuscator
{
    private static readonly byte[] StaticKey = Convert.FromBase64String("z9xO7vP1/qK4mD2jL8nB5aC0fR3uW6xY9sV2oE5hHIg=");

    private const int NonceSize = 12;
    private const int TagSize = 16;
    public const string Prefix = "ENC:";

    public static string Encrypt(string plainText)
    {
        if (string.IsNullOrEmpty(plainText)) return plainText;

        var plainBytes = Encoding.UTF8.GetBytes(plainText);
        var nonce = new byte[NonceSize];
        RandomNumberGenerator.Fill(nonce);

        var cipherBytes = new byte[plainBytes.Length];
        var tag = new byte[TagSize];

        using var aes = new AesGcm(StaticKey, TagSize);
        aes.Encrypt(nonce, plainBytes, cipherBytes, tag);

        var result = new byte[NonceSize + TagSize + cipherBytes.Length];
        Buffer.BlockCopy(nonce, 0, result, 0, NonceSize);
        Buffer.BlockCopy(tag, 0, result, NonceSize, TagSize);
        Buffer.BlockCopy(cipherBytes, 0, result, NonceSize + TagSize, cipherBytes.Length);

        return Prefix + Convert.ToBase64String(result);
    }

    public static string Decrypt(string cipherText)
    {
        if (string.IsNullOrEmpty(cipherText) || !cipherText.StartsWith(Prefix))
            return cipherText;

        var actualCipher = cipherText.Substring(Prefix.Length);

        try
        {
            var fullBytes = Convert.FromBase64String(actualCipher);
            if (fullBytes.Length < NonceSize + TagSize) return cipherText;

            var nonce = new byte[NonceSize];
            var tag = new byte[TagSize];
            var cipherBytes = new byte[fullBytes.Length - NonceSize - TagSize];

            Buffer.BlockCopy(fullBytes, 0, nonce, 0, NonceSize);
            Buffer.BlockCopy(fullBytes, NonceSize, tag, 0, TagSize);
            Buffer.BlockCopy(fullBytes, NonceSize + TagSize, cipherBytes, 0, cipherBytes.Length);

            var plainBytes = new byte[cipherBytes.Length];

            using var aes = new AesGcm(StaticKey, TagSize);
            aes.Decrypt(nonce, cipherBytes, tag, plainBytes);

            return Encoding.UTF8.GetString(plainBytes);
        }
        catch
        {
            return cipherText;
        }
    }
}









var provider = configuration["DatabaseProvider"] ?? "MySQL";
var rawConnectionString = configuration.GetConnectionString(provider);

if (string.IsNullOrWhiteSpace(rawConnectionString))
{
    throw new InvalidOperationException(
        $"No se encontró ConnectionString para el proveedor '{provider}'. " +
        $"Verifique la sección ConnectionStrings:{provider} en appsettings.json.");
}

// Si viene con prefijo ENC: se desencripta; si no, se usa tal cual (útil en dev)
var connectionString = ConfigObfuscator.Decrypt(rawConnectionString);






