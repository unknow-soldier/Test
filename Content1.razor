private async Task LogActivityAsync(DaviWikiDbContext db, Guid incidentId, IncidentActivityType type, Guid actorUserId, string description, DateTime occurredAt, string? oldValue = null, string? newValue = null)
{
    db.IncidentActivityEntries.Add(new IncidentActivityEntry
    {
        Id = Guid.NewGuid(), IncidentId = incidentId, Type = type,
        ActorUserId = actorUserId, Description = description, OccurredAt = occurredAt,
        OldValue = oldValue, NewValue = newValue
    });
    await Task.CompletedTask;
}





