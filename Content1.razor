namespace CorpWiki.Infrastructure.Options;

public class DataProtectionOptions
{
    public const string SectionName = "DataProtection";

    public string CertificatePath { get; set; } = string.Empty;
    public string CertificatePassword { get; set; } = string.Empty;
    public string KeysPath { get; set; } = string.Empty;
}




using System;
using System.IO;
using System.Security.Cryptography;
using System.Security.Cryptography.X509Certificates;
using Microsoft.AspNetCore.DataProtection;
using Microsoft.Extensions.Configuration;
using CorpWiki.Infrastructure.Options;

namespace CorpWiki.Infrastructure.Security;

/// <summary>
/// Cifra/descifra cadenas de conexión usando Data Protection API protegido
/// con un certificado X.509. Funciona igual en Windows, Linux y contenedores.
/// </summary>
public static class ConnectionStringProtector
{
    private const string Purpose = "CorpWiki.ConnectionStrings.v1";
    private const string EncryptedPrefix = "ENC:";

    private static DataProtectionOptions LoadOptions(IConfiguration configuration)
    {
        var options = configuration
            .GetSection(DataProtectionOptions.SectionName)
            .Get<DataProtectionOptions>();

        if (options is null || string.IsNullOrWhiteSpace(options.CertificatePath))
        {
            throw new InvalidOperationException(
                "Falta configurar la sección 'DataProtection' (CertificatePath) en appsettings.json.");
        }

        if (string.IsNullOrWhiteSpace(options.KeysPath))
        {
            throw new InvalidOperationException(
                "Falta configurar 'DataProtection:KeysPath' en appsettings.json.");
        }

        return options;
    }

    private static X509Certificate2 LoadCertificate(DataProtectionOptions options)
    {
        if (!File.Exists(options.CertificatePath))
        {
            throw new FileNotFoundException(
                $"No se encontró el certificado en '{options.CertificatePath}'. " +
                "Verifique la ruta configurada en DataProtection:CertificatePath.");
        }

        // La contraseña puede venir vacía si el .pfx no tiene una (no recomendado en prod)
        return string.IsNullOrEmpty(options.CertificatePassword)
            ? new X509Certificate2(options.CertificatePath)
            : new X509Certificate2(options.CertificatePath, options.CertificatePassword);
    }

    private static IDataProtector CreateProtector(IConfiguration configuration)
    {
        var options = LoadOptions(configuration);
        var certificate = LoadCertificate(options);

        Directory.CreateDirectory(options.KeysPath);

        var provider = DataProtectionProvider.Create(
            new DirectoryInfo(options.KeysPath),
            builder =>
            {
                builder.SetApplicationName("CorpWiki");
                builder.ProtectKeysWithCertificate(certificate);
            });

        return provider.CreateProtector(Purpose);
    }

    /// <summary>Cifra un valor plano y devuelve el string listo para pegar en appsettings.json.</summary>
    public static string Protect(string plainText, IConfiguration configuration)
    {
        var protector = CreateProtector(configuration);
        return EncryptedPrefix + protector.Protect(plainText);
    }

    /// <summary>
    /// Si el valor viene cifrado (prefijo "ENC:"), lo descifra.
    /// Si no, lo devuelve tal cual (útil en dev local sin cifrar).
    /// </summary>
    public static string Resolve(string value, IConfiguration configuration)
    {
        if (string.IsNullOrEmpty(value) || !value.StartsWith(EncryptedPrefix, StringComparison.Ordinal))
            return value;

        var protector = CreateProtector(configuration);
        var cipherText = value[EncryptedPrefix.Length..];

        try
        {
            return protector.Unprotect(cipherText);
        }
        catch (CryptographicException ex)
        {
            throw new InvalidOperationException(
                "No se pudo descifrar la cadena de conexión. Verifique que el certificado " +
                "configurado sea el mismo con el que se cifró originalmente, y que " +
                "DataProtection:KeysPath apunte a la misma carpeta de llaves.", ex);
        }
    }
}





