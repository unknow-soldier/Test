    private async Task<IncidentSummaryDto> ToSummaryDtoAsync(Incident incident)
    {
        var area = await GetAreaByIdAsync(incident.CurrentAreaId);
        var responsibles = await GetResponsiblesAsync(incident.Id);
        var (activeHours, deadHours) = await ComputeHoursAsync(incident.Id);
        var commentsCount = await _db.IncidentComments.CountAsync(c => c.IncidentId == incident.Id);
        var transfersCount = await _db.IncidentTransfers.CountAsync(t => t.IncidentId == incident.Id);

        return new IncidentSummaryDto
        {
            Id = incident.Id,
            Code = incident.Code,
            Title = incident.Title,
            Status = incident.Status,
            Priority = incident.Priority,
            AreaName = area?.Name ?? "-",
            AreaColor = area?.Color ?? "#334155",
            Responsibles = responsibles.ToList(),
            CreatedAt = incident.CreatedAt,
            UpdatedAt = incident.UpdatedAt,
            CommentsCount = commentsCount,
            TransfersCount = transfersCount,
            TotalActiveHours = activeHours,
            TotalDeadHours = deadHours
        };
    }

    private async Task<IncidentCommentDto> ToCommentDtoAsync(IncidentComment comment)
    {
        var author = await GetUserByIdAsync(comment.AuthorUserId);
        return new IncidentCommentDto
        {
            Id = comment.Id, AuthorName = author?.FullName ?? "-",
            AuthorInitials = GetInitials(author?.FullName), Text = comment.Text, CreatedAt = comment.CreatedAt
        };
    }

    private async Task<IncidentTransferDto> ToTransferDtoAsync(IncidentTransfer transfer)
    {
        var from = await GetUserByIdAsync(transfer.FromUserId);
        var to = await GetUserByIdAsync(transfer.ToUserId);
        var fromArea = await GetAreaByIdAsync(transfer.FromAreaId);
        var toArea = await GetAreaByIdAsync(transfer.ToAreaId);

        return new IncidentTransferDto
        {
            Id = transfer.Id,
            FromUserName = from?.FullName ?? "-",
            ToUserName = to?.FullName ?? "-",
            FromAreaName = fromArea?.Name ?? "-",
            ToAreaName = toArea?.Name ?? "-",
            Reason = transfer.Reason,
            TransferredAt = transfer.TransferredAt
        };
    }

    private async Task<IncidentActivityDto> ToActivityDtoAsync(IncidentActivityEntry entry)
    {
        var actor = await GetUserByIdAsync(entry.ActorUserId);
        return new IncidentActivityDto
        {
            Id = entry.Id, Type = entry.Type, ActorName = actor?.FullName ?? "-",
            Description = entry.Description, OccurredAt = entry.OccurredAt
        };
    }

    private async Task<IncidentTimeSegmentDto> ToSegmentDtoAsync(IncidentTimeSegment segment)
    {
        var area = await GetAreaByIdAsync(segment.AreaId);
        var user = segment.UserId.HasValue ? await GetUserByIdAsync(segment.UserId.Value) : null;

        return new IncidentTimeSegmentDto
        {
            AreaName = area?.Name ?? "-",
            UserName = user?.FullName,
            StartedAt = segment.StartedAt,
            EndedAt = segment.EndedAt,
            IsActiveWork = segment.IsActiveWork,
            DurationHours = Math.Round(segment.Duration.TotalHours, 1)
        };
    }
