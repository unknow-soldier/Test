<div style="display:flex; align-items:center; gap:14px; padding: 16px 20px; border-radius: 14px 14px 0 0; background:@ColorUtils.ToRgba(stage.Color, 0.14);">
    <div style="width:42px; height:42px; min-width:42px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:@stage.Color; color:#fff;">
        <Icon Name="@stage.Icon" />
    </div>
    <div style="flex:1; min-width:0; color:@stage.Color;">
        <h3 style="margin:0; font-size:1.05rem; line-height:1.3;">@stage.AreaName</h3>
        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center; font-size:0.8rem; opacity:0.9; margin-top:2px;">
            <span>Etapa @(stage.Index + 1) de @_stories.Count</span>
            <span class="journey-stage-badge">@StageLabel(stage)</span>
        </div>
    </div>
    <div style="display:flex; gap:6px; flex-shrink:0;">
        <button type="button" class="btn btn--ghost btn--sm" @onclick="ToggleExpandModal" title="Ampliar / reducir">
            <Icon Name="@(_isExpanded ? "minimize-2" : "maximize-2")" />
        </button>
        <button type="button" class="btn btn--ghost btn--sm" @onclick="CloseJourneyModal" title="Cerrar">
            <Icon Name="x-circle" />
        </button>
    </div>
</div>


