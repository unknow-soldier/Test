using CorpWiki.Domain.Entities.Incidents;
using CorpWiki.Domain.Entities.Security;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace CorpWiki.Infrastructure.Persistence.Configurations.Incidents;

public class IncidentAttachmentConfiguration : IEntityTypeConfiguration<IncidentAttachment>
{
    public void Configure(EntityTypeBuilder<IncidentAttachment> builder)
    {
        builder.ToTable("IncidentAttachments");
        builder.HasKey(a => a.Id);

        builder.Property(a => a.FileName).HasMaxLength(260).IsRequired();
        builder.Property(a => a.FileType).HasMaxLength(20).IsRequired();
        builder.Property(a => a.SizeLabel).HasMaxLength(20);

        builder.HasOne<Incident>()
            .WithMany()
            .HasForeignKey(a => a.IncidentId)
            .HasConstraintName("FK_IncidentAttachments_Incidents")
            .OnDelete(DeleteBehavior.Cascade);

        builder.HasOne<SecurityUser>()
            .WithMany()
            .HasForeignKey(a => a.UploadedByUserId)
            .HasConstraintName("FK_IncidentAttachments_SecurityUsers_UploadedBy")
            .OnDelete(DeleteBehavior.Restrict);
    }
}






using CorpWiki.Domain.Entities.Incidents;
using CorpWiki.Domain.Entities.Security;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace CorpWiki.Infrastructure.Persistence.Configurations.Incidents;

public class IncidentTransferConfiguration : IEntityTypeConfiguration<IncidentTransfer>
{
    public void Configure(EntityTypeBuilder<IncidentTransfer> builder)
    {
        builder.ToTable("IncidentTransfers");
        builder.HasKey(t => t.Id);

        builder.Property(t => t.Reason).HasMaxLength(500);

        builder.HasOne<Incident>()
            .WithMany()
            .HasForeignKey(t => t.IncidentId)
            .HasConstraintName("FK_IncidentTransfers_Incidents")
            .OnDelete(DeleteBehavior.Cascade);

        // --- Aquí está el caso de las dos FK al mismo tipo ---

        builder.HasOne<SecurityUser>()
            .WithMany()
            .HasForeignKey(t => t.FromUserId)
            .HasConstraintName("FK_IncidentTransfers_SecurityUsers_FromUser")
            .OnDelete(DeleteBehavior.Restrict);

        builder.HasOne<SecurityUser>()
            .WithMany()
            .HasForeignKey(t => t.ToUserId)
            .HasConstraintName("FK_IncidentTransfers_SecurityUsers_ToUser")
            .OnDelete(DeleteBehavior.Restrict);

        // Áreas: mismo caso, dos FK al mismo tipo (FromAreaId / ToAreaId)
        builder.HasOne<Area>()
            .WithMany()
            .HasForeignKey(t => t.FromAreaId)
            .HasConstraintName("FK_IncidentTransfers_Areas_FromArea")
            .OnDelete(DeleteBehavior.Restrict);

        builder.HasOne<Area>()
            .WithMany()
            .HasForeignKey(t => t.ToAreaId)
            .HasConstraintName("FK_IncidentTransfers_Areas_ToArea")
            .OnDelete(DeleteBehavior.Restrict);
    }
}




using CorpWiki.Domain.Entities.Incidents;
using CorpWiki.Domain.Entities.Security;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace CorpWiki.Infrastructure.Persistence.Configurations.Incidents;

public class IncidentActivityEntryConfiguration : IEntityTypeConfiguration<IncidentActivityEntry>
{
    public void Configure(EntityTypeBuilder<IncidentActivityEntry> builder)
    {
        builder.ToTable("IncidentActivityEntries");
        builder.HasKey(e => e.Id);

        builder.Property(e => e.Description).HasMaxLength(1000);

        builder.Property(e => e.Type)
            .HasConversion<string>()
            .HasMaxLength(30);

        builder.HasOne<Incident>()
            .WithMany()
            .HasForeignKey(e => e.IncidentId)
            .HasConstraintName("FK_IncidentActivityEntries_Incidents")
            .OnDelete(DeleteBehavior.Cascade);

        builder.HasOne<SecurityUser>()
            .WithMany()
            .HasForeignKey(e => e.ActorUserId)
            .HasConstraintName("FK_IncidentActivityEntries_SecurityUsers_Actor")
            .OnDelete(DeleteBehavior.Restrict);
    }
}



