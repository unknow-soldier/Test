public class Enc {
    public static string Run(string plainText) {
        byte[] key = Convert.FromBase64String("z9xO7vP1/qK4mO2jL8nB5aC0fR3uW6xY9sV2oE5hHIg=");
        byte[] plainBytes = Encoding.UTF8.GetBytes(plainText);
        byte[] nonce = new byte[12]; byte[] tag = new byte[16]; byte[] cipherBytes = new byte[plainBytes.Length];
