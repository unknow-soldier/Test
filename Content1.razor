    public async Task LinkArticleAsync(Guid incidentId, Guid articleId, Guid actorUserId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var exists = await db.IncidentArticleLinks.AnyAsync(l => l.IncidentId == incidentId && l.ArticleId == articleId);
        if (exists) return;

        db.IncidentArticleLinks.Add(new IncidentArticleLink
        {
            Id = Guid.NewGuid(), IncidentId = incidentId, ArticleId = articleId,
            LinkedByUserId = actorUserId, LinkedAt = DateTime.Now
        });

        var actor = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == actorUserId);
        var article = await db.Articles.FirstOrDefaultAsync(a => a.Id == articleId);
        await LogActivityAsync(db, incidentId, IncidentActivityType.Editada, actorUserId,
            $"{actor?.FullName ?? "-"} vinculó el artículo \"{article?.Title ?? "-"}\".", DateTime.Now);

        await db.SaveChangesAsync();
    }

    public async Task UnlinkArticleAsync(Guid incidentId, Guid articleId, Guid actorUserId)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var link = await db.IncidentArticleLinks.FirstOrDefaultAsync(l => l.IncidentId == incidentId && l.ArticleId == articleId);
        if (link == null) return;

        db.IncidentArticleLinks.Remove(link);

        var actor = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == actorUserId);
        await LogActivityAsync(db, incidentId, IncidentActivityType.Editada, actorUserId,
            $"{actor?.FullName ?? "-"} quitó un artículo relacionado.", DateTime.Now);

        await db.SaveChangesAsync();
    }

