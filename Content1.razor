$code = @"
using System;
using System.Security.Cryptography;
using System.Text;

public class Enc {
    public static string Run(string plainText) {
        byte[] key = Convert.FromBase64String("z9xO7vP1/qK4mO2jL8nB5aC0fR3uW6xY9sV2oE5hHIg=");
        byte[] plainBytes = Encoding.UTF8.GetBytes(plainText);
        byte[] nonce = new byte[12];
        byte[] tag = new byte[16];
        byte[] cipherBytes = new byte[plainBytes.Length];
        
        RandomNumberGenerator.Fill(nonce);
        using (var aes = new AesGcm(key, 16)) { 
            aes.Encrypt(nonce, plainBytes, cipherBytes, tag); 
        }
        
        byte[] res = new byte[28 + cipherBytes.Length];
        Buffer.BlockCopy(nonce, 0, res, 0, 12);
        Buffer.BlockCopy(tag, 0, res, 12, 16);
        Buffer.BlockCopy(cipherBytes, 0, res, 28, cipherBytes.Length);
        
        return "ENC(" + Convert.ToBase64String(res) + ")";
    }
}
"@

Add-Type -TypeDefinition $code
$resultado = [Enc]::Run($plainText)

