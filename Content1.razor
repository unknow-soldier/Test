using System.Text.Json;
using CorpWiki.Domain.Entities;
using CorpWiki.Domain.Entities.Incidents;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.ChangeTracking;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace CorpWiki.Infrastructure.Persistence.Configurations.Incidents;

public class IncidentConfiguration : IEntityTypeConfiguration<Incident>
{
    public void Configure(EntityTypeBuilder<Incident> builder)
    {
        builder.ToTable("Incidents");
        builder.HasKey(i => i.Id);

        builder.Property(i => i.Code).HasMaxLength(20).IsRequired();
        builder.Property(i => i.Title).HasMaxLength(200).IsRequired();
        builder.Property(i => i.Description).HasColumnType("nvarchar(max)");

        builder.Property(i => i.Status)
            .HasConversion<string>()
            .HasMaxLength(30);

        builder.Property(i => i.Priority)
            .HasConversion<string>()
            .HasMaxLength(20);

        builder.Property(i => i.Content)
            .HasColumnName("ContentJson")
            .HasColumnType("nvarchar(max)")
            .HasConversion(
                v => JsonSerializer.Serialize(v ?? new List<ArticleContentBlock>(), (JsonSerializerOptions?)null),
                v => JsonSerializer.Deserialize<List<ArticleContentBlock>>(v, (JsonSerializerOptions?)null) ?? new List<ArticleContentBlock>())
            .Metadata.SetValueComparer(new ValueComparer<List<ArticleContentBlock>>(
                (a, b) => JsonSerializer.Serialize(a, (JsonSerializerOptions?)null) == JsonSerializer.Serialize(b, (JsonSerializerOptions?)null),
                c => JsonSerializer.Serialize(c, (JsonSerializerOptions?)null).GetHashCode(),
                c => JsonSerializer.Deserialize<List<ArticleContentBlock>>(JsonSerializer.Serialize(c, (JsonSerializerOptions?)null), (JsonSerializerOptions?)null)!));

        builder.HasOne<Area>()
            .WithMany()
            .HasForeignKey(i => i.OriginAreaId)
            .HasConstraintName("FK_Incidents_Areas_Origin")
            .OnDelete(DeleteBehavior.Restrict);

        builder.HasOne<Area>()
            .WithMany()
            .HasForeignKey(i => i.CurrentAreaId)
            .HasConstraintName("FK_Incidents_Areas_Current")
            .OnDelete(DeleteBehavior.Restrict);

        builder.HasOne(i => i.CreatedByUser)
            .WithMany()
            .HasForeignKey(i => i.CreatedByUserId)
            .HasConstraintName("FK_Incidents_SecurityUsers_CreatedBy")
            .OnDelete(DeleteBehavior.Restrict);

        builder.HasMany(i => i.Participants)
            .WithOne(p => p.Incident)
            .HasForeignKey(p => p.IncidentId)
            .OnDelete(DeleteBehavior.Cascade);
    }
}






using CorpWiki.Domain.Entities.Incidents;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace CorpWiki.Infrastructure.Persistence.Configurations.Incidents;

public class IncidentParticipantConfiguration : IEntityTypeConfiguration<IncidentParticipant>
{
    public void Configure(EntityTypeBuilder<IncidentParticipant> builder)
    {
        builder.ToTable("IncidentParticipants");
        builder.HasKey(p => p.Id);

        builder.HasOne(p => p.Incident)
            .WithMany(i => i.Participants)
            .HasForeignKey(p => p.IncidentId)
            .HasConstraintName("FK_IncidentParticipants_Incidents")
            .OnDelete(DeleteBehavior.Cascade);

        builder.HasOne(p => p.SecurityUser)
            .WithMany(u => u.IncidentParticipations)
            .HasForeignKey(p => p.SecurityUserId)
            .HasConstraintName("FK_IncidentParticipants_SecurityUsers")
            .OnDelete(DeleteBehavior.Restrict);

        builder.HasOne(p => p.Area)
            .WithMany()
            .HasForeignKey(p => p.AreaId)
            .HasConstraintName("FK_IncidentParticipants_Areas")
            .OnDelete(DeleteBehavior.Restrict);

        builder.Property(p => p.Role)
            .HasConversion<string>()
            .HasMaxLength(30);

        builder.HasIndex(p => new { p.IncidentId, p.SecurityUserId })
            .HasFilter("[RemovedAt] IS NULL")
            .IsUnique();
    }
}






