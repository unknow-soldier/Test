public DbSet<IncidentAttachment> IncidentAttachments => Set<IncidentAttachment>();
public DbSet<IncidentTransfer> IncidentTransfers => Set<IncidentTransfer>();
public DbSet<IncidentActivityEntry> IncidentActivityEntries => Set<IncidentActivityEntry>();
public DbSet<Area> Areas => Set<Area>();
