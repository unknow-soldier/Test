// =========================================================================
// 4. Status: int -> nvarchar(30), remapeando 8 valores viejos a 4 nuevos.
// =========================================================================
migrationBuilder.Sql(@"
    IF EXISTS (
        SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS
        WHERE TABLE_NAME = 'Incidents' AND COLUMN_NAME = 'Status' AND DATA_TYPE = 'int'
    )
    BEGIN
        ALTER TABLE dbo.Incidents ADD StatusText nvarchar(30) NULL;

        EXEC('
            UPDATE Incidents
            SET StatusText = CASE Status
                WHEN 0 THEN ''EnDesarrollo''
                WHEN 1 THEN ''EnDesarrollo''
                WHEN 2 THEN ''EnDesarrollo''
                WHEN 3 THEN ''EnDesarrollo''
                WHEN 4 THEN ''EnDesarrollo''
                WHEN 5 THEN ''Resuelta''
                WHEN 6 THEN ''Cerrada''
                WHEN 7 THEN ''Reactivada''
                ELSE ''EnDesarrollo''
            END;
        ');

        ALTER TABLE dbo.Incidents DROP COLUMN Status;
        EXEC sp_rename 'dbo.Incidents.StatusText', 'Status', 'COLUMN';
        ALTER TABLE dbo.Incidents ALTER COLUMN Status nvarchar(30) NOT NULL;
    END
");



