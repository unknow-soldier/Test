@page "/incidencias"
@attribute [Authorize(Policy = "INCIDENTS:READ")]
@rendermode InteractiveServer
@inject IIncidentService Incidents
@inject NavigationManager Nav
@using CorpWiki.Web.Extensions
@using CorpWiki.Domain.Entities.Security
@using CorpWiki.Application.Helpers
<PageTitle>DaviWiki - Incidencias</PageTitle>

@* ... TODO EL HTML SE QUEDA IGUAL, no lo toques ... *@

@code {
    private IncidentKpiSnapshotDto _kpi = new();
    private IReadOnlyList<IncidentActivityFeedDto> _recentActivity = new List<IncidentActivityFeedDto>();
    private IReadOnlyList<Area> _areas = new List<Area>();
    private IReadOnlyList<SecurityUser> _users = new List<SecurityUser>();
    private int _totalIncidents;

    private List<(string Label, double Value, string Color)> _statusSegments = new();
    private List<(string Label, string ValueLabel, string Color)> _statusLegend = new();
    private List<(string Label, double Value, string Color)> _prioritySegments = new();
    private List<(string Label, string ValueLabel, string Color)> _priorityLegend = new();

    protected override async Task OnInitializedAsync()
    {
        _areas = await Incidents.GetAreasAsync();
        _users = await Incidents.GetUsersAsync();
        _kpi = await Incidents.GetKpiSnapshotAsync();
        _recentActivity = await Incidents.GetRecentActivityAsync(12);
        _totalIncidents = _kpi.StatusDistribution.Sum(s => s.Count);

        foreach (var d in _kpi.StatusDistribution)
        {
            var color = $"var(--status-{IncidentCssHelpers.StatusSuffix(d.Status)})";
            _statusSegments.Add((IncidentLabels.Status(d.Status), d.Count, color));
            _statusLegend.Add((IncidentLabels.Status(d.Status), d.Count.ToString(), color));
        }

        foreach (var d in _kpi.PriorityDistribution)
        {
            var color = $"var(--priority-{IncidentCssHelpers.PrioritySuffix(d.Priority)})";
            _prioritySegments.Add((IncidentLabels.Priority(d.Priority), d.Count, color));
            _priorityLegend.Add((IncidentLabels.Priority(d.Priority), d.Count.ToString(), color));
        }
    }

    private void GoToListadoByStatus(string label)
    {
        var match = _kpi.StatusDistribution.FirstOrDefault(d => IncidentLabels.Status(d.Status) == label);
        if (match is null) return;
        Nav.NavigateTo($"/incidencias/listado?estado={match.Status}");
    }

    private void GoToListadoByPriority(string label)
    {
        var match = _kpi.PriorityDistribution.FirstOrDefault(d => IncidentLabels.Priority(d.Priority) == label);
        if (match is null) return;
        Nav.NavigateTo($"/incidencias/listado?prioridad={match.Priority}");
    }

    private void GoToListadoByArea(string areaName) =>
        Nav.NavigateTo($"/incidencias/listado?area={Uri.EscapeDataString(areaName)}");

    private void GoToListadoByResponsible(string userName) =>
        Nav.NavigateTo($"/incidencias/listado?buscar={Uri.EscapeDataString(userName)}");
}


protected override async Task OnInitializedAsync()
{
    _statusFilter = QueryStatus ?? string.Empty;
    _priorityFilter = QueryPriority ?? string.Empty;
    _areaFilter = QueryArea ?? string.Empty;
    _search = QuerySearch ?? string.Empty;

    _all = await Incidents.GetIncidentSummariesAsync();
    _areas = await Incidents.GetAreasAsync();

    foreach (var status in Enum.GetValues<IncidentStatus>())
    {
        var count = _all.Count(i => i.Status == status);
        if (count == 0) continue;

        var color = $"var(--status-{IncidentCssHelpers.StatusSuffix(status)})";
        _statusBarSegments.Add((IncidentLabels.Status(status), count, color));
        _statusChips.Add((IncidentLabels.Status(status), status.ToString(), count, color));
    }
}