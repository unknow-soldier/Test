using CorpWiki.Application.DTOs;

namespace CorpWiki.Web.Realtime;

public sealed class CommentRealtimeNotifier : ICommentRealtimeNotifier
{
    public event Func<Guid, CommentDto, Task>? CommentAdded;
    public event Func<Guid, CommentDto, Task>? CommentUpdated;
    public event Func<Guid, Guid, int, Task>? CommentStatusChanged;
    public event Func<Guid, Guid, int, Guid, bool, Task>? CommentLikeToggled;

    public Task RaiseCommentAddedAsync(Guid articleId, CommentDto comment)
        => InvokeAllAsync(CommentAdded, h => h(articleId, comment));

    public Task RaiseCommentUpdatedAsync(Guid articleId, CommentDto comment)
        => InvokeAllAsync(CommentUpdated, h => h(articleId, comment));

    public Task RaiseCommentStatusChangedAsync(Guid articleId, Guid commentId, int newStatusId)
        => InvokeAllAsync(CommentStatusChanged, h => h(articleId, commentId, newStatusId));

    public Task RaiseCommentLikeToggledAsync(Guid articleId, Guid commentId, int likesCount, Guid userId, bool liked)
        => InvokeAllAsync(CommentLikeToggled, h => h(articleId, commentId, likesCount, userId, liked));

    private static async Task InvokeAllAsync<THandler>(THandler? multicast, Func<THandler, Task> invoke)
        where THandler : Delegate
    {
        if (multicast is null) return;

        foreach (var handler in multicast.GetInvocationList())
        {
            try
            {
                await invoke((THandler)handler);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[CommentRealtimeNotifier] Error invocando handler: {ex}");
            }
        }
    }
}







using CorpWiki.Application.DTOs;
using CorpWiki.Application.Interfaces;
using CorpWiki.Web.Realtime;

namespace CorpWiki.Web.Hubs;

public class CommentBroadcaster : ICommentBroadcaster
{
    private readonly ICommentRealtimeNotifier _notifier;

    public CommentBroadcaster(ICommentRealtimeNotifier notifier)
    {
        _notifier = notifier;
    }

    private static string GroupName(Guid articleId) => $"{articleId}";

    public Task CommentAddedAsync(Guid articleId, CommentDto comment)
        => _notifier.RaiseCommentAddedAsync(articleId, comment);

    public Task CommentUpdatedAsync(Guid articleId, CommentDto comment)
        => _notifier.RaiseCommentUpdatedAsync(articleId, comment);

    public Task CommentStatusChangedAsync(Guid articleId, Guid commentId, int newStatusId)
        => _notifier.RaiseCommentStatusChangedAsync(articleId, commentId, newStatusId);

    public Task CommentLikeToggledAsync(Guid articleId, Guid commentId, int likesCount, Guid userId, bool liked)
        => _notifier.RaiseCommentLikeToggledAsync(articleId, commentId, likesCount, userId, liked);
}






private Task OnCommentStatusChangedAsync(Guid articleId, Guid commentId, int newStatusId)
{
    if (_article is null || articleId != _article.Id) return Task.CompletedTask;

    return InvokeAsync(() =>
    {
        var target = _comments.FirstOrDefault(c => c.Id == commentId)
                     ?? _comments.SelectMany(c => c.Replies).FirstOrDefault(r => r.Id == commentId);

        if (target != null)
        {
            target.StatusId = newStatusId;
        }
        StateHasChanged();
    });
}