public async Task UpdateIncidentContentAsync(Guid incidentId, List<ArticleContentBlock> content, Guid actorUserId)
{
    await using var db = await _dbFactory.CreateDbContextAsync();
    var incident = await db.Incidents.FirstOrDefaultAsync(i => i.Id == incidentId);
    if (incident == null) return;

    var oldText = FlattenContent(incident.Content);
    var newText = FlattenContent(content);

    incident.Content = content;
    incident.UpdatedAt = DateTime.Now;

    var actor = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == actorUserId);
    await LogActivityAsync(db, incident.Id, IncidentActivityType.Editada, actorUserId,
        $"{actor?.FullName ?? "Alguien"} actualizó la descripción detallada.", DateTime.Now,
        oldValue: oldText, newValue: newText);

    await db.SaveChangesAsync();
}

private static string FlattenContent(List<ArticleContentBlock> blocks) =>
    blocks == null || blocks.Count == 0 ? "(vacío)" : string.Join("\n\n", blocks.OrderBy(b => b.Order).Select(b => b.Text ?? ""));







<div class="version-timeline">
    @foreach (var entry in Order(_detail.Activity, a => a.OccurredAt, _activityDesc))
    {
        var color = IncidentCssHelpers.ActivityColor(entry.Type);
        var expanded = _expandedActivityIds.Contains(entry.Id);
        var hasDetail = !string.IsNullOrWhiteSpace(entry.OldValue) || !string.IsNullOrWhiteSpace(entry.NewValue);

        <div class="version-row" style="cursor:@(hasDetail ? "pointer" : "default");" @onclick="() => ToggleActivityExpand(entry.Id)">
            <span class="version-row__dot" style="background:@color;"></span>
            <div style="flex:1; min-width:0;">
                <p class="version-row__label">
                    <span class="version-row__type-icon" style="color:@color;">
                        <Icon Name="@IncidentCssHelpers.ActivityIcon(entry.Type)" Class="version-row__type-icon-svg" />
                    </span>
                    @entry.Description
                    @if (hasDetail)
                    {
                        <Icon Name="@(expanded ? "chevron-up" : "chevron-down")" />
                    }
                </p>
                <p class="version-row__date">@entry.OccurredAt.ToString("d MMM yyyy, HH:mm") · @entry.OccurredAt.ToRelativeLabel()</p>

                @if (expanded && hasDetail)
                {
                    <div style="display:flex; gap:12px; margin-top:8px; flex-wrap:wrap;">
                        @if (!string.IsNullOrWhiteSpace(entry.OldValue))
                        {
                            <div style="flex:1; min-width:200px; background:#fef2f2; border-left:3px solid #ef4444; padding:8px 10px; border-radius:4px; font-size:0.85rem; white-space:pre-wrap;">
                                <strong>Antes</strong><br />@entry.OldValue
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(entry.NewValue))
                        {
                            <div style="flex:1; min-width:200px; background:#f0fdf4; border-left:3px solid #22c55e; padding:8px 10px; border-radius:4px; font-size:0.85rem; white-space:pre-wrap;">
                                <strong>Después</strong><br />@entry.NewValue
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>






private readonly HashSet<Guid> _expandedActivityIds = new();

private void ToggleActivityExpand(Guid entryId)
{
    if (!_expandedActivityIds.Remove(entryId))
        _expandedActivityIds.Add(entryId);
}



