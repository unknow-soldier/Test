using CorpWiki.Domain.Entities.Incidents;
using CorpWiki.Domain.Entities.Security;
using Microsoft.EntityFrameworkCore;

namespace CorpWiki.Infrastructure.Services;

public partial class IncidentService : IIncidentService
{
    // Ya existe en tu clase:
    // private readonly DaviWikiDbContext _db;

    // Nuevo: inyectar ISecurityService para reutilizar AssignAreaAsync
    // (ya hace user.AreaId = areaId + LogAuditAsync "ASSIGN_AREA").
    // Si tu constructor actual es:
    //   public IncidentService(DaviWikiDbContext db) { _db = db; }
    // cámbialo a:
    //   public IncidentService(DaviWikiDbContext db, ISecurityService securityService)
    //   {
    //       _db = db;
    //       _securityService = securityService;
    //   }
    private readonly ISecurityService _securityService;

    // =====================================================================
    // Áreas — CRUD
    // =====================================================================

    public async Task<Area> CreateAreaAsync(string name, string color, string icon = "layers-3")
    {
        if (string.IsNullOrWhiteSpace(name))
            throw new ArgumentException("El nombre del área es obligatorio.", nameof(name));

        var nombreNormalizado = name.Trim();

        var yaExiste = await _db.Areas
            .AnyAsync(a => a.Name.ToLower() == nombreNormalizado.ToLower());

        if (yaExiste)
            throw new InvalidOperationException($"Ya existe un área con el nombre '{nombreNormalizado}'.");

        var area = new Area
        {
            Id = Guid.NewGuid(),
            Name = nombreNormalizado,
            Color = string.IsNullOrWhiteSpace(color) ? "#0ea5e9" : color,
            Icon = string.IsNullOrWhiteSpace(icon) ? "layers-3" : icon
        };

        _db.Areas.Add(area);
        await _db.SaveChangesAsync();

        return area;
    }

    public async Task UpdateAreaAsync(Guid areaId, string name, string color, string icon)
    {
        var area = await _db.Areas.FirstOrDefaultAsync(a => a.Id == areaId);
        if (area is null)
            throw new KeyNotFoundException($"No se encontró el área con id '{areaId}'.");

        if (string.IsNullOrWhiteSpace(name))
            throw new ArgumentException("El nombre del área es obligatorio.", nameof(name));

        var nombreNormalizado = name.Trim();

        var nombreEnUso = await _db.Areas
            .AnyAsync(a => a.Id != areaId && a.Name.ToLower() == nombreNormalizado.ToLower());

        if (nombreEnUso)
            throw new InvalidOperationException($"Ya existe otra área con el nombre '{nombreNormalizado}'.");

        area.Name = nombreNormalizado;
        area.Color = string.IsNullOrWhiteSpace(color) ? area.Color : color;
        area.Icon = string.IsNullOrWhiteSpace(icon) ? area.Icon : icon;

        await _db.SaveChangesAsync();
    }

    public async Task DeleteAreaAsync(Guid areaId)
    {
        var area = await _db.Areas.FirstOrDefaultAsync(a => a.Id == areaId);
        if (area is null)
            throw new KeyNotFoundException($"No se encontró el área con id '{areaId}'.");

        var tieneUsuarios = await _db.SecurityUsers.AnyAsync(u => u.AreaId == areaId);
        if (tieneUsuarios)
            throw new InvalidOperationException(
                "No se puede eliminar el área porque tiene usuarios asignados. Reasigna o quita a los participantes primero.");

        // Asumo que el campo se llama CurrentAreaId (por el comentario en Area.cs:
        // "cada Incident tiene un área de origen y un área actual").
        // Si en tu clase Incident el campo tiene otro nombre, solo cámbialo aquí.
        var tieneIncidenciasActivas = await _db.Incidents
            .AnyAsync(i => i.CurrentAreaId == areaId && i.Status != IncidentStatus.Cerrada);

        if (tieneIncidenciasActivas)
            throw new InvalidOperationException(
                "No se puede eliminar el área porque tiene incidencias activas asociadas.");

        _db.Areas.Remove(area);
        await _db.SaveChangesAsync();
    }

    // =====================================================================
    // Áreas — participantes
    // Delega en ISecurityService.AssignAreaAsync para no duplicar la
    // lógica de auditoría (LogAuditAsync "ASSIGN_AREA") que ya existe ahí.
    // =====================================================================

    public async Task AssignUserToAreaAsync(Guid userId, Guid areaId)
    {
        var areaExiste = await _db.Areas.AnyAsync(a => a.Id == areaId);
        if (!areaExiste)
            throw new KeyNotFoundException($"No se encontró el área con id '{areaId}'.");

        var ok = await _securityService.AssignAreaAsync(userId, areaId);
        if (!ok)
            throw new KeyNotFoundException($"No se encontró el usuario con id '{userId}'.");
    }

    public async Task RemoveUserFromAreaAsync(Guid userId)
    {
        var usuario = await _db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == userId);
        if (usuario is null)
            throw new KeyNotFoundException($"No se encontró el usuario con id '{userId}'.");

        usuario.AreaId = null;
        await _db.SaveChangesAsync();

        // Opcional: si quieres que quitar del área también quede auditado,
        // dime y le agregamos un método RemoveAreaAsync espejo en ISecurityService
        // con LogAuditAsync(userId, usuario.Username, "REMOVE_AREA", ...).
    }
}