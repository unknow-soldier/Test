using CorpWiki.Application.DTOs.Incidents;
using CorpWiki.Domain.Entities.Incidents;

namespace CorpWiki.Application.Helpers;

public static class IncidentInsightHelper
{
    public record Insight(string Icon, string Text, string Color);

    public static List<Insight> Build(IncidentDetailDto d, DateTime now)
    {
        var insights = new List<Insight>();
        var isOpen = d.Status != IncidentStatus.Cerrada;

        if (isOpen && d.Status != IncidentStatus.Resuelta)
        {
            var remaining = d.SlaDeadline - now;
            if (remaining.TotalMinutes <= 0)
                insights.Add(new("alarm-clock", $"Venció el límite hace {Span(now - d.SlaDeadline)}", "#ef4444"));
            else if (remaining.TotalHours <= 2)
                insights.Add(new("alarm-clock", $"Vence en {Span(remaining)}", "#f59e0b"));
        }

        if (isOpen && d.Responsibles.Count == 0)
        {
            var lastActivity = d.Activity.OrderByDescending(a => a.OccurredAt).FirstOrDefault();
            var since = lastActivity != null ? now - lastActivity.OccurredAt : TimeSpan.Zero;
            insights.Add(new("user-x", $"Sin responsable desde hace {Span(since)}", "#ef4444"));
        }

        if (d.Transfers.Count >= 3)
            insights.Add(new("arrow-right", $"Reenviada {d.Transfers.Count} veces", "#f59e0b"));

        if (d.ReactivationCount > 0)
            insights.Add(new("rotate-ccw", $"Reactivada {d.ReactivationCount} {(d.ReactivationCount == 1 ? "vez" : "veces")}", "#f59e0b"));

        if (!isOpen && !d.IsOverdue)
        {
            var total = d.TotalActiveHours + d.TotalDeadHours;
            if (total > 0 && d.SlaHours > 0 && total <= d.SlaHours * 0.3)
                insights.Add(new("zap", "Resuelta muy por debajo del tiempo límite", "#22c55e"));
        }

        if (isOpen && d.TotalDeadHours > d.TotalActiveHours && d.TotalDeadHours >= 1)
            insights.Add(new("clock", $"Más tiempo en espera ({Fmt(d.TotalDeadHours)}) que trabajando ({Fmt(d.TotalActiveHours)})", "#f59e0b"));

        return insights;
    }

    private static string Span(TimeSpan span)
    {
        span = span.Duration();
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays}d {span.Hours}h";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h {span.Minutes}min";
        return $"{Math.Max(1, (int)span.TotalMinutes)} min";
    }

    private static string Fmt(double hours) => hours < 1 ? $"{Math.Round(hours * 60)} min" : $"{hours:0.#} h";
}







private System.Threading.Timer? _slaTimer;
private DateTime _clockNow = DateTime.Now;

private void EnsureSlaTimer()
{
    _slaTimer ??= new System.Threading.Timer(async _ =>
    {
        _clockNow = DateTime.Now;
        await InvokeAsync(StateHasChanged);
    }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
}

public void Dispose() => _slaTimer?.Dispose();




@{
    var insights = _detail is not null ? IncidentInsightHelper.Build(_detail, _clockNow) : new();
}
@if (insights.Count > 0)
{
    <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom: var(--space-4);">
        @foreach (var insight in insights)
        {
            <span style="display:inline-flex; align-items:center; gap:6px; padding:6px 12px; border-radius:20px; font-size:0.82rem; font-weight:600; color:@insight.Color; background:@ColorUtils.ToRgba(insight.Color, 0.12); border:1px solid @ColorUtils.ToRgba(insight.Color, 0.3);">
                <Icon Name="@insight.Icon" /> @insight.Text
            </span>
        }
    </div>
}





