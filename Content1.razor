        var fromArea = await db.Areas.FirstOrDefaultAsync(a => a.Id == transfer.FromAreaId);
        var toArea = await db.Areas.FirstOrDefaultAsync(a => a.Id == transfer.ToAreaId);

        return new IncidentTransferDto
        {
            Id = transfer.Id,
            FromUserName = from?.FullName ?? "-",
            ToUserName = to?.FullName ?? "-",
            FromAreaName = fromArea?.Name ?? "-",
            ToAreaName = toArea?.Name ?? "-",
            Reason = transfer.Reason,
            TransferredAt = transfer.TransferredAt
        };
    }

