var existingCreatorPart = db.IncidentParticipants.Local
    .FirstOrDefault(p => p.IncidentId == incident.Id && p.SecurityUserId == createdByUserId);

IncidentParticipant creatorParticipant;
if (existingCreatorPart == null)
{
    creatorParticipant = new IncidentParticipant
    {
        Id = Guid.NewGuid(), 
        IncidentId = incident.Id, 
        SecurityUserId = createdByUserId,
        AreaId = areaId, 
        Role = IncidentParticipantRole.Colaborador, 
        AssignedAt = now
    };
    db.IncidentParticipants.Add(creatorParticipant);
}
else
{
    creatorParticipant = existingCreatorPart;
}

var creator = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == createdByUserId);
await LogActivityAsync(db, incident.Id, IncidentActivityType.Creada, createdByUserId,
    $"{creator?.FullName ?? "Alguien"} creó la incidencia \"{incident.Title}\".", now);

SecurityUser? respUser = null;
var responsibleAssigned = false;

if (initialResponsibleUserId.HasValue)
{
    respUser = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == initialResponsibleUserId.Value);
    if (respUser != null && respUser.AreaId == areaId)
    {
        if (initialResponsibleUserId.Value == createdByUserId)
        {
            creatorParticipant.Role = IncidentParticipantRole.Responsable;
        }
        else
        {
            var existingRespPart = db.IncidentParticipants.Local
                .FirstOrDefault(p => p.IncidentId == incident.Id && p.SecurityUserId == initialResponsibleUserId.Value);

            if (existingRespPart == null)
            {
                db.IncidentParticipants.Add(new IncidentParticipant
                {
                    Id = Guid.NewGuid(), 
                    IncidentId = incident.Id, 
                    SecurityUserId = initialResponsibleUserId.Value,
                    AreaId = areaId, 
                    Role = IncidentParticipantRole.Responsable, 
                    AssignedAt = now
                });
            }
            else
            {
                existingRespPart.Role = IncidentParticipantRole.Responsable;
            }
        }

        responsibleAssigned = true;
        await LogActivityAsync(db, incident.Id, IncidentActivityType.Asignada, createdByUserId,
            $"{respUser.FullName} quedó como responsable al crearse.", now);
    }
}

db.IncidentTimeSegments.Add(new IncidentTimeSegment
{
    Id = Guid.NewGuid(), IncidentId = incident.Id, AreaId = areaId,
    UserId = responsibleAssigned ? initialResponsibleUserId : null,
    StartedAt = now, IsActiveWork = responsibleAssigned
});

await db.SaveChangesAsync();

var area = await db.Areas.FirstOrDefaultAsync(a => a.Id == areaId);
if (respUser != null && responsibleAssigned && respUser.Id != createdByUserId)
    NotifyResponsibleAssigned(incident.Id, incident.Code, incident.Title, area?.Name ?? "-",
        respUser, createdByUserId, creator?.FullName ?? "-", NotificationType.IncidentAssigned);

return incident;
