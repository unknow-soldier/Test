public static class IncidentSlaHelper
{
    public static int SlaHoursFor(IncidentPriority priority) => priority switch
    {
        IncidentPriority.Critica => 4,
        IncidentPriority.Alta => 24,
        IncidentPriority.Media => 72,
        IncidentPriority.Baja => 168,
        _ => 72
    };

    public static DateTime DeadlineFor(IncidentPriority priority, DateTime createdAt) =>
        createdAt.AddHours(SlaHoursFor(priority));

    /// <summary>Usa el momento en que la incidencia DEJÓ de contar tiempo
    /// (se cerró o se resolvió), no "ahora", para que una incidencia ya
    /// finalizada no siga moviéndose en el reloj de SLA.</summary>
    public static bool IsOverdue(IncidentPriority priority, DateTime createdAt, IncidentStatus status, DateTime? resolvedAt, DateTime? closedAt)
    {
        var limit = DeadlineFor(priority, createdAt);
        var reference = status switch
        {
            IncidentStatus.Cerrada => closedAt ?? DateTime.Now,
            IncidentStatus.Resuelta => resolvedAt ?? DateTime.Now,
            _ => DateTime.Now
        };
        return reference > limit;
    }

    /// <summary>Texto en tiempo pasado si ya terminó, presente si sigue corriendo.</summary>
    public static string StatusLabel(IncidentPriority priority, DateTime createdAt, IncidentStatus status, DateTime? resolvedAt, DateTime? closedAt)
    {
        var overdue = IsOverdue(priority, createdAt, status, resolvedAt, closedAt);
        return status switch
        {
            IncidentStatus.Cerrada => overdue ? "Se cerró fuera de SLA" : "Se cerró dentro de SLA",
            IncidentStatus.Resuelta => overdue ? "Se resolvió fuera de SLA" : "Se resolvió dentro de SLA",
            _ => overdue ? "Fuera de SLA" : "Dentro de SLA"
        };
    }

    public static string Tooltip(IncidentPriority priority, DateTime createdAt)
    {
        var hours = SlaHoursFor(priority);
        var dias = hours >= 24 ? $"{hours / 24} días" : $"{hours} horas";
        return $"Por prioridad {IncidentLabels.Priority(priority)}, debía atenderse en {dias} (antes de {DeadlineFor(priority, createdAt):d MMM, HH:mm}).";
    }
}




