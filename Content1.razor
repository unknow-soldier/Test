    private async Task<IncidentTimeSegmentDto> ToSegmentDtoAsync(DaviWikiDbContext db, IncidentTimeSegment segment)
    {
        var area = await db.Areas.FirstOrDefaultAsync(a => a.Id == segment.AreaId);
        var user = segment.UserId.HasValue ? await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == segment.UserId.Value) : null;

        return new IncidentTimeSegmentDto
        {
            AreaName = area?.Name ?? "-",
            UserName = user?.FullName,
            StartedAt = segment.StartedAt,
            EndedAt = segment.EndedAt,
            IsActiveWork = segment.IsActiveWork,
            DurationHours = Math.Round(segment.Duration.TotalHours, 1)
        };
    }
