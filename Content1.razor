public async Task<bool> AddResponsibleAsync(Guid incidentId, Guid userId, Guid actorUserId)
{
    var incident = await GetIncidentByIdAsync(incidentId);
    if (incident == null || incident.Status == IncidentStatus.Cerrada) return false;

    var user = await GetUserByIdAsync(userId);
    if (user == null || user.AreaId != incident.CurrentAreaId) return false;

    var activeResponsibles = await _db.IncidentParticipants
        .Where(p => p.IncidentId == incidentId && p.Role == IncidentParticipantRole.Responsable && p.RemovedAt == null)
        .ToListAsync();

    if (activeResponsibles.Any(p => p.SecurityUserId == userId)) return true;

    var actorIsResponsible = activeResponsibles.Any(p => p.SecurityUserId == actorUserId);
    if (activeResponsibles.Count > 0 && !actorIsResponsible) return false;

    var now = DateTime.Now;

    // FIX: Buscar si el participante ya existe en la base de datos (por ejemplo, con RemovedAt != null)
    var existingParticipant = await _db.IncidentParticipants
        .FirstOrDefaultAsync(p => p.IncidentId == incidentId && p.SecurityUserId == userId);

    if (existingParticipant != null)
    {
        // Si ya existía, lo reactivamos y actualizamos su rol y área
        existingParticipant.Role = IncidentParticipantRole.Responsable;
        existingParticipant.AreaId = incident.CurrentAreaId;
        existingParticipant.AssignedAt = now;
        existingParticipant.RemovedAt = null;
    }
    else
    {
        // Si no existe, agregamos la entidad
        _db.IncidentParticipants.Add(new IncidentParticipant
        {
            Id = Guid.NewGuid(),
            IncidentId = incidentId,
            SecurityUserId = userId,
            AreaId = incident.CurrentAreaId,
            Role = IncidentParticipantRole.Responsable,
            AssignedAt = now
        });
    }

    if (activeResponsibles.Count == 0 && incident.Status != IncidentStatus.Cerrada)
    {
        await CloseTimeSegmentAsync(incidentId, now);
        _db.IncidentTimeSegments.Add(new IncidentTimeSegment
        {
            Id = Guid.NewGuid(),
            IncidentId = incidentId,
            AreaId = incident.CurrentAreaId,
            UserId = userId,
            StartedAt = now,
            IsActiveWork = true
        });
    }

    incident.UpdatedAt = now;

    var actor = await GetUserByIdAsync(actorUserId);
    await LogActivityAsync(incidentId, IncidentActivityType.Asignada, actorUserId,
        $"{actor?.FullName ?? "-"} sumó a {user.FullName} como responsable.", now);

    await _db.SaveChangesAsync();

    var area = await GetAreaByIdAsync(incident.CurrentAreaId);
    NotifyResponsibleAssigned(incidentId, incident.Code, incident.Title, area?.Name ?? "-",
        user, actorUserId, actor?.FullName ?? "-", NotificationType.IncidentAssigned);

    return true;
}
