@code {
    private string GetSlaBadgeStyle(IncidentItem item)
    {
        var color = item.IsOverdue ? "#ef4444" : "#22c55e";
        var background = item.IsOverdue ? "rgba(239,68,68,0.1)" : "rgba(34,197,94,0.1)";
        return $"color:{color}; border:1px solid {color}; background:{background};";
    }
}
