using CorpWiki.Domain.Entities.Incidents;

namespace CorpWiki.Application.Helpers;

public static class IncidentSlaHelper
{
    /// <summary>Solo para sugerir un valor inicial en el wizard; ya NO se usa para evaluar.</summary>
    public static int SuggestedHoursFor(IncidentPriority priority) => priority switch
    {
        IncidentPriority.Critica => 4,
        IncidentPriority.Alta => 24,
        IncidentPriority.Media => 72,
        IncidentPriority.Baja => 168,
        _ => 72
    };

    public static bool IsOverdue(DateTime slaDeadline, IncidentStatus status, DateTime? resolvedAt, DateTime? closedAt)
    {
        var reference = status switch
        {
            IncidentStatus.Cerrada => closedAt ?? DateTime.Now,
            IncidentStatus.Resuelta => resolvedAt ?? DateTime.Now,
            _ => DateTime.Now
        };
        return reference > slaDeadline;
    }

    public static string StatusLabel(DateTime slaDeadline, IncidentStatus status, DateTime? resolvedAt, DateTime? closedAt)
    {
        var overdue = IsOverdue(slaDeadline, status, resolvedAt, closedAt);
        return status switch
        {
            IncidentStatus.Cerrada => overdue ? "Se cerró fuera de SLA" : "Se cerró dentro de SLA",
            IncidentStatus.Resuelta => overdue ? "Se resolvió fuera de SLA" : "Se resolvió dentro de SLA",
            _ => overdue ? "Fuera de SLA" : "Dentro de SLA"
        };
    }

    public static string Tooltip(DateTime createdAt, DateTime slaDeadline)
    {
        var span = slaDeadline - createdAt;
        var label = span.TotalHours >= 24 ? $"{Math.Round(span.TotalHours / 24, 1)} días" : $"{Math.Round(span.TotalHours, 1)} horas";
        return $"Tiempo límite definido al crear la incidencia: {label} (vence {slaDeadline:d MMM, HH:mm}).";
    }
}




