@page "/incidencias/listado"
@rendermode InteractiveServer
@inject IIncidentService Incidents
@using CorpWiki.Web.Components.Shared.Incidents
<PageTitle>DaviWiki - Listado de Incidencias</PageTitle>

<div class="page-header">
    <div>
        <h1>Listado de Incidencias</h1>
        <p>@_filtered.Count() de @_all.Count incidencias.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--primary" href="/incidencias/nueva"><Icon Name="plus" /> Nueva incidencia</a>
    </div>
</div>

<div class="card widget" style="margin-bottom: var(--space-5);">
    <h4 class="widget__title" style="margin-bottom: var(--space-3);"><Icon Name="pie-chart" />Distribución por estado</h4>
    <SegmentedBar Segments="_statusBarSegments" />
    <div class="distribution-legend-row">
        @foreach (var chip in _statusChips)
        {
            <button type="button" class="chip @(_statusFilter == chip.Value ? "chip--active" : "")"
                    @onclick="() => QuickFilterStatus(chip.Value)">
                <span class="donut-legend__dot" style="background:@chip.Color;"></span>@chip.Label (@chip.Count)
            </button>
        }
    </div>
</div>

<div class="incidents-filters-row">
    <div class="explorer-search">
        <Icon Name="search" />
        <input class="explorer-search__input" placeholder="Buscar por código o título..."
               @bind="_search" @bind:event="oninput" />
    </div>

    <select class="input" @bind="_areaFilter">
        <option value="">Todas las áreas</option>
        @foreach (var area in _areas)
        {
            <option value="@area.Name">@area.Name</option>
        }
    </select>

    <select class="input" @bind="_statusFilter">
        <option value="">Todos los estados</option>
        @foreach (var status in Enum.GetValues<IncidentStatus>())
        {
            <option value="@status">@IncidentLabels.Status(status)</option>
        }
    </select>

    <select class="input" @bind="_priorityFilter">
        <option value="">Todas las prioridades</option>
        @foreach (var priority in Enum.GetValues<IncidentPriority>())
        {
            <option value="@priority">@IncidentLabels.Priority(priority)</option>
        }
    </select>

    <button class="chip-incidencias @(_onlyActive ? "chip--active" : "")" @onclick="ToggleOnlyActive">
        Solo activas
    </button>
</div>

@if (!_pageItems.Any())
{
    <div class="empty-state">
        <Icon Name="inbox" />
        <h3>Sin resultados</h3>
        <p>Ningún incidente coincide con los filtros aplicados.</p>
    </div>
}
else
{
    <div class="incident-list">
        @foreach (var item in _pageItems)
        {
            <IncidentListRow Item="item" />
        }
    </div>

    <div class="pagination">
        <button class="pagination__btn pagination__btn--nav" disabled="@(_page == 1)" @onclick="() => GoToPage(_page - 1)">
            <Icon Name="chevron-left" />
        </button>
        @for (var p = 1; p <= _totalPages; p++)
        {
            var pageNumber = p;
            <button class="pagination__btn @(pageNumber == _page ? "pagination__btn--active" : "")"
                    @onclick="() => GoToPage(pageNumber)">
                @pageNumber
            </button>
        }
        <button class="pagination__btn pagination__btn--nav" disabled="@(_page == _totalPages)" @onclick="() => GoToPage(_page + 1)">
            <Icon Name="chevron-right" />
        </button>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "estado")] public string? QueryStatus { get; set; }
    [SupplyParameterFromQuery(Name = "prioridad")] public string? QueryPriority { get; set; }
    [SupplyParameterFromQuery(Name = "area")] public string? QueryArea { get; set; }
    [SupplyParameterFromQuery(Name = "buscar")] public string? QuerySearch { get; set; }

    private const int PageSize = 8;

    private IReadOnlyList<IncidentSummaryDto> _all = new List<IncidentSummaryDto>();
    private IReadOnlyList<Area> _areas = new List<Area>();

    private string _search = string.Empty;
    private string _areaFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private string _priorityFilter = string.Empty;
    private bool _onlyActive;
    private int _page = 1;

    private List<(string Label, double Value, string Color)> _statusBarSegments = new();
    private List<(string Label, string Value, int Count, string Color)> _statusChips = new();

    protected override async Task OnInitializedAsync()
    {
        _statusFilter = QueryStatus ?? string.Empty;
        _priorityFilter = QueryPriority ?? string.Empty;
        _areaFilter = QueryArea ?? string.Empty;
        _search = QuerySearch ?? string.Empty;

        _all = await Incidents.GetIncidentSummariesAsync();
        _areas = await Incidents.GetAreasAsync();

        foreach (var status in Enum.GetValues<IncidentStatus>())
        {
            var count = _all.Count(i => i.Status == status);
            if (count == 0) continue;

            var color = $"var(--status-{IncidentCssHelpers.StatusSuffix(status)})";
            _statusBarSegments.Add((IncidentLabels.Status(status), count, color));
            _statusChips.Add((IncidentLabels.Status(status), status.ToString(), count, color));
        }
    }

    private void QuickFilterStatus(string statusValue)
    {
        _statusFilter = _statusFilter == statusValue ? string.Empty : statusValue;
        _page = 1;
    }

    private IEnumerable<IncidentSummaryDto> _filtered => _all.Where(i =>
        (string.IsNullOrWhiteSpace(_search)
            || i.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || i.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || i.Responsibles.Any(r => r.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        && (string.IsNullOrEmpty(_areaFilter) || i.AreaName == _areaFilter)
        && (string.IsNullOrEmpty(_statusFilter) || i.Status.ToString() == _statusFilter)
        && (string.IsNullOrEmpty(_priorityFilter) || i.Priority.ToString() == _priorityFilter)
        && (!_onlyActive || i.Status != IncidentStatus.Cerrada));

    private int _totalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count() / (double)PageSize));

    private List<IncidentSummaryDto> _pageItems =>
        _filtered.Skip((_page - 1) * PageSize).Take(PageSize).ToList();

    private void ToggleOnlyActive()
    {
        _onlyActive = !_onlyActive;
        _page = 1;
    }

    private void GoToPage(int page)
    {
        _page = Math.Clamp(page, 1, _totalPages);
    }
}






@page "/incidencias/{Id:guid}"
@rendermode InteractiveServer
@inject IIncidentService Incidents
@inject ISecurityService Security
@inject NavigationManager Nav
@inject IToastService Toast
@inject IJSRuntime JSRuntime
@using CorpWiki.Web.Extensions
@using CorpWiki.Web.Components.Shared.Incidents
@using CorpWiki.Web.Components.Shared
@using CorpWiki.Web.Services
@using CorpWiki.Domain.Entities.Security
@using CorpWiki.Application.Helpers
<PageTitle>DaviWiki - @(_detail?.Code ?? "Incidencia")</PageTitle>

@if (_detail is null)
{
    <div class="empty-state">
        <Icon Name="alert-triangle" Class="empty-state__icon" />
        <h2>Incidencia no encontrada</h2>
        <p>Puede que se haya movido o el enlace esté roto.</p>
        <a class="btn btn--primary" href="/incidencias/listado">Ver todas las incidencias</a>
    </div>
}
else
{
    <Breadcrumb Items="_breadcrumb" />

    <div class="page-header">
        <div>
            <span class="incident-detail-code">@_detail.Code</span>
            <h1>@_detail.Title</h1>
            <div style="display:flex; gap:8px; margin-top:10px; flex-wrap:wrap; align-items:center;">
                <IncidentStatusBadge Status="_detail.Status" />
                <IncidentPriorityBadge Priority="_detail.Priority" />
                @if (_detail.ReactivationCount > 0)
                {
                    <span class="badge"><Icon Name="rotate-ccw" />Reactivada x@_detail.ReactivationCount</span>
                }
                @if (_detail.Status != IncidentStatus.Cerrada)
                {
                    <span class="badge badge--outline"><Icon Name="clock" />Abierta hace @((DateTime.Now - _detail.CreatedAt).Days) días</span>
                }
            </div>
        </div>
        <div class="page-header__actions">
            @if (_detail.Status != IncidentStatus.Cerrada)
            {
                <button class="btn btn--danger btn--sm" @onclick="RequestCloseConfirmation">
                    <Icon Name="check-circle" /> Cerrar
                </button>
            }
            else
            {
                <button class="btn btn--secondary btn--sm" @onclick="RequestReactivateConfirmation">
                    <Icon Name="rotate-ccw" /> Reactivar
                </button>
            }
        </div>
    </div>

    <div class="detail-tabs" role="tablist">
        <button class="detail-tabs__item @(_activeTab == "resumen" ? "detail-tabs__item--active" : "")"
                role="tab" aria-selected="@(_activeTab == "resumen")" @onclick='() => SetTab("resumen")'>
            <Icon Name="file-text" /> Resumen
        </button>
        <button class="detail-tabs__item @(_activeTab == "actividad" ? "detail-tabs__item--active" : "")"
                role="tab" aria-selected="@(_activeTab == "actividad")" @onclick='() => SetTab("actividad")'>
            <Icon Name="activity" /> Actividad
            <span class="detail-tabs__count">@(_detail.Activity.Count + _detail.Comments.Count)</span>
        </button>
        <button class="detail-tabs__item @(_activeTab == "gestion" ? "detail-tabs__item--active" : "")"
                role="tab" aria-selected="@(_activeTab == "gestion")" @onclick='() => SetTab("gestion")'>
            <Icon Name="settings" /> Gestión
            @if (_detail.Transfers.Count > 0)
            {
                <span class="detail-tabs__count">@_detail.Transfers.Count</span>
            }
        </button>
    </div>

    @if (_activeTab == "resumen")
    {
        <div class="detail-tabs__panel">
            @if (_journey.Count > 1)
            {
                <div class="card" style="padding: var(--space-5) var(--space-6); margin-bottom: var(--space-6);">
                    <div style="display:flex; align-items:center; justify-content:space-between; gap:var(--space-3); margin-bottom: var(--space-3); flex-wrap:wrap;">
                        <h4 class="widget__title" style="margin-bottom:0;"><Icon Name="workflow" />Recorrido entre áreas</h4>
                        <button class="btn btn--secondary btn--sm" @onclick="() => OpenJourneyModal(0)">
                            <Icon Name="eye" /> Ver recorrido detallado
                        </button>
                    </div>

                    <div class="journey-stepper">
                        @for (var i = 0; i < _journey.Count; i++)
                        {
                            var index = i;
                            var node = _journey[i];

                            <div class="journey-stepper__node journey-stepper__node--interactive @(node.IsCurrent ? "journey-stepper__node--current" : "")"
                                 style="animation-delay: @($"{i * 60}ms");"
                                 @onclick="() => OpenJourneyModal(index)"
                                 title="Ver detalle de @node.AreaName">
                                <span class="journey-stepper__icon" style="background:@node.Color;">
                                    <Icon Name="@node.Icon" Class="journey-stepper__icon-svg" />
                                </span>
                                @node.AreaName
                            </div>
                            @if (i < _journey.Count - 1)
                            {
                                <Icon Name="chevron-right" Class="journey-stepper__arrow" />
                            }
                        }
                    </div>
                    <p class="form-hint" style="margin-top:var(--space-2);">
                        <Icon Name="mouse-pointer-click" /> Hacé clic en un área para ver su historia completa.
                    </p>
                </div>
            }

            @if (_areaTimeSegments.Count > 0)
            {
                <div class="card" style="padding: var(--space-6); margin-bottom: var(--space-6);">
                    <h4 class="widget__title" style="margin-bottom: var(--space-3);"><Icon Name="layers-3" />Tiempo por equipo</h4>
                    <div class="donut-widget__row">
                        <DonutChart Segments="_areaTimeSegments" CenterValue="@_areaTimeSegments.Count.ToString()" CenterLabel="equipos"
                                    OnSegmentClick="OpenAreaModal" ActiveLabel="@_selectedAreaName" />
                        <DonutLegend Items="_areaTimeLegend" OnItemClick="OpenAreaModal" ActiveLabel="@_selectedAreaName" />
                    </div>
                </div>
            }

            <div class="card" style="padding: var(--space-6); margin-bottom: var(--space-6);
                                    border-top: 3px solid var(--priority-@IncidentCssHelpers.PrioritySuffix(_detail.Priority));
                                    @(_detail.Priority == IncidentPriority.Critica ? "box-shadow: var(--shadow-glow);" : "")">
                <div class="incident-meta-grid">
                    <div class="incident-meta-grid__item">
                        <span class="incident-meta-grid__label"><Icon Name="layers-3" />Área de origen</span>
                        <span class="incident-meta-grid__value"><AreaBadge Name="@_detail.OriginAreaName" Color="@_detail.OriginAreaColor" ShowIcon="false" Small="true" /></span>
                    </div>
                    <div class="incident-meta-grid__item">
                        <span class="incident-meta-grid__label"><Icon Name="arrow-right" />Área actual</span>
                        <span class="incident-meta-grid__value"><AreaBadge Name="@_detail.CurrentAreaName" Color="@_detail.CurrentAreaColor" ShowIcon="false" Small="true" /></span>
                    </div>
                    <div class="incident-meta-grid__item">
                        <span class="incident-meta-grid__label"><Icon Name="plus-circle" />Reportado por</span>
                        <span class="incident-meta-grid__value">
                            <UserAvatar FullName="@_detail.CreatedByName" Initials="@_detail.CreatedByInitials"
                                        ColorFrom="@_detail.CreatedByAvatarColorFrom" ColorTo="@_detail.CreatedByAvatarColorTo" Size="UserAvatar.AvatarSize.Sm" />
                            @_detail.CreatedByName
                        </span>
                    </div>
                    <div class="incident-meta-grid__item">
                        <span class="incident-meta-grid__label"><Icon Name="user-check" />Responsables</span>
                        <span class="incident-meta-grid__value">
                            @if (_detail.Responsibles.Count == 0)
                            {
                                <span>Sin asignar</span>
                            }
                            else
                            {
                                <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
                                    @foreach (var r in _detail.Responsibles)
                                    {
                                        <UserAvatar FullName="@r.FullName" Initials="@r.Initials"
                                                    ColorFrom="@r.AvatarColorFrom" ColorTo="@r.AvatarColorTo" Size="UserAvatar.AvatarSize.Sm" />
                                    }
                                    <span>@string.Join(", ", _detail.Responsibles.Select(r => r.FullName))</span>
                                </div>
                            }
                        </span>
                    </div>
                    <div class="incident-meta-grid__item">
                        <span class="incident-meta-grid__label"><Icon Name="clock" />Creada</span>
                        <span class="incident-meta-grid__value">@_detail.CreatedAt.ToString("d MMM yyyy, HH:mm")</span>
                    </div>
                    <div class="incident-meta-grid__item">
                        <span class="incident-meta-grid__label"><Icon Name="refresh-cw" />Actualizada</span>
                        <span class="incident-meta-grid__value">@_detail.UpdatedAt.ToRelativeLabel()</span>
                    </div>
                    @if (_detail.ClosedAt.HasValue)
                    {
                        <div class="incident-meta-grid__item">
                            <span class="incident-meta-grid__label"><Icon Name="check-circle" />Cerrada</span>
                            <span class="incident-meta-grid__value">@_detail.ClosedAt.Value.ToString("d MMM yyyy, HH:mm")</span>
                        </div>
                    }
                </div>

                <div class="time-summary">
                    <DonutChart Segments="_timeSegmentsChart" Size="120" Thickness="16"
                                CenterValue="@($"{_detail.TotalHours:0.#}h")" CenterLabel="total" />
                    <div style="flex:1; min-width:220px;">
                        <IncidentTimeBar ActiveHours="_detail.TotalActiveHours" DeadHours="_detail.TotalDeadHours" />
                    </div>
                </div>
            </div>

            <div class="card" style="padding: var(--space-6); margin-bottom: var(--space-6);">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: var(--space-3);">
                    <h4 class="widget__title"><Icon Name="file-text" />Descripción</h4>
                    @if (!_editingContent)
                    {
                        <button class="btn btn--secondary btn--sm" @onclick="StartEditContent">
                            <Icon Name="pencil" /> Editar
                        </button>
                    }
                </div>

                @if (_editingContent)
                {
                    <Editra @bind-Blocks="_contentDraft" />
                    <div class="form-actions" style="margin-top: var(--space-3);">
                        <button class="btn btn--secondary btn--sm" @onclick="CancelEditContent">Cancelar</button>
                        <button class="btn btn--primary btn--sm" @onclick="SaveContent">
                            <Icon Name="check-circle" /> Guardar
                        </button>
                    </div>
                }
                else if (_detail.Content is { Count: > 0 })
                {
                    <p>@_detail.Description</p>
                    <ArticleBody Blocks="_detail.Content" />
                }
                else
                {
                    <p>@_detail.Description</p>
                }
            </div>

            @if (_detail.Attachments.Count > 0 || _detail.RelatedArticles.Count > 0)
            {
                <div class="info-grid">
                    @if (_detail.Attachments.Count > 0)
                    {
                        <div class="widget card">
                            <h4 class="widget__title"><Icon Name="paperclip" />Adjuntos</h4>
                            @foreach (var file in _detail.Attachments)
                            {
                                <div class="file-row" style="margin-bottom: var(--space-2);">
                                    <span class="file-row__icon"><Icon Name="file-text" /></span>
                                    <span class="file-row__info">
                                        <span class="file-row__name">@file.FileName</span>
                                        <span class="file-row__meta">@file.FileType · @file.SizeLabel</span>
                                    </span>
                                </div>
                            }
                        </div>
                    }

                    @if (_detail.RelatedArticles.Count > 0)
                    {
                        <div class="widget card">
                            <h4 class="widget__title"><Icon Name="file-text" />Artículos relacionados</h4>
                            @foreach (var article in _detail.RelatedArticles)
                            {
                                <a class="external-link-row" style="margin-bottom: var(--space-2);" href="@($"/articulos/{article.Slug}")">
                                    <Icon Name="file-text" /> @article.Title
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (_activeTab == "actividad")
    {
        <div class="detail-tabs__panel">
            <section class="section">
                <h3>Historial (@_detail.Activity.Count)</h3>
                <div class="card widget">
                    <div class="version-timeline">
                        @foreach (var entry in _detail.Activity.OrderByDescending(a => a.OccurredAt))
                        {
                            var color = IncidentCssHelpers.ActivityColor(entry.Type);
                            <div class="version-row">
                                <span class="version-row__dot" style="background:@color;"></span>
                                <div>
                                    <p class="version-row__label">
                                        <span class="version-row__type-icon" style="color:@color;">
                                            <Icon Name="@IncidentCssHelpers.ActivityIcon(entry.Type)" Class="version-row__type-icon-svg" />
                                        </span>
                                        @entry.ActorName
                                    </p>
                                    <p class="version-row__summary">@entry.Description</p>
                                    <p class="version-row__date">@entry.OccurredAt.ToRelativeLabel()</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>

            <section class="section" style="margin-top: var(--space-6);">
                <h3>Comentarios (@_detail.Comments.Count)</h3>
                <div class="card" style="padding: var(--space-5);">
                    <div class="comment-composer">
                        <textarea class="input" rows="2" placeholder="Escribí un comentario..." @bind="_newComment"></textarea>
                        <button class="btn btn--primary btn--sm" @onclick="AddCommentAction">Comentar</button>
                    </div>
                    <div class="comments-list">
                        @foreach (var c in _detail.Comments.OrderByDescending(c => c.CreatedAt))
                        {
                            <div class="comment-card">
                                <span class="avatar avatar--sm">@c.AuthorInitials</span>
                                <div class="comment-card__body">
                                    <div class="comment-card__head">
                                        <span class="comment-card__author">@c.AuthorName</span>
                                        <span class="comment-card__date">@c.CreatedAt.ToRelativeLabel()</span>
                                    </div>
                                    <p class="comment-card__text">@c.Text</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    }

    @if (_activeTab == "gestion")
    {
        <div class="detail-tabs__panel">
            <div class="management-grid">

                <div class="card widget">
                    <h4 class="widget__title"><Icon Name="users" />Equipo responsable actual</h4>
                    @if (_detail.Responsibles.Count == 0)
                    {
                        <p class="section-header__subtitle">Nadie tiene esta incidencia asignada en este momento.</p>
                    }
                    else
                    {
                        @foreach (var r in _detail.Responsibles)
                        {
                            <div class="activity-row">
                                <UserAvatar FullName="@r.FullName" Initials="@r.Initials"
                                            ColorFrom="@r.AvatarColorFrom" ColorTo="@r.AvatarColorTo" Size="UserAvatar.AvatarSize.Sm" />
                                <div style="flex:1; min-width:0;">
                                    <p class="activity-row__text"><strong>@r.FullName</strong></p>
                                    <p class="activity-row__time">@r.AreaName</p>
                                </div>
                            </div>
                        }
                    }

                    @if (IsCurrentUserResponsible)
                    {
                        <button class="btn btn--secondary btn--sm" style="margin-top: var(--space-3);" @onclick="RequestSelfRemoveConfirmation">
                            <Icon Name="user-x" /> Desresponsabilizarme
                        </button>
                    }
                </div>

                @if (_detail.Status != IncidentStatus.Cerrada && (_detail.Responsibles.Count == 0 || IsCurrentUserResponsible))
                {
                    <div class="card widget">
                        <h4 class="widget__title"><Icon Name="user-check" />Sumar responsable de mi equipo</h4>
                        <p class="form-hint">Solo personas de @_detail.CurrentAreaName.</p>
                        <div class="form-group">
                            <select class="input" @bind="_addResponsibleUserId">
                                <option value="">Seleccioná un compañero</option>
                                @foreach (var u in _currentAreaUsers.Where(u => !_detail.Responsibles.Any(r => r.Id == u.Id)))
                                {
                                    <option value="@u.Id">@u.FullName - @u.Position</option>
                                }
                            </select>
                        </div>
                        <button class="btn btn--secondary btn--sm" @onclick="AddResponsibleAction" disabled="@(!_addResponsibleUserId.HasValue)">
                            Agregar
                        </button>
                    </div>
                }

                <div class="card widget">
                    <h4 class="widget__title"><Icon Name="refresh-cw" />Cambiar estado</h4>
                    <div class="form-group">
                        <select class="input" @bind="_newStatus">
                            @foreach (var s in Enum.GetValues<IncidentStatus>())
                            {
                                <option value="@s">@IncidentLabels.Status(s)</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn--secondary btn--sm" @onclick="ChangeStatusAction">Actualizar estado</button>
                </div>

                @if (IsCurrentUserResponsible)
                {
                    <div class="card widget" style="margin-bottom: var(--space-5);">
                        <h4 class="widget__title"><Icon Name="arrow-right" />Reenviar a otra área</h4>
                        <p class="form-hint">Al reenviar, todo tu equipo actual deja de ser responsable.</p>
                        <div class="form-group">
                            <select class="input" value="@(_delegateAreaId?.ToString() ?? "")" @onchange="OnDelegateAreaChanged">
                                <option value="">Área destino</option>
                                @foreach (var area in _areas.Where(a => a.Id != _detail.CurrentAreaId))
                                {
                                    <option value="@area.Id">@area.Name</option>
                                }
                            </select>
                        </div>

                        @if (_delegateAreaId.HasValue)
                        {
                            <div class="form-group">
                                <label class="form-label">Nuevo(s) responsable(s)</label>
                                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                    @foreach (var u in _delegateAreaUsers)
                                    {
                                        var uid = u.Id;
                                        <button type="button" class="chip @(_delegateUserIds.Contains(uid) ? "chip--active" : "")"
                                                @onclick="() => ToggleDelegateUser(uid)">
                                            @u.FullName
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        <div class="form-group">
                            <textarea class="input" rows="2" placeholder="Motivo del reenvío" @bind="_delegateReason"></textarea>
                        </div>

                        <button class="btn btn--secondary btn--sm" @onclick="DelegateAction"
                                disabled="@(!_delegateAreaId.HasValue || _delegateUserIds.Count == 0)">
                            Reenviar
                        </button>
                    </div>
