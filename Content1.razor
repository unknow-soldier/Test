// --- Utilidad de línea de comandos para cifrar cadenas de conexión ---
// Uso: dotnet run -- encrypt "Data Source=...;Initial Catalog=...;User Id=...;Password=...;"
if (args.Length == 2 && args[0].Equals("encrypt", StringComparison.OrdinalIgnoreCase))
{
    var tempConfig = new ConfigurationBuilder()
        .SetBasePath(Directory.GetCurrentDirectory())
        .AddJsonFile("appsettings.json", optional: true)
        .AddEnvironmentVariables()
        .Build();

    var encrypted = CorpWiki.Infrastructure.Security.ConnectionStringProtector.Protect(args[1], tempConfig);

    Console.WriteLine();
    Console.WriteLine("Pega esto en appsettings.json:");
    Console.WriteLine(encrypted);
    Console.WriteLine();
    return;
}




