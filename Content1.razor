        using (var aes = new AesGcm(key, 16)) { aes.Encrypt(nonce, plainBytes, cipherBytes, tag); }
        byte[] res = new byte[28 + cipherBytes.Length];
        Buffer.BlockCopy(nonce, 0, res, 0, 12); Buffer.BlockCopy(tag, 0, res, 12, 16); Buffer.BlockCopy(cipherBytes, 0, res, 28, cipherBytes.Length);
        return "ENC(" + Convert.ToBase64String(res) + ")";
    }
}
