    private async Task<List<Guid>> GetAccessibleIncidentIdsAsync(DaviWikiDbContext db, Guid userId)
    {
        return await db.IncidentParticipants
            .Where(p => p.SecurityUserId == userId && p.Role == IncidentParticipantRole.Responsable)
