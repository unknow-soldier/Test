public async Task<bool> DeleteArticleAsync(Guid articleId)
{
    var authorId = await _securityService.GetCurrentAuthorIdAsync();
    var isAdmin = await _securityService.IsAdminAsync();

    await using var db = await _dbFactory.CreateDbContextAsync();
    var strategy = db.Database.CreateExecutionStrategy();

    return await strategy.ExecuteAsync(async () =>
    {
        var article = await db.Articles.AsNoTracking().FirstOrDefaultAsync(a => a.Id == articleId);
        if (article is null) return false;
        if (article.AuthorId != authorId && !isAdmin) return false;

        await using var transaction = await db.Database.BeginTransactionAsync();
        try
        {
            await db.Database.ExecuteSqlInterpolatedAsync(
                $"DELETE FROM [dbo].[article_attachments] WHERE [ArticleId] = {articleId}");

            await db.Database.ExecuteSqlInterpolatedAsync(
                $"DELETE FROM [dbo].[article_content_blocks] WHERE [ArticleId] = {articleId}");

            await db.Database.ExecuteSqlInterpolatedAsync(
                $"DELETE FROM [dbo].[article_related] WHERE [ArticleId] = {articleId} OR [RelatedArticleId] = {articleId}");

            await db.Database.ExecuteSqlInterpolatedAsync(
                $"DELETE FROM [dbo].[article_tags] WHERE [ArticleId] = {articleId}");

            await db.Database.ExecuteSqlInterpolatedAsync(
                $"DELETE FROM [dbo].[article_versions] WHERE [ArticleId] = {articleId}");

            await db.Database.ExecuteSqlInterpolatedAsync(
                $"DELETE FROM [dbo].[collection_articles] WHERE [ArticleId] = {articleId}");

            await db.Database.ExecuteSqlInterpolatedAsync(
                $"DELETE FROM [dbo].[article_comments] WHERE [ArticleId] = {articleId}");

            await db.Database.ExecuteSqlInterpolatedAsync(
                $"DELETE FROM [dbo].[article_favorites] WHERE [ArticleId] = {articleId}");

            await db.Database.ExecuteSqlInterpolatedAsync(
                $"DELETE FROM [dbo].[article_history] WHERE [ArticleId] = {articleId}");

            await db.Database.ExecuteSqlInterpolatedAsync(
                $"DELETE FROM [dbo].[article_ratings] WHERE [ArticleId] = {articleId}");

            await db.Database.ExecuteSqlInterpolatedAsync(
                $"DELETE FROM [dbo].[articles] WHERE [Id] = {articleId}");

            await transaction.CommitAsync();
            return true;
        }
        catch
        {
            await transaction.RollbackAsync();
            throw;
        }
    });
}








private DraftViewModel? _deleteTarget;
private bool _deleting;

private void OpenDeleteModal(DraftViewModel draft) => _deleteTarget = draft;
private void CloseDeleteModal() => _deleteTarget = null;

private async Task ConfirmDelete()
{
    if (_deleteTarget is null) return;

    _deleting = true;
    StateHasChanged();

    var ok = await Articles.DeleteArticleAsync(_deleteTarget.Id);

    _deleting = false;
    _deleteTarget = null;

    if (!ok)
    {
        Toast.Show("No se pudo eliminar el artículo.", ToastVariant.Danger, "alert-triangle");
        return;
    }

    Toast.Show("Borrador eliminado.", ToastVariant.Success, "trash-2");
    await ReloadAsync();
}






@if (_deleteTarget is not null)
{
    <div class="modal-overlay" @onclick="CloseDeleteModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-card__icon modal-card__icon--danger">
                <Icon Name="alert-triangle" />
            </div>
            <h3>¿Eliminar este borrador?</h3>
            <p>"@_deleteTarget.Title" se eliminará permanentemente, junto con su contenido, etiquetas y portada. Esta acción no se puede deshacer.</p>
            <div class="modal-card__actions">
                <button type="button" class="btn btn--secondary" @onclick="CloseDeleteModal">Cancelar</button>
                <button type="button" class="btn btn--danger" disabled="@_deleting" @onclick="ConfirmDelete">
                    @if (_deleting) { <span class="spinner"></span> } else { <Icon Name="trash-2" /> }
                    Sí, eliminar
                </button>
            </div>
        </div>
    </div>
}


.modal-card__icon--danger { background: rgba(220,38,38,.12); color: #dc2626; }
.btn--danger { background: #dc2626; color: #fff; border: none; }
.btn--danger:hover { background: #b91c1c; }