@page "/articulos/editar/{ArticleId:guid}"

@inject IArticleDataService Data
@inject ICategoryDataService Categories
@inject ITagDataService Tags
@inject IMediaFileDataService Media
@inject IToastService Toast
@inject NavigationManager Nav
@using CorpWiki.Web.Helpers

<PageTitle>DaviWiki - Editar Artículo</PageTitle>

@if (_notFound)
{
    <div class="empty-state">
        <Icon Name="file-text" Class="empty-state__icon" />
        <h3>No encontramos este artículo</h3>
        <a class="btn btn--primary" href="/articulos">Volver a Artículos</a>
    </div>
}
else if (!_canEdit)
{
    <div class="empty-state">
        <Icon Name="shield-off" Class="empty-state__icon" />
        <h3>No podés editar este artículo</h3>
        <p>Solo el autor original o un administrador de contenido pueden modificarlo.</p>
        <a class="btn btn--primary" href="/articulos">Volver a Artículos</a>
    </div>
}
else
{
    <Breadcrumb Items="_breadcrumb" />

    <div class="page-header">
        <div>
            <h1>Editar Artículo</h1>
            <p class="page-header__status-line">
                Estás editando "@_original?.Title"
                <span class="badge @ArticleStatusPresenter.BadgeClass(_original!.Status)">
                    <Icon Name="@ArticleStatusPresenter.Icon(_original.Status)" />
                    @ArticleStatusPresenter.Label(_original.Status)
                </span>
            </p>
        </div>
        <div class="page-header__actions">
            <a class="btn btn--secondary" href="@($"/articulo/{_original?.Slug}")">
                <Icon Name="external-link" /> Ver artículo
            </a>
        </div>
    </div>

    @if (_original.Status == ArticleStatus.InReview && !string.IsNullOrWhiteSpace(_original.ReviewReason))
    {
        <div class="callout callout--warning">
            <Icon Name="message-circle" />
            <div>
                <p class="callout__title">Motivo de la revisión</p>
                <p>"@_original.ReviewReason"</p>
            </div>
        </div>
    }

    <div class="two-col-grid">
        <div class="card article-form">
            <EditForm Model="_model">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label class="form-label" for="art-title">Título <span class="form-required">*</span></label>
                    <InputText id="art-title" class="input" @bind-Value="_model.Title" />
                    <ValidationMessage For="() => _model.Title" class="form-hint form-hint--error" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="art-summary">Resumen <span class="form-required">*</span></label>
                    <InputTextArea id="art-summary" class="input" rows="3" @bind-Value="_model.Summary" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="art-category">Categoría <span class="form-required">*</span></label>
                        <select id="art-category" class="input" @bind="_model.CategoryId">
                            @foreach (var category in _categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Etiquetas</label>
                    <div class="tag-cloud">
                        @foreach (var tag in _tags)
                        {
                            var active = _model.TagIds.Contains(tag.Id);
                            <button type="button" class="@(active ? "chip chip--active" : "chip")" @onclick="() => ToggleTag(tag.Id)">
                                @tag.Name
                            </button>
                        }
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="art-cover">Portada</label>
                        <InputFile id="art-cover" class="input" accept="image/*" OnChange="OnCoverSelected" />
                        @if (_uploadingCover)
                        {
                            <span class="hint"><span class="spinner"></span> Subiendo imagen...</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_coverPreviewUrl))
                        {
                            <img src="@_coverPreviewUrl" alt="Vista previa de portada" class="cover-preview" />
                        }
                    </div>
                </div>

                <label class="checkbox-row">
                    <input type="checkbox" @bind="_model.IsFeatured" />
                    <span>Marcar como artículo destacado</span>
                </label>

                <div class="form-group">
                    <label class="form-label">Contenido</label>
                    <Editra @bind-Blocks="_model.Content" />
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="callout callout--danger">
                        <Icon Name="alert-triangle" />
                        <p>@_error</p>
                    </div>
                }

                <div class="form-actions">
                    <a class="btn btn--secondary" href="/articulos">Cancelar</a>

                    @if (_original.Status == ArticleStatus.Draft)
                    {
                        <button type="button" class="btn btn--ghost" @onclick="() => Save(ArticleStatus.Draft)">
                            <Icon Name="save" /> Guardar como borrador
                        </button>
                        <button type="button" class="btn btn--outline" @onclick="OpenReviewModal">
                            <Icon Name="help-circle" /> Enviar a revisión
                        </button>
                        <button type="button" class="btn btn--primary" @onclick="() => Save(ArticleStatus.Published)">
                            <Icon Name="check-circle" /> Publicar
                        </button>
                    }
                    else if (_original.Status == ArticleStatus.InReview)
                    {
                        <button type="button" class="btn btn--ghost" @onclick="() => Save(ArticleStatus.InReview)">
                            <Icon Name="save" /> Guardar cambios
                        </button>

                        @if (_isAdmin)
                        {
                            <button type="button" class="btn btn--outline btn--danger" @onclick="Reject">
                                <Icon Name="corner-up-left" /> Devolver a borrador
                            </button>
                            <button type="button" class="btn btn--success" @onclick="Approve">
                                <Icon Name="check-circle" /> Aprobar y publicar
                            </button>
                        }
                        else
                        {
                            <span class="form-hint form-hint--waiting"><Icon Name="clock" /> Esperando aprobación de un administrador.</span>
                        }
                    }
                    else
                    {
                        <button type="button" class="btn btn--primary" @onclick="() => Save(ArticleStatus.Published)">
                            <Icon Name="check-circle" /> Guardar cambios
                        </button>
                    }
                </div>
            </EditForm>
        </div>

        <aside>
            <div class="widget card">
                <h6 class="widget__title"><Icon Name="history" /> Historial de versiones</h6>
                <div class="version-timeline">
                    @foreach (var version in (_original?.Versions ?? new()).OrderByDescending(v => v.EditedAt))
                    {
                        <div class="version-row">
                            <span class="version-row__dot"></span>
                            <div>
                                <p class="version-row__label">@version.VersionLabel</p>
                                <p class="version-row__summary">@version.ChangeSummary</p>
                                <p class="version-row__date">@version.EditedAt.ToString("d MMM yyyy, HH:mm")</p>
                            </div>
                        </div>
                    }
                    @if (_original?.Versions is null || _original.Versions.Count == 0)
                    {
                        <p class="form-hint">Sin historial de versiones todavía.</p>
                    }
                </div>
            </div>
        </aside>
    </div>

    @if (_showReviewModal)
    {
        <div class="modal-overlay" @onclick="CloseReviewModal">
            <div class="modal-card" @onclick:stopPropagation="true">
                <div class="modal-card__icon modal-card__icon--warning">
                    <Icon Name="help-circle" />
                </div>
                <h3>Enviar a revisión</h3>
                <p>Contále a un administrador por qué considerás que este artículo necesita revisión antes de publicarse (por ejemplo, si podría contener información sensible o confidencial).</p>
                <textarea class="input" rows="3" placeholder="Ej: No estoy seguro si este procedimiento es apto para difusión pública..."
                          @bind="_reviewReason" @bind:event="oninput"></textarea>
                <div class="modal-card__actions">
                    <button type="button" class="btn btn--secondary" @onclick="CloseReviewModal">Cancelar</button>
                    <button type="button" class="btn btn--primary" disabled="@(string.IsNullOrWhiteSpace(_reviewReason) || _sendingReview)"
                            @onclick="ConfirmSendToReview">
                        @if (_sendingReview) { <span class="spinner"></span> } else { <Icon Name="send" /> }
                        Enviar a revisión
                    </button>
                </div>
            </div>
        </div>
    }
}








using CorpWiki.Application.Common.Models;
using CorpWiki.Application.Interfaces;
using CorpWiki.Application.UseCases.Files;
using CorpWiki.Domain.Entities;
using CorpWiki.Domain.Enums;
using CorpWiki.Web.Security;
using CorpWiki.Web.Services;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Components;
using Microsoft.AspNetCore.Components.Authorization;
using Microsoft.AspNetCore.Components.Forms;
using Microsoft.Extensions.Logging;

namespace CorpWiki.Web.Components.Pages
{
    public partial class EditarArticulo
    {
        [Parameter] public Guid ArticleId { get; set; }

        [Inject] private UploadFileUseCase UploadFile { get; set; } = default!;
        [Inject] private IFileStorageService Storage { get; set; } = default!;
        [Inject] private ICurrentUserService CurrentUser { get; set; } = default!;
        [Inject] private ISecurityService SecurityService { get; set; } = default!;
        [Inject] private ILogger<EditarArticulo> Logger { get; set; } = default!;
        [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
        [Inject] private IAuthorizationService AuthorizationService { get; set; } = default!;

        private Article? _original;
        private bool _notFound;
        private bool _canEdit;
        private bool _isAdmin;

        private List<Category> _categories = new();
        private List<Tag> _tags = new();
        private List<BreadcrumbItem> _breadcrumb = new();

        private readonly EditArticleModel _model = new();
        private string? _error;

        private bool _uploadingCover;
        private string? _coverPreviewUrl;

        private bool _showReviewModal;
        private string _reviewReason = "";
        private bool _sendingReview;

        protected override async Task OnInitializedAsync()
        {
            _original = await Data.GetArticleByIdAsync(ArticleId);
            if (_original is null)
            {
                _notFound = true;
                return;
            }

            _canEdit = await CheckOwnershipAsync();
            if (!_canEdit) return;

            _isAdmin = await SecurityService.IsAdminAsync();

            _categories = (await Categories.GetCategoriesAsync()).OrderBy(c => c.Name).ToList();
            _tags = (await Tags.GetPopularTagsAsync(40)).OrderBy(t => t.Name).ToList();

            _breadcrumb = new()
            {
                new("Inicio", "/"),
                new("Artículos", "/articulos"),
                new(_original.Title, null)
            };

            _model.Title = _original.Title;
            _model.Summary = _original.Summary;
            _model.CategoryId = _original.CategoryId;
            _model.AuthorId = _original.AuthorId;
            _model.TagIds = new List<Guid>(_original.TagIds);
            _model.CoverImageMediaId = _original.CoverImageMediaId;
            _model.IsFeatured = _original.IsFeatured;

            if (_original.CoverImageMediaId is Guid mediaId)
            {
                var media = await Media.GetMediaFileAsync(mediaId);
                if (media is not null) _coverPreviewUrl = Storage.GetPublicUrl(media.StorageUrl);
            }

            _model.Content = _original.Content
                .OrderBy(b => b.Order)
                .Select(b => new ArticleContentBlock
                {
                    Id = b.Id,
                    Type = b.Type,
                    Order = b.Order,
                    Text = b.Text,
                    Meta = b.Meta,
                    Urls = new List<string>(b.Urls),
                    TableRows = b.TableRows.Select(r => new List<string>(r)).ToList()
                }).ToList();
        }

        private async Task<bool> CheckOwnershipAsync()
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var result = await AuthorizationService.AuthorizeAsync(authState.User, _original!, "MustBeArticleOwner");
            return result.Succeeded;
        }

        private async Task OnCoverSelected(InputFileChangeEventArgs e)
        {
            var file = e.File;
            if (file is null) return;

            _uploadingCover = true;
            StateHasChanged();

            try
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
                var request = new FileUploadRequest
                {
                    Content = stream,
                    FileName = file.Name,
                    ContentType = file.ContentType,
                    SizeInBytes = file.Size,
                    Category = FileCategory.ArticleCover
                };

                var uploadResult = await UploadFile.ExecuteAsync(request);
                if (!uploadResult.IsSuccess)
                {
                    _error = uploadResult.ErrorMessage;
                    return;
                }

                var mediaFile = new MediaFile
                {
                    Id = Guid.NewGuid(),
                    FileName = file.Name,
                    Type = MediaType.Image,
                    StorageUrl = uploadResult.Key!,
                    SizeInBytes = file.Size,
                    AuthorId = _model.AuthorId,
                    UploadedAt = DateTime.UtcNow
                };

                var createdMedia = await Media.CreateMediaFileAsync(mediaFile);
                _model.CoverImageMediaId = createdMedia.Id;
                _coverPreviewUrl = Storage.GetPublicUrl(createdMedia.StorageUrl);
            }
            finally
            {
                _uploadingCover = false;
                StateHasChanged();
            }
        }

        private void ToggleTag(Guid tagId)
        {
            if (!_model.TagIds.Remove(tagId))
            {
                _model.TagIds.Add(tagId);
            }
        }

        private void OpenReviewModal()
        {
            _reviewReason = "";
            _showReviewModal = true;
        }

        private void CloseReviewModal() => _showReviewModal = false;

        private async Task ConfirmSendToReview()
        {
            if (string.IsNullOrWhiteSpace(_reviewReason)) return;

            _sendingReview = true;
            StateHasChanged();

            await Save(ArticleStatus.InReview, _reviewReason);

            _sendingReview = false;
            _showReviewModal = false;
        }

        private async Task Save(ArticleStatus status, string? reviewReason = null)
        {
            _error = null;

            if (string.IsNullOrWhiteSpace(_model.Title) || string.IsNullOrWhiteSpace(_model.Summary))
            {
                _error = "El título y el resumen son obligatorios.";
                return;
            }

            if (!await CheckOwnershipAsync())
            {
                _error = "Ya no tenés permiso para editar este artículo.";

                await SecurityService.LogAuditAsync(
                    CurrentUser.UserId == Guid.Empty ? null : CurrentUser.UserId,
                    CurrentUser.Username,
                    "PERMISSION_DENIED",
                    $"Intento de editar artículo {ArticleId} sin ser autor ni admin.");

                Logger.LogWarning("Edición bloqueada: {Username} intentó modificar artículo {ArticleId}.",
                    CurrentUser.Username, ArticleId);

                return;
            }

            var updated = await Data.UpdateArticleAsync(
                ArticleId,
                _model.Title,
                _model.Summary,
                _model.CategoryId,
                _model.AuthorId,
                _model.CoverImageMediaId,
                _model.IsFeatured,
                status,
                _model.Content,
                _model.TagIds,
                reviewReason: reviewReason);

            if (updated is null)
            {
                _error = "No se pudo guardar: el artículo ya no existe o no tenés permiso.";
                return;
            }

            Toast.Show(ToastMessageFor(status), ToastVariant.Success, "user-check");
            Nav.NavigateTo(status == ArticleStatus.Published ? $"/articulo/{updated.Slug}" : "/perfil");
        }

        private async Task Approve()
        {
            var updated = await Data.ApproveArticleAsync(ArticleId);
            if (updated is null) { _error = "No se pudo aprobar el artículo."; return; }

            Toast.Show("Artículo aprobado y publicado.", ToastVariant.Success, "check-circle");
            Nav.NavigateTo($"/articulo/{updated.Slug}");
        }

        private async Task Reject()
        {
            var updated = await Data.RejectArticleAsync(ArticleId);
            if (updated is null) { _error = "No se pudo devolver el artículo a borrador."; return; }

            Toast.Show("Artículo devuelto a borrador.", ToastVariant.Info, "corner-up-left");
            Nav.NavigateTo("/articulos/revision");
        }

        private static string ToastMessageFor(ArticleStatus status) => status switch
        {
            ArticleStatus.Draft => "Guardado como borrador.",
            ArticleStatus.InReview => "Enviado a revisión.",
            ArticleStatus.Published => "Artículo publicado.",
            _ => "Cambios guardados."
        };

        private class EditArticleModel
        {
            [System.ComponentModel.DataAnnotations.Required]
            public string Title { get; set; } = string.Empty;

            public string Summary { get; set; } = string.Empty;

            public Guid CategoryId { get; set; }

            public Guid AuthorId { get; set; }

            public List<Guid> TagIds { get; set; } = new();

            public Guid? CoverImageMediaId { get; set; }

            public bool IsFeatured { get; set; }

            public List<ArticleContentBlock> Content { get; set; } = new();
        }
    }
}







.callout { display: flex; gap: 10px; align-items: flex-start; padding: 12px 16px; border-radius: 10px; margin-bottom: 18px; }
.callout--warning { background: rgba(217,119,6,.08); color: #92400e; }
.callout--danger { background: rgba(220,38,38,.08); color: #991b1b; }
.callout__title { font-weight: 600; margin-bottom: 2px; }

.page-header__status-line { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.form-hint--waiting { display: flex; align-items: center; gap: 6px; color: #92400e; font-size: var(--fs-sm, 13px); }