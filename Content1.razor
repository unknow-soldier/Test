@using CorpWiki.Application.DTOs.Incidents
@using CorpWiki.Application.Helpers
@using CorpWiki.Web.Extensions

<a href="@($"/incidencias/{Item.Id}")"
   class="card"
   style="display:flex; flex-direction:column; gap: var(--space-3); padding: var(--space-4) var(--space-5);
          margin-bottom: var(--space-3); text-decoration:none; color:inherit;">

    <div style="display:flex; justify-content:space-between; align-items:flex-start; gap: var(--space-3); flex-wrap:wrap;">
        <div style="min-width:0;">
            <span style="font-size: 0.8rem; color: var(--text-tertiary); font-weight:600;">@Item.Code</span>
            <h4 style="margin: 2px 0 0; font-size: 1rem;">@Item.Title</h4>
        </div>
        <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
            @if (IsResponsibleNow)
            {
                <span class="badge badge--brand"><Icon Name="star" /> Soy responsable</span>
            }
            else if (Item.CreatedByUserId == CurrentUserId)
            {
                <span class="badge badge--outline"><Icon Name="plus-circle" /> La reporté yo</span>
            }
            <IncidentStatusBadge Status="Item.Status" />
            <IncidentPriorityBadge Priority="Item.Priority" />
            <AreaBadge Name="@Item.AreaName" Color="@Item.AreaColor" ShowIcon="false" Small="true" />
        </div>
    </div>

    <div style="display:flex; justify-content:space-between; align-items:center; gap: var(--space-3); flex-wrap:wrap;">
        <div style="display:flex; align-items:center; gap:6px;">
            @if (Item.Responsibles.Count == 0)
            {
                <span style="font-size:0.85rem; color: var(--text-tertiary);">Sin responsables</span>
            }
            else
            {
                @foreach (var r in Item.Responsibles.Take(3))
                {
                    <UserAvatar FullName="@r.FullName" Initials="@r.Initials"
                                ColorFrom="@r.AvatarColorFrom" ColorTo="@r.AvatarColorTo"
                                Size="UserAvatar.AvatarSize.Sm" />
                }
                @if (Item.Responsibles.Count > 3)
                {
                    <span style="font-size:0.8rem; color: var(--text-tertiary);">+@(Item.Responsibles.Count - 3)</span>
                }
            }
        </div>

        <div style="display:flex; gap: var(--space-4); font-size:0.8rem; color: var(--text-tertiary); align-items:center;">
            <span style="display:flex; align-items:center; gap:4px;"><Icon Name="message-circle" /> @Item.CommentsCount</span>
            <span style="display:flex; align-items:center; gap:4px;"><Icon Name="arrow-right" /> @Item.TransfersCount</span>
            <span style="display:flex; align-items:center; gap:4px;"><Icon Name="clock" /> @Item.UpdatedAt.ToRelativeLabel()</span>
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public IncidentSummaryDto Item { get; set; } = null!;
    [Parameter] public Guid CurrentUserId { get; set; }

    private bool IsResponsibleNow =>
        Item.Status != CorpWiki.Domain.Entities.Incidents.IncidentStatus.Cerrada &&
        Item.Responsibles.Any(r => r.Id == CurrentUserId);
}







@page "/incidencias/listado"
@rendermode InteractiveServer
@inject IIncidentService Incidents
@inject ISecurityService Security
@using CorpWiki.Web.Components.Shared.Incidents
<PageTitle>DaviWiki - Listado de Incidencias</PageTitle>

<div class="page-header">
    <div>
        <h1>Listado de Incidencias</h1>
        <p>@_filtered.Count() de @_all.Count incidencias.</p>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--primary" href="/incidencias/nueva"><Icon Name="plus" /> Nueva incidencia</a>
    </div>
</div>

<div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom: var(--space-4);">
    <button type="button" class="chip @(_view == "todas" ? "chip--active" : "")" @onclick='() => SetView("todas")'>
        <Icon Name="inbox" /> Todas (@_all.Count)
    </button>
    <button type="button" class="chip @(_view == "mias" ? "chip--active" : "")" @onclick='() => SetView("mias")'>
        <Icon Name="user-check" /> Mis incidencias (@_mineCount)
    </button>
    <button type="button" class="chip @(_view == "responsable" ? "chip--active" : "")" @onclick='() => SetView("responsable")'>
        <Icon Name="star" /> Soy responsable (@_responsibleCount)
    </button>
</div>

<div class="card widget" style="margin-bottom: var(--space-5);">
    <h4 class="widget__title" style="margin-bottom: var(--space-3);"><Icon Name="pie-chart" />Distribución por estado</h4>
    <SegmentedBar Segments="_statusBarSegments" />
    <div class="distribution-legend-row">
        @foreach (var chip in _statusChips)
        {
            <button type="button" class="chip @(_statusFilter == chip.Value ? "chip--active" : "")"
                    @onclick="() => QuickFilterStatus(chip.Value)">
                <span class="donut-legend__dot" style="background:@chip.Color;"></span>@chip.Label (@chip.Count)
            </button>
        }
    </div>
</div>

<div class="incidents-filters-row">
    <div class="explorer-search">
        <Icon Name="search" />
        <input class="explorer-search__input" placeholder="Buscar por código, título o responsable..."
               @bind="_search" @bind:event="oninput" />
    </div>

    <select class="input" @bind="_areaFilter">
        <option value="">Todas las áreas</option>
        @foreach (var area in _areas)
        {
            <option value="@area.Name">@area.Name</option>
        }
    </select>

    <select class="input" @bind="_statusFilter">
        <option value="">Todos los estados</option>
        @foreach (var status in Enum.GetValues<IncidentStatus>())
        {
            <option value="@status">@IncidentLabels.Status(status)</option>
        }
    </select>

    <select class="input" @bind="_priorityFilter">
        <option value="">Todas las prioridades</option>
        @foreach (var priority in Enum.GetValues<IncidentPriority>())
        {
            <option value="@priority">@IncidentLabels.Priority(priority)</option>
        }
    </select>

    <button class="chip-incidencias @(_onlyActive ? "chip--active" : "")" @onclick="ToggleOnlyActive">
        Solo activas
    </button>
</div>

<div style="display:flex; justify-content:flex-end; margin: var(--space-3) 0;">
    <SortToggle @bind-Descending="_sortDesc" />
</div>

@if (!_pageItems.Any())
{
    <div class="empty-state">
        <Icon Name="inbox" />
        <h3>Sin resultados</h3>
        <p>
            @if (_view == "responsable") { <text>No eres responsable de ninguna incidencia abierta.</text> }
            else if (_view == "mias") { <text>No estás involucrado en ninguna incidencia con estos filtros.</text> }
            else { <text>Ninguna incidencia coincide con los filtros aplicados.</text> }
        </p>
    </div>
}
else
{
    <div class="incident-list">
        @foreach (var item in _pageItems)
        {
            <IncidentListRow Item="item" CurrentUserId="_me" />
        }
    </div>

    <div class="pagination">
        <button class="pagination__btn pagination__btn--nav" disabled="@(_page == 1)" @onclick="() => GoToPage(_page - 1)">
            <Icon Name="chevron-left" />
        </button>
        @for (var p = 1; p <= _totalPages; p++)
        {
            var pageNumber = p;
            <button class="pagination__btn @(pageNumber == _page ? "pagination__btn--active" : "")"
                    @onclick="() => GoToPage(pageNumber)">
                @pageNumber
            </button>
        }
        <button class="pagination__btn pagination__btn--nav" disabled="@(_page == _totalPages)" @onclick="() => GoToPage(_page + 1)">
            <Icon Name="chevron-right" />
        </button>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "estado")] public string? QueryStatus { get; set; }
    [SupplyParameterFromQuery(Name = "prioridad")] public string? QueryPriority { get; set; }
    [SupplyParameterFromQuery(Name = "area")] public string? QueryArea { get; set; }
    [SupplyParameterFromQuery(Name = "buscar")] public string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "vista")] public string? QueryView { get; set; }

    private const int PageSize = 8;

    private IReadOnlyList<IncidentSummaryDto> _all = new List<IncidentSummaryDto>();
    private IReadOnlyList<Area> _areas = new List<Area>();
    private Guid _me;

    private string _view = "todas";
    private string _search = string.Empty;
    private string _areaFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private string _priorityFilter = string.Empty;
    private bool _onlyActive;
    private bool _sortDesc = true;
    private int _page = 1;
    private int _mineCount;
    private int _responsibleCount;

    private List<(string Label, double Value, string Color)> _statusBarSegments = new();
    private List<(string Label, string Value, int Count, string Color)> _statusChips = new();

    protected override async Task OnInitializedAsync()
    {
        _statusFilter = QueryStatus ?? string.Empty;
        _priorityFilter = QueryPriority ?? string.Empty;
        _areaFilter = QueryArea ?? string.Empty;
        _search = QuerySearch ?? string.Empty;
        _view = (QueryView == "mias" || QueryView == "responsable") ? QueryView! : "todas";

        _me = await Security.GetCurrentUserIdAsync();
        _all = await Incidents.GetIncidentSummariesAsync();
        _areas = await Incidents.GetAreasAsync();

        _mineCount = _all.Count(IsMine);
        _responsibleCount = _all.Count(IsResponsibleNow);

        foreach (var status in Enum.GetValues<IncidentStatus>())
        {
            var count = _all.Count(i => i.Status == status);
            if (count == 0) continue;

            var color = $"var(--status-{IncidentCssHelpers.StatusSuffix(status)})";
            _statusBarSegments.Add((IncidentLabels.Status(status), count, color));
            _statusChips.Add((IncidentLabels.Status(status), status.ToString(), count, color));
        }
    }

    // Involucrado = la reportó o participó alguna vez (responsable o colaborador).
    private bool IsMine(IncidentSummaryDto i) =>
        i.CreatedByUserId == _me || i.InvolvedUserIds.Contains(_me);

    // Responsable actual de una incidencia que sigue abierta.
    private bool IsResponsibleNow(IncidentSummaryDto i) =>
        i.Status != IncidentStatus.Cerrada && i.Responsibles.Any(r => r.Id == _me);

    private void SetView(string view)
    {
        _view = view;
        _page = 1;
    }

    private void QuickFilterStatus(string statusValue)
    {
        _statusFilter = _statusFilter == statusValue ? string.Empty : statusValue;
        _page = 1;
    }

    private IEnumerable<IncidentSummaryDto> _filtered
    {
        get
        {
            var query = _all.Where(i =>
                (_view == "todas" || (_view == "mias" && IsMine(i)) || (_view == "responsable" && IsResponsibleNow(i)))
                && (string.IsNullOrWhiteSpace(_search)
                    || i.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || i.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || i.Responsibles.Any(r => r.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase)))
                && (string.IsNullOrEmpty(_areaFilter) || i.AreaName == _areaFilter)
                && (string.IsNullOrEmpty(_statusFilter) || i.Status.ToString() == _statusFilter)
                && (string.IsNullOrEmpty(_priorityFilter) || i.Priority.ToString() == _priorityFilter)
                && (!_onlyActive || i.Status != IncidentStatus.Cerrada));

            return _sortDesc ? query.OrderByDescending(i => i.UpdatedAt) : query.OrderBy(i => i.UpdatedAt);
        }
    }

    private int _totalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count() / (double)PageSize));

    private List<IncidentSummaryDto> _pageItems =>
        _filtered.Skip((_page - 1) * PageSize).Take(PageSize).ToList();

    private void ToggleOnlyActive()
    {
        _onlyActive = !_onlyActive;
        _page = 1;
    }

    private void GoToPage(int page) => _page = Math.Clamp(page, 1, _totalPages);
}






@page "/incidencias/{Id:guid}"
@rendermode InteractiveServer
@inject IIncidentService Incidents
@inject ISecurityService Security
@inject NavigationManager Nav
@inject IToastService Toast
@inject IJSRuntime JSRuntime
@using CorpWiki.Web.Extensions
@using CorpWiki.Web.Components.Shared.Incidents
@using CorpWiki.Web.Components.Shared
@using CorpWiki.Web.Services
@using CorpWiki.Domain.Entities.Security
@using CorpWiki.Application.Helpers
<PageTitle>DaviWiki - @(_detail?.Code ?? "Incidencia")</PageTitle>

@if (_detail is null)
{
    <div class="empty-state">
        <Icon Name="alert-triangle" Class="empty-state__icon" />
        <h2>Incidencia no encontrada</h2>
        <p>Puede que se haya movido o el enlace esté roto.</p>
        <a class="btn btn--primary" href="/incidencias/listado">Ver todas las incidencias</a>
    </div>
}
else
{
    <Breadcrumb Items="_breadcrumb" />

    @* ================= CABECERA ================= *@
    <div class="page-header">
        <div>
            <span class="incident-detail-code">@_detail.Code</span>
            <h1>@_detail.Title</h1>
            <div style="display:flex; gap:8px; margin-top:10px; flex-wrap:wrap; align-items:center;">
                <IncidentStatusBadge Status="_detail.Status" />
                <IncidentPriorityBadge Priority="_detail.Priority" />
                @if (_detail.ReactivationCount > 0)
                {
                    <span class="badge"><Icon Name="rotate-ccw" />Reactivada x@_detail.ReactivationCount</span>
                }
                <span class="badge badge--outline"><Icon Name="clock" />@StatusAgeLabel()</span>
            </div>
        </div>
        <div class="page-header__actions">
            @if (_detail.Status != IncidentStatus.Cerrada && IsCurrentUserResponsible)
            {
                <button class="btn btn--danger btn--sm" @onclick="RequestCloseConfirmation">
                    <Icon Name="check-circle" /> Cerrar
                </button>
            }
            else if (_detail.Status == IncidentStatus.Cerrada && IsCurrentUserCreator)
            {
                <button class="btn btn--secondary btn--sm" @onclick="RequestReactivateConfirmation">
                    <Icon Name="rotate-ccw" /> Reactivar
                </button>
            }
        </div>
    </div>

    <div class="detail-tabs" role="tablist">
        <button class="detail-tabs__item @(_activeTab == "resumen" ? "detail-tabs__item--active" : "")"
                role="tab" aria-selected="@(_activeTab == "resumen")" @onclick='() => SetTab("resumen")'>
            <Icon Name="file-text" /> Resumen
        </button>
        <button class="detail-tabs__item @(_activeTab == "actividad" ? "detail-tabs__item--active" : "")"
                role="tab" aria-selected="@(_activeTab == "actividad")" @onclick='() => SetTab("actividad")'>
            <Icon Name="activity" /> Actividad
            <span class="detail-tabs__count">@(_detail.Activity.Count + _detail.Comments.Count)</span>
        </button>
        <button class="detail-tabs__item @(_activeTab == "gestion" ? "detail-tabs__item--active" : "")"
                role="tab" aria-selected="@(_activeTab == "gestion")" @onclick='() => SetTab("gestion")'>
            <Icon Name="settings" /> Gestión
        </button>
    </div>

    @* ================= TAB RESUMEN ================= *@
    @if (_activeTab == "resumen")
    {
        <div class="detail-tabs__panel">

            @* 1. SITUACIÓN ACTUAL: lo primero que se quiere saber *@
            <div class="card" style="padding: var(--space-5) var(--space-6); margin-bottom: var(--space-5);
                                    border-top: 3px solid var(--priority-@IncidentCssHelpers.PrioritySuffix(_detail.Priority));">
                <h4 class="widget__title"><Icon Name="info" />Situación actual</h4>

                <div style="display:flex; gap: var(--space-6); flex-wrap:wrap; align-items:flex-start;">
                    <div style="flex:1; min-width:220px;">
                        <span class="incident-meta-grid__label"><Icon Name="user-check" />Quién la tiene</span>
                        <div style="margin-top:6px;">
                            @if (_detail.Responsibles.Count == 0)
                            {
                                <span>Nadie</span>
                            }
                            else
                            {
                                <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                                    @foreach (var r in _detail.Responsibles)
                                    {
                                        <span style="display:inline-flex; align-items:center; gap:6px;">
                                            <UserAvatar FullName="@r.FullName" Initials="@r.Initials"
                                                        ColorFrom="@r.AvatarColorFrom" ColorTo="@r.AvatarColorTo" Size="UserAvatar.AvatarSize.Sm" />
                                            @r.FullName
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div style="min-width:150px;">
                        <span class="incident-meta-grid__label"><Icon Name="layers-3" />Área actual</span>
                        <div style="margin-top:6px;">
                            <AreaBadge Name="@_detail.CurrentAreaName" Color="@_detail.CurrentAreaColor" ShowIcon="false" Small="true" />
                        </div>
                    </div>

                    <div style="min-width:150px;">
                        <span class="incident-meta-grid__label"><Icon Name="refresh-cw" />Última actividad</span>
                        <div style="margin-top:6px;">@_detail.UpdatedAt.ToRelativeLabel()</div>
                    </div>
                </div>

                @if (_detail.Status == IncidentStatus.Cerrada)
                {
                    <div style="@NoteStyle(OkColor)">
                        <Icon Name="check-circle" />
                        <span>Cerrada el @_detail.ClosedAt?.ToString("d MMM yyyy, HH:mm"). Solo @_detail.CreatedByName (quien la reportó) puede reactivarla.</span>
                    </div>
                }
                else if (_detail.Status == IncidentStatus.Resuelta)
                {
                    <div style="@NoteStyle(InfoColor)">
                        <Icon Name="info" />
                        <span>Está marcada como resuelta y el reloj está detenido. Un responsable debe cerrarla, o volver a ponerla en desarrollo si falta trabajo.</span>
                    </div>
                }
                else if (_detail.Responsibles.Count == 0)
                {
                    <div style="@NoteStyle(WarnColor)">
                        <Icon Name="alert-triangle" />
                        <span>Nadie la tiene asignada. Este tiempo cuenta como espera.</span>
                        @if (CanTake)
                        {
                            <button class="btn btn--primary btn--sm" style="margin-left:auto;" @onclick="TakeAction">
                                <Icon Name="user-check" /> Tomarla yo
                            </button>
                        }
                    </div>
                }
            </div>

            @* 2. TIEMPOS *@
            <div class="card" style="padding: var(--space-6); margin-bottom: var(--space-5);">
                <h4 class="widget__title"><Icon Name="clock" />Tiempos</h4>
                <p class="form-hint" style="margin-bottom: var(--space-4);">
                    <strong>Trabajo activo</strong>: hay responsables asignados. <strong>En espera</strong>: nadie la tiene. Si está resuelta, el reloj se detiene.
                </p>
                <div style="display:flex; gap: var(--space-6); flex-wrap:wrap; align-items:center;">
                    <div class="time-summary" style="flex:1; min-width:260px;">
                        <DonutChart Segments="_timeSegmentsChart" Size="120" Thickness="16"
                                    CenterValue="@Fmt(_detail.TotalHours)" CenterLabel="total" />
                        <div style="flex:1; min-width:180px;">
                            <IncidentTimeBar ActiveHours="_detail.TotalActiveHours" DeadHours="_detail.TotalDeadHours" />
                        </div>
                    </div>

                    @if (_areaTimeSegments.Count > 0)
                    {
                        <div style="flex:1; min-width:260px;">
                            <span class="incident-meta-grid__label"><Icon Name="layers-3" />Por equipo (clic para ver su etapa)</span>
                            <div class="donut-widget__row" style="margin-top:8px;">
                                <DonutChart Segments="_areaTimeSegments" CenterValue="@_areaTimeSegments.Count.ToString()" CenterLabel="equipos"
                                            OnSegmentClick="OpenAreaModal" ActiveLabel="@_selectedAreaName" />
                                <DonutLegend Items="_areaTimeLegend" OnItemClick="OpenAreaModal" ActiveLabel="@_selectedAreaName" />
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* 3. RECORRIDO *@
            @if (_stories.Count > 1)
            {
                <div class="card" style="padding: var(--space-5) var(--space-6); margin-bottom: var(--space-5);">
                    <div style="display:flex; align-items:center; justify-content:space-between; gap:var(--space-3); margin-bottom: var(--space-3); flex-wrap:wrap;">
                        <h4 class="widget__title" style="margin-bottom:0;"><Icon Name="workflow" />Recorrido entre áreas</h4>
                        <button class="btn btn--secondary btn--sm" @onclick="() => OpenJourneyModal(0)">
                            <Icon Name="eye" /> Ver recorrido detallado
                        </button>
                    </div>

                    <div class="journey-stepper">
                        @for (var i = 0; i < _stories.Count; i++)
                        {
                            var index = i;
                            var node = _stories[i].Stage;
                            <div class="journey-stepper__node journey-stepper__node--interactive @(node.IsCurrent ? "journey-stepper__node--current" : "")"
                                 style="animation-delay: @($"{i * 60}ms");"
                                 @onclick="() => OpenJourneyModal(index)"
                                 title="Ver la historia de esta etapa">
                                <span class="journey-stepper__icon" style="background:@node.Color;">
                                    <Icon Name="@node.Icon" Class="journey-stepper__icon-svg" />
                                </span>
                                @node.AreaName
                                <small style="opacity:.7; margin-left:6px;">@Fmt(_stories[i].ActiveHours + _stories[i].DeadHours)</small>
                            </div>
                            @if (i < _stories.Count - 1)
                            {
                                <Icon Name="chevron-right" Class="journey-stepper__arrow" />
                            }
                        }
                    </div>
                    <p class="form-hint" style="margin-top:var(--space-2);">
                        <Icon Name="mouse-pointer-click" /> Cada etapa muestra el tiempo que estuvo en esa área. Haz clic para ver quién trabajó y qué pasó.
                    </p>
                </div>
            }

            @* 4. DESCRIPCIÓN *@
            <div class="card" style="padding: var(--space-6); margin-bottom: var(--space-5);">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: var(--space-3);">
                    <h4 class="widget__title"><Icon Name="file-text" />Descripción</h4>
                    @if (!_editingContent)
                    {
                        <button class="btn btn--secondary btn--sm" @onclick="StartEditContent">
                            <Icon Name="pencil" /> Editar
                        </button>
                    }
                </div>

                @if (_editingContent)
                {
                    <Editra @bind-Blocks="_contentDraft" />
                    <div class="form-actions" style="margin-top: var(--space-3);">
                        <button class="btn btn--secondary btn--sm" @onclick="CancelEditContent">Cancelar</button>
                        <button class="btn btn--primary btn--sm" @onclick="SaveContent">
                            <Icon Name="check-circle" /> Guardar
                        </button>
                    </div>
                }
                else if (_detail.Content is { Count: > 0 })
                {
                    <p>@_detail.Description</p>
                    <ArticleBody Blocks="_detail.Content" />
                }
                else
                {
                    <p>@_detail.Description</p>
                }
            </div>

            @* 5. ADJUNTOS Y ARTÍCULOS *@
            @if (_detail.Attachments.Count > 0 || _detail.RelatedArticles.Count > 0)
            {
                <div class="info-grid" style="margin-bottom: var(--space-5);">
                    @if (_detail.Attachments.Count > 0)
                    {
                        <div class="widget card">
                            <h4 class="widget__title"><Icon Name="paperclip" />Adjuntos</h4>
                            @foreach (var file in _detail.Attachments)
                            {
                                <div class="file-row" style="margin-bottom: var(--space-2);">
                                    <span class="file-row__icon"><Icon Name="file-text" /></span>
                                    <span class="file-row__info">
                                        <span class="file-row__name">@file.FileName</span>
                                        <span class="file-row__meta">@file.FileType · @file.SizeLabel</span>
                                    </span>
                                </div>
                            }
                        </div>
                    }

                    @if (_detail.RelatedArticles.Count > 0)
                    {
                        <div class="widget card">
                            <h4 class="widget__title"><Icon Name="file-text" />Artículos relacionados</h4>
                            @foreach (var article in _detail.RelatedArticles)
                            {
                                <a class="external-link-row" style="margin-bottom: var(--space-2);" href="@($"/articulos/{article.Slug}")">
                                    <Icon Name="file-text" /> @article.Title
                                </a>
                            }
                        </div>
                    }
                </div>
            }

            @* 6. DATOS DE LA INCIDENCIA *@
            <div class="card" style="padding: var(--space-6); margin-bottom: var(--space-6);">
                <h4 class="widget__title"><Icon Name="list" />Datos</h4>
                <div class="incident-meta-grid">
                    <div class="incident-meta-grid__item">
                        <span class="incident-meta-grid__label"><Icon Name="layers-3" />Área de origen</span>
                        <span class="incident-meta-grid__value"><AreaBadge Name="@_detail.OriginAreaName" Color="@_detail.OriginAreaColor" ShowIcon="false" Small="true" /></span>
                    </div>
                    <div class="incident-meta-grid__item">
                        <span class="incident-meta-grid__label"><Icon Name="plus-circle" />Reportada por</span>
                        <span class="incident-meta-grid__value">
                            <UserAvatar FullName="@_detail.CreatedByName" Initials="@_detail.CreatedByInitials"
                                        ColorFrom="@_detail.CreatedByAvatarColorFrom" ColorTo="@_detail.CreatedByAvatarColorTo" Size="UserAvatar.AvatarSize.Sm" />
                            @_detail.CreatedByName
                        </span>
                    </div>
                    <div class="incident-meta-grid__item">
                        <span class="incident-meta-grid__label"><Icon Name="clock" />Creada</span>
                        <span class="incident-meta-grid__value">@_detail.CreatedAt.ToString("d MMM yyyy, HH:mm")</span>
                    </div>
                    @if (_detail.ClosedAt.HasValue)
                    {
                        <div class="incident-meta-grid__item">
                            <span class="incident-meta-grid__label"><Icon Name="check-circle" />Cerrada</span>
                            <span class="incident-meta-grid__value">@_detail.ClosedAt.Value.ToString("d MMM yyyy, HH:mm")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* ================= TAB ACTIVIDAD ================= *@
    @if (_activeTab == "actividad")
    {
        <div class="detail-tabs__panel">
            <section class="section">
                <div style="display:flex; justify-content:space-between; align-items:center; gap:var(--space-3); flex-wrap:wrap;">
                    <h3>Historial (@_detail.Activity.Count)</h3>
                    <SortToggle @bind-Descending="_activityDesc" />
                </div>
                <div class="card widget">
                    <div class="version-timeline">
                        @foreach (var entry in Order(_detail.Activity, a => a.OccurredAt, _activityDesc))
                        {
                            var color = IncidentCssHelpers.ActivityColor(entry.Type);
                            <div class="version-row">
                                <span class="version-row__dot" style="background:@color;"></span>
                                <div>
                                    <p class="version-row__label">
                                        <span class="version-row__type-icon" style="color:@color;">
                                            <Icon Name="@IncidentCssHelpers.ActivityIcon(entry.Type)" Class="version-row__type-icon-svg" />
                                        </span>
                                        @entry.Description
                                    </p>
                                    <p class="version-row__date">@entry.OccurredAt.ToString("d MMM yyyy, HH:mm") · @entry.OccurredAt.ToRelativeLabel()</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>

            <section class="section" style="margin-top: var(--space-6);">
                <div style="display:flex; justify-content:space-between; align-items:center; gap:var(--space-3); flex-wrap:wrap;">
                    <h3>Comentarios (@_detail.Comments.Count)</h3>
                    <SortToggle @bind-Descending="_commentsDesc" />
                </div>
                <div class="card" style="padding: var(--space-5);">
                    <div class="comment-composer">
                        <textarea class="input" rows="2" placeholder="Escribe un comentario..." @bind="_newComment"></textarea>
                        <button class="btn btn--primary btn--sm" @onclick="AddCommentAction">Comentar</button>
                    </div>
                    <div class="comments-list">
                        @foreach (var c in Order(_detail.Comments, c => c.CreatedAt, _commentsDesc))
                        {
                            <div class="comment-card">
                                <span class="avatar avatar--sm">@c.AuthorInitials</span>
                                <div class="comment-card__body">
                                    <div class="comment-card__head">
                                        <span class="comment-card__author">@c.AuthorName</span>
                                        <span class="comment-card__date">@c.CreatedAt.ToString("d MMM, HH:mm") · @c.CreatedAt.ToRelativeLabel()</span>
                                    </div>
                                    <p class="comment-card__text">@c.Text</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    }

    @* ================= TAB GESTIÓN ================= *@
    @if (_activeTab == "gestion")
    {
        <div class="detail-tabs__panel">

            @if (!IsCurrentUserResponsible && _detail.Status != IncidentStatus.Cerrada)
            {
                <div style="@NoteStyle(InfoColor) margin-bottom: var(--space-4);">
                    <Icon Name="info" />
                    <span>Solo las personas responsables pueden cambiar el estado, cerrar o reenviar la incidencia.
                        @if (CanTake) { <text> Como nadie la tiene y eres de @_detail.CurrentAreaName, puedes tomarla.</text> }
                    </span>
                    @if (CanTake)
                    {
                        <button class="btn btn--primary btn--sm" style="margin-left:auto;" @onclick="TakeAction">Tomarla yo</button>
                    }
                </div>
            }

            <div class="management-grid">

                <div class="card widget">
                    <h4 class="widget__title"><Icon Name="users" />Equipo responsable</h4>
                    @if (_detail.Responsibles.Count == 0)
                    {
                        <p class="section-header__subtitle">Nadie la tiene asignada.</p>
                    }
                    else
                    {
                        @foreach (var r in _detail.Responsibles)
                        {
                            <div class="activity-row">
                                <UserAvatar FullName="@r.FullName" Initials="@r.Initials"
                                            ColorFrom="@r.AvatarColorFrom" ColorTo="@r.AvatarColorTo" Size="UserAvatar.AvatarSize.Sm" />
                                <div style="flex:1; min-width:0;">
                                    <p class="activity-row__text"><strong>@r.FullName</strong></p>
                                    <p class="activity-row__time">@r.AreaName</p>
                                </div>
                            </div>
                        }
                    }

                    @if (IsCurrentUserResponsible && _detail.Status != IncidentStatus.Cerrada)
                    {
                        <button class="btn btn--secondary btn--sm" style="margin-top: var(--space-3);" @onclick="RequestSelfRemoveConfirmation">
                            <Icon Name="user-x" /> Dejar de ser responsable
                        </button>
                    }
                </div>

                @if (_detail.Status != IncidentStatus.Cerrada && IsCurrentUserResponsible)
                {
                    <div class="card widget">
                        <h4 class="widget__title"><Icon Name="user-check" />Sumar a alguien de mi equipo</h4>
                        <p class="form-hint">Solo personas de @_detail.CurrentAreaName.</p>
                        <div class="form-group">
                            <select class="input" @bind="_addResponsibleUserId">
                                <option value="">Selecciona un compañero</option>
                                @foreach (var u in _currentAreaUsers.Where(u => !_detail.Responsibles.Any(r => r.Id == u.Id)))
                                {
                                    <option value="@u.Id">@u.FullName - @u.Position</option>
                                }
                            </select>
                        </div>
                        <button class="btn btn--secondary btn--sm" @onclick="AddResponsibleAction" disabled="@(!_addResponsibleUserId.HasValue)">
                            Agregar
                        </button>
                    </div>

                    <div class="card widget">
                        <h4 class="widget__title"><Icon Name="refresh-cw" />Estado</h4>
                        @if (_detail.Status == IncidentStatus.Resuelta)
                        {
                            <p class="form-hint">Está resuelta y el reloj está detenido. Si falta trabajo, vuelve a ponerla en desarrollo; si todo está listo, ciérrala.</p>
                            <button class="btn btn--secondary btn--sm" @onclick="() => SetStatusAction(IncidentStatus.EnDesarrollo)">
                                <Icon Name="rotate-ccw" /> Volver a en desarrollo
                            </button>
                        }
                        else
                        {
                            <p class="form-hint">Cuando el problema esté solucionado, márcala como resuelta. El reloj se detiene hasta que se cierre.</p>
                            <button class="btn btn--secondary btn--sm" @onclick="() => SetStatusAction(IncidentStatus.Resuelta)">
                                <Icon Name="check-circle" /> Marcar como resuelta
                            </button>
                        }
                    </div>

                    <div class="card widget">
                        <h4 class="widget__title"><Icon Name="arrow-right" />Reenviar a otra área</h4>
                        <p class="form-hint">Al reenviar, todo tu equipo actual deja de ser responsable y pasa a quienes elijas.</p>
                        <div class="form-group">
                            <select class="input" value="@(_delegateAreaId?.ToString() ?? "")" @onchange="OnDelegateAreaChanged">
                                <option value="">Área destino</option>
                                @foreach (var area in _areas.Where(a => a.Id != _detail.CurrentAreaId))
                                {
                                    <option value="@area.Id">@area.Name</option>
                                }
                            </select>
                        </div>

                        @if (_delegateAreaId.HasValue)
                        {
                            <div class="form-group">
                                <label class="form-label">Nuevos responsables</label>
                                @if (_delegateAreaUsers.Count == 0)
                                {
                                    <p class="form-hint">Esa área todavía no tiene personas registradas.</p>
                                }
                                else
                                {
                                    <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                        @foreach (var u in _delegateAreaUsers)
                                        {
                                            var uid = u.Id;
                                            <button type="button" class="chip @(_delegateUserIds.Contains(uid) ? "chip--active" : "")"
                                                    @onclick="() => ToggleDelegateUser(uid)">
                                                @u.FullName
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <div class="form-group">
                            <textarea class="input" rows="2" placeholder="Motivo del reenvío" @bind="_delegateReason"></textarea>
                        </div>

                        <button class="btn btn--secondary btn--sm" @onclick="DelegateAction"
                                disabled="@(!_delegateAreaId.HasValue || _delegateUserIds.Count == 0)">
                            Reenviar
                        </button>
                    </div>
                }
            </div>

            @if (_detail.Transfers.Count > 0)
            {
                <div class="widget card" style="margin-top: var(--space-5);">
                    <div style="display:flex; justify-content:space-between; align-items:center; gap:var(--space-3); flex-wrap:wrap; margin-bottom: var(--space-3);">
                        <h4 class="widget__title" style="margin-bottom:0;"><Icon Name="arrow-right" />Historial de reenvíos (@_detail.Transfers.Count)</h4>
                        <SortToggle @bind-Descending="_transfersDesc" />
                    </div>
                    @foreach (var t in Order(_detail.Transfers, t => t.TransferredAt, _transfersDesc))
                    {
                        <div class="activity-row">
                            <div class="activity-row__icon" style="background:rgba(236,72,153,0.14); color:#ec4899;">
                                <Icon Name="arrow-right" />
                            </div>
                            <div style="flex:1; min-width:0;">
                                <p class="activity-row__text">@t.FromAreaName &rarr; <strong>@t.ToAreaName</strong> · reenvió @t.FromUserName, recibe @t.ToUserName</p>
                                <p class="activity-row__time">@t.Reason · @t.TransferredAt.ToString("d MMM, HH:mm") · @t.TransferredAt.ToRelativeLabel()</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@* ================= MODAL: HISTORIA POR ETAPA ================= *@
@if (_showJourneyModal && _journeyStep is not null && _detail is not null)
{
    var story = _journeyStep;
    var stage = story.Stage;

    <div class="journey-modal-overlay" @onclick="CloseJourneyModal">
        <div class="journey-modal @(_isExpanded ? "journey-modal--expanded" : "")" @onclick:stopPropagation="true">

            <div class="journey-modal__header" style="background:@ColorUtils.ToRgba(stage.Color, 0.14); color:@stage.Color; display:flex; align-items:center; gap:var(--space-3);">
                <span class="journey-modal__header-icon" style="background:@stage.Color;">
                    <Icon Name="@stage.Icon" />
                </span>
                <div style="flex:1; min-width:0;">
                    <h3 class="journey-modal__title">@stage.AreaName</h3>
                    <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center; font-size:0.85rem;">
                        <span>Etapa @(stage.Index + 1) de @_stories.Count</span>
                        <span class="journey-stage-badge">@StageLabel(stage)</span>
                    </div>
                </div>
                <button class="journey-modal__expand-btn" @onclick="ToggleExpandModal" title="Ampliar / reducir">
                    <Icon Name="@(_isExpanded ? "minimize-2" : "maximize-2")" />
                </button>
                <button class="btn btn--ghost btn--sm" @onclick="CloseJourneyModal"><Icon Name="x-circle" /></button>
            </div>

            <div class="journey-context">
                <div class="journey-context__block">
                    <span class="journey-context__label">Recorrido (haz clic para cambiar de etapa)</span>
                    <div class="journey-context__route">
                        @for (var i = 0; i < _stories.Count; i++)
                        {
                            var idx = i;
                            var s = _stories[idx].Stage;
                            var isReturn = _stories.Take(idx).Any(x => x.Stage.AreaName == s.AreaName);

                            <span class="journey-context__area @(idx == stage.Index ? "journey-context__area--active" : "")"
                                  @onclick="() => GoToJourneyStep(idx)">
                                @(idx + 1). @s.AreaName
                                @if (isReturn)
                                {
                                    <span class="journey-return">Retorno</span>
                                }
                            </span>
                            @if (idx < _stories.Count - 1)
                            {
                                <Icon Name="chevron-right" />
                            }
                        }
                    </div>
                </div>

                <div class="journey-context__block">
                    <span class="journey-context__label">Estado de la incidencia hoy</span>
                    <IncidentStatusBadge Status="_detail.Status" />
                </div>
            </div>

            <div class="journey-summary">
                <Icon Name="info" Class="journey-summary__icon" />
                <p class="journey-summary__text">@BuildStageSummary(story)</p>
            </div>

            <div class="@($"journey-modal__body journey-modal__body--{_journeyDirection}")" @key="stage.Index">

                <div class="journey-modal__col">
                    <h4 class="widget__title journey-section"><Icon Name="clock" /> Tiempo en esta etapa</h4>
                    <div class="journey-metrics">
                        <div class="journey-metric journey-metric--work">
                            <Icon Name="activity" />
                            <div>
                                <span class="journey-metric__value">@Fmt(story.ActiveHours)</span>
                                <span class="journey-metric__label">Trabajo activo</span>
                            </div>
                        </div>
                        <div class="journey-metric journey-metric--wait">
                            <Icon Name="clock" />
                            <div>
                                <span class="journey-metric__value">@Fmt(story.DeadHours)</span>
                                <span class="journey-metric__label">En espera</span>
                            </div>
                        </div>
                        <div class="journey-metric journey-metric--distribution">
                            <Icon Name="pie-chart" />
                            <div>
                                <span class="journey-metric__value">@ActivePercentage(story)%</span>
                                <span class="journey-metric__label">del tiempo trabajando</span>
                            </div>
                        </div>
                    </div>

                    @if (StageTransfers(story).Count > 0)
                    {
                        <h4 class="widget__title journey-section" style="margin-top:var(--space-5);">
                            <Icon Name="arrow-right" /> Cómo llegó y cómo salió
                        </h4>
                        @foreach (var item in StageTransfers(story))
                        {
                            <div class="journey-transfer-card">
                                <p class="journey-transfer-card__title">@item.Title</p>
                                <div class="journey-transfer-card__grid">
                                    <div><span class="journey-transfer-card__label">De</span><strong>@item.T.FromAreaName</strong></div>
                                    <div><span class="journey-transfer-card__label">A</span><strong>@item.T.ToAreaName</strong></div>
                                    <div><span class="journey-transfer-card__label">Reenvió</span><strong>@item.T.FromUserName</strong></div>
                                    <div><span class="journey-transfer-card__label">Recibe</span><strong>@item.T.ToUserName</strong></div>
                                    <div><span class="journey-transfer-card__label">Cuándo</span><strong>@item.T.TransferredAt.ToString("d MMM, HH:mm")</strong></div>
                                </div>
                                <p class="journey-comment__text" style="margin-top:8px;">Motivo: @item.T.Reason</p>
                            </div>
                        }
                    }

                    <h4 class="widget__title journey-section" style="margin-top:var(--space-5);">
                        <Icon Name="users" /> Personas en esta etapa
                        <span class="journey-section__count">@story.People.Count</span>
                    </h4>
                    @if (story.People.Count == 0)
                    {
                        <div class="journey-empty">
                            <Icon Name="users" />
                            <p class="journey-empty__title">Nadie estuvo asignado</p>
                            <p class="journey-empty__desc">Durante esta etapa no hubo responsables registrados.</p>
                        </div>
                    }
                    else
                    {
                        <div class="person-row-list">
                            @foreach (var p in story.People)
                            {
                                var isCurrentResp = IsCurrentResponsible(p, story);
                                <div class="activity-row @(isCurrentResp ? "activity-row--highlight" : "")">
                                    <UserAvatar FullName="@p.FullName" Initials="@p.Initials"
                                                ColorFrom="@p.AvatarColorFrom" ColorTo="@p.AvatarColorTo" Size="UserAvatar.AvatarSize.Sm" />
                                    <div style="flex:1; min-width:0;">
                                        <p class="activity-row__text">
                                            <strong>@p.FullName</strong>
                                            <span class="badge @(isCurrentResp ? "badge--brand" : "badge--outline")">@PersonLabel(p, isCurrentResp)</span>
                                        </p>
                                        <p class="activity-row__time">@p.Position · @PersonPeriod(p)</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="journey-modal__col">
                    <div style="display:flex; justify-content:space-between; align-items:center; gap:var(--space-3); flex-wrap:wrap;">
                        <h4 class="widget__title journey-section" style="margin-bottom:0;">
                            <Icon Name="history" /> Qué pasó
                            <span class="journey-section__count">@story.Activity.Count</span>
                        </h4>
                        <SortToggle @bind-Descending="_journeyDesc" />
                    </div>

                    @if (story.Activity.Count == 0)
                    {
                        <div class="journey-empty">
                            <Icon Name="inbox" />
                            <p class="journey-empty__title">Sin actividad</p>
                            <p class="journey-empty__desc">No hay eventos registrados en esta etapa.</p>
                        </div>
                    }
                    else
                    {
                        <div class="journey-timeline">
                            @foreach (var entry in Order(story.Activity, a => a.OccurredAt, _journeyDesc))
                            {
                                var color = IncidentCssHelpers.ActivityColor(entry.Type);
                                <div class="journey-timeline__item">
                                    <div class="journey-timeline__dot" style="background:@ColorUtils.ToRgba(color, 0.14); color:@color;">
                                        <Icon Name="@IncidentCssHelpers.ActivityIcon(entry.Type)" />
                                    </div>
                                    <div class="journey-timeline__content">
                                        <p class="activity-row__text">@entry.Description</p>
                                        <p class="activity-row__time">@entry.OccurredAt.ToString("d MMM, HH:mm") · @entry.OccurredAt.ToRelativeLabel()</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (story.Comments.Count > 0)
                    {
                        <h4 class="widget__title journey-section" style="margin-top:var(--space-5);">
                            <Icon Name="message-circle" /> Comentarios
                            <span class="journey-section__count">@story.Comments.Count</span>
                        </h4>
                        @foreach (var c in Order(story.Comments, c => c.CreatedAt, _journeyDesc))
                        {
                            <div class="journey-comment">
                                <span class="avatar avatar--sm">@c.AuthorInitials</span>
                                <div style="flex:1; min-width:0;">
                                    <p class="journey-comment__meta"><strong>@c.AuthorName</strong> &bull; @c.CreatedAt.ToString("d MMM, HH:mm")</p>
                                    <p class="journey-comment__text">@c.Text</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="journey-modal__controls">
                <button class="btn btn--ghost btn--sm"
                        @onclick="() => GoToJourneyStep(stage.Index - 1)"
                        disabled="@(stage.Index == 0)">
                    <Icon Name="chevron-left" /> Anterior
                </button>

                <span class="journey-controls__position">@(stage.Index + 1) / @_stories.Count</span>

                <button class="btn btn--ghost btn--sm"
                        @onclick="() => GoToJourneyStep(stage.Index + 1)"
                        disabled="@(stage.Index == _stories.Count - 1)">
                    Siguiente <Icon Name="chevron-right" />
                </button>
            </div>
        </div>
    </div>
}

@if (_showConfirmModal)
{
    <div class="modal-overlay">
        <div class="modal">
            <div class="modal__header"><h3>@_confirmTitle</h3></div>
            <div class="modal__body"><p>@_confirmMessage</p></div>
            <div class="modal__footer">
                <button class="btn btn--ghost btn--sm" @onclick="CloseConfirmModal">No, cancelar</button>
                <button class="btn @_confirmButtonClass btn--sm" @onclick="ConfirmPendingAction">@_confirmButtonText</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private const string OkColor = "#22c55e";
    private const string InfoColor = "#0ea5e9";
    private const string WarnColor = "#f59e0b";

    // ---- Modelos internos del recorrido ----
    private record StageInfo(
        int Index, string AreaName, string Color, string Icon,
        DateTime StartedAt, DateTime? EndedAt, bool IsCurrent,
        IncidentTransferDto? Incoming, IncidentTransferDto? Outgoing);

    private record StageStory(
        StageInfo Stage, double ActiveHours, double DeadHours,
        List<IncidentParticipantDto> People,
        List<IncidentActivityDto> Activity,
        List<IncidentCommentDto> Comments);

    // ---- Estado del componente ----
    private IncidentDetailDto? _detail;
    private List<Area> _areas = new();
    private List<SecurityUser> _currentAreaUsers = new();
    private List<BreadcrumbItem> _breadcrumb = new();
    private List<StageInfo> _journey = new();
    private List<StageStory> _stories = new();
    private List<(string Label, double Value, string Color)> _timeSegmentsChart = new();
    private List<(string Label, double Value, string Color)> _areaTimeSegments = new();
    private List<(string Label, string ValueLabel, string Color)> _areaTimeLegend = new();
    private string? _selectedAreaName;
    private string _newComment = string.Empty;
    private string _activeTab = "resumen";

    private Guid _currentUserId;
    private Guid? _addResponsibleUserId;

    private Guid? _delegateAreaId;
    private List<SecurityUser> _delegateAreaUsers = new();
    private HashSet<Guid> _delegateUserIds = new();
    private string _delegateReason = string.Empty;

    private bool _showJourneyModal;
    private bool _isExpanded;
    private string _journeyDirection = "next";
    private StageStory? _journeyStep;

    private bool _editingContent;
    private List<ArticleContentBlock> _contentDraft = new();

    // Orden de historiales (true = más recientes primero)
    private bool _activityDesc = true;
    private bool _commentsDesc = true;
    private bool _transfersDesc = true;
    private bool _journeyDesc = false; // en el modal se lee como historia: de antiguo a reciente

    private bool _showConfirmModal;
    private string _confirmTitle = "";
    private string _confirmMessage = "";
    private string _confirmButtonText = "";
    private string _confirmButtonClass = "";
    private Func<Task>? _pendingAction;

    // ---- Derivados ----
    private HashSet<Guid> ResponsibleIds => _detail?.Responsibles.Select(r => r.Id).ToHashSet() ?? new();
    private bool IsCurrentUserResponsible => ResponsibleIds.Contains(_currentUserId);
    private bool IsCurrentUserCreator => _detail is not null && _detail.CreatedByUserId == _currentUserId;
    private Guid ActorId => _currentUserId;

    private bool CanTake =>
        _detail is not null
        && _detail.Status != IncidentStatus.Cerrada
        && _detail.Responsibles.Count == 0
        && _currentAreaUsers.Any(u => u.Id == _currentUserId);

    // ---- Helpers de presentación ----
    private void SetTab(string tab) => _activeTab = tab;
    private void ToggleExpandModal() => _isExpanded = !_isExpanded;

    private static IEnumerable<T> Order<T>(IEnumerable<T> source, Func<T, DateTime> key, bool desc) =>
        desc ? source.OrderByDescending(key) : source.OrderBy(key);

    private static string Fmt(double hours) =>
        hours <= 0 ? "0 min"
        : hours < 1 ? $"{Math.Max(1, Math.Round(hours * 60)):0} min"
        : $"{hours:0.#} h";

    private static string NoteStyle(string color) =>
        $"display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-top: var(--space-4); padding: 10px 14px; " +
        $"border-radius: 8px; border-left: 3px solid {color}; background: {ColorUtils.ToRgba(color, 0.12)};";

    private string StatusAgeLabel()
    {
        var span = (_detail!.ClosedAt ?? DateTime.Now) - _detail.CreatedAt;
        var text = span.TotalDays >= 1 ? $"{(int)span.TotalDays} d"
                 : span.TotalHours >= 1 ? $"{(int)span.TotalHours} h"
                 : $"{Math.Max(1, (int)span.TotalMinutes)} min";
        return _detail.Status == IncidentStatus.Cerrada ? $"Cerrada tras {text}" : $"Abierta hace {text}";
    }

    // ---- Carga ----
    protected override async Task OnParametersSetAsync()
    {
        _currentUserId = await Security.GetCurrentUserIdAsync();
        _areas = (await Incidents.GetAreasAsync()).ToList();
        await LoadDetail();
    }

    private async Task LoadDetail()
    {
        _detail = await Incidents.GetIncidentDetailAsync(Id);
        if (_detail is null) return;

        _currentAreaUsers = (await Incidents.GetUsersByAreaAsync(_detail.CurrentAreaId))
            .OrderBy(u => u.FullName).ToList();

        _breadcrumb = new List<BreadcrumbItem>
        {
            new("Inicio", "/"),
            new("Incidencias", "/incidencias/listado"),
            new(_detail.Code, null)
        };

        BuildJourney();
        BuildAreaTimeDistribution();
        _timeSegmentsChart = new List<(string, double, string)>
        {
            ("Trabajo activo", _detail.TotalActiveHours, "var(--status-resuelta)"),
            ("En espera", _detail.TotalDeadHours, "var(--border-strong)")
        };
    }

    private void BuildAreaTimeDistribution()
    {
        _areaTimeSegments = new List<(string, double, string)>();
        _areaTimeLegend = new List<(string, string, string)>();
        if (_detail is null) return;

        var grouped = _detail.TimeSegments
            .GroupBy(s => s.AreaName)
            .Select(g => new { AreaName = g.Key, Hours = g.Sum(s => s.DurationHours) })
            .Where(g => g.Hours > 0)
            .OrderByDescending(g => g.Hours)
            .ToList();

        foreach (var g in grouped)
        {
            var color = _areas.FirstOrDefault(a => a.Name == g.AreaName)?.Color ?? "#334155";
            _areaTimeSegments.Add((g.AreaName, g.Hours, color));
            _areaTimeLegend.Add((g.AreaName, Fmt(g.Hours), color));
        }
    }

    // ---- Recorrido por etapas (cada reenvío abre una etapa nueva) ----
    private StageInfo MakeStage(int index, string areaName, DateTime start, DateTime? end,
        IncidentTransferDto? incoming, IncidentTransferDto? outgoing)
    {
        var area = _areas.FirstOrDefault(a => a.Name == areaName);
        return new StageInfo(index, areaName, area?.Color ?? "#334155", area?.Icon ?? "layers-3",
            start, end, false, incoming, outgoing);
    }

    private void BuildJourney()
    {
        _journey = new();
        _stories = new();
        if (_detail is null) return;

        var stages = new List<StageInfo>();
        var startAt = _detail.CreatedAt;
        var areaName = _detail.OriginAreaName;
        IncidentTransferDto? incoming = null;

        foreach (var t in _detail.Transfers.OrderBy(t => t.TransferredAt))
        {
            stages.Add(MakeStage(stages.Count, areaName, startAt, t.TransferredAt, incoming, t));
            areaName = t.ToAreaName;
            startAt = t.TransferredAt;
            incoming = t;
        }
        // La última etapa queda abierta (incluye cierre y reactivaciones).
        stages.Add(MakeStage(stages.Count, areaName, startAt, null, incoming, null));

        _journey = stages.Select(s => s with { IsCurrent = s.Index == stages.Count - 1 }).ToList();
        _stories = _journey.Select(BuildStageStory).ToList();
    }

    private StageStory BuildStageStory(StageInfo st)
    {
        var end = st.EndedAt ?? DateTime.MaxValue;

        var segs = _detail!.TimeSegments.Where(s => s.StartedAt >= st.StartedAt && s.StartedAt < end).ToList();
        var people = _detail.Participants
            .Where(p => p.AreaName == st.AreaName && p.AssignedAt < end && (p.RemovedAt == null || p.RemovedAt > st.StartedAt))
            .OrderBy(p => p.Role == IncidentParticipantRole.Responsable ? 0 : 1)
            .ThenBy(p => p.AssignedAt)
            .ToList();
        var activity = _detail.Activity.Where(a => a.OccurredAt >= st.StartedAt && a.OccurredAt < end).ToList();
        var comments = _detail.Comments.Where(c => c.CreatedAt >= st.StartedAt && c.CreatedAt < end).ToList();

        return new StageStory(
            st,
            Math.Round(segs.Where(s => s.IsActiveWork).Sum(s => s.DurationHours), 1),
            Math.Round(segs.Where(s => !s.IsActiveWork).Sum(s => s.DurationHours), 1),
            people, activity, comments);
    }

    private static string StageLabel(StageInfo st) =>
        st.IsCurrent ? "Etapa actual" : st.Index == 0 ? "Punto de partida" : "Etapa intermedia";

    private string BuildStageSummary(StageStory s)
    {
        var st = s.Stage;
        var parts = new List<string>();

        parts.Add(st.Incoming is null
            ? $"La incidencia se reportó en {st.AreaName}."
            : $"{st.Incoming.FromUserName} la reenvió desde {st.Incoming.FromAreaName} hacia {st.AreaName}.");

        var total = s.ActiveHours + s.DeadHours;
        if (total > 0)
            parts.Add($"Estuvo {Fmt(total)} en esta etapa: {Fmt(s.ActiveHours)} con responsables trabajando y {Fmt(s.DeadHours)} en espera.");

        if (st.Outgoing is not null)
            parts.Add($"Luego {st.Outgoing.FromUserName} la reenvió a {st.Outgoing.ToAreaName}.");
        else if (st.IsCurrent)
            parts.Add(_detail!.Status == IncidentStatus.Cerrada ? "Aquí se cerró la incidencia." : "Es la etapa actual.");

        return string.Join(" ", parts);
    }

    private static double ActivePercentage(StageStory s)
    {
        var total = s.ActiveHours + s.DeadHours;
        return total <= 0 ? 0 : Math.Round(s.ActiveHours / total * 100, 0);
    }

    private static List<(string Title, IncidentTransferDto T)> StageTransfers(StageStory s)
    {
        var list = new List<(string, IncidentTransferDto)>();
        if (s.Stage.Incoming is not null) list.Add(("Cómo llegó", s.Stage.Incoming));
        if (s.Stage.Outgoing is not null) list.Add(("Cómo salió", s.Stage.Outgoing));
        return list;
    }

    private bool IsCurrentResponsible(IncidentParticipantDto p, StageStory s) =>
        s.Stage.IsCurrent && p.RemovedAt == null
        && p.Role == IncidentParticipantRole.Responsable && ResponsibleIds.Contains(p.UserId);

    private string PersonLabel(IncidentParticipantDto p, bool isCurrentResp) =>
        isCurrentResp ? "Responsable actual"
        : p.Role == IncidentParticipantRole.Responsable ? "Fue responsable"
        : p.UserId == _detail!.CreatedByUserId ? "Quien la reportó"
        : p.Role == IncidentParticipantRole.Observador ? "Observador" : "Colaborador";

    private static string PersonPeriod(IncidentParticipantDto p) =>
        p.RemovedAt.HasValue
            ? $"desde {p.AssignedAt:d MMM, HH:mm} hasta {p.RemovedAt.Value:d MMM, HH:mm}"
            : $"desde {p.AssignedAt:d MMM, HH:mm} · sigue";

    // ---- Modal ----
    private async Task OpenJourneyModal(int startIndex = 0)
    {
        if (_stories.Count == 0) return;
        var idx = Math.Clamp(startIndex, 0, _stories.Count - 1);
        _journeyStep = _stories[idx];
        _selectedAreaName = _journeyStep.Stage.AreaName;
        _showJourneyModal = true;
        await JSRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
        await JSRuntime.InvokeVoidAsync("document.body.classList.add", "modal-open");
    }

    private void GoToJourneyStep(int index)
    {
        if (index < 0 || index >= _stories.Count) return;
        _journeyDirection = _journeyStep is not null && index > _journeyStep.Stage.Index ? "next" : "prev";
        _journeyStep = _stories[index];
        _selectedAreaName = _journeyStep.Stage.AreaName;
    }

    private async Task CloseJourneyModal()
    {
        _showJourneyModal = false;
        await JSRuntime.InvokeVoidAsync("document.body.classList.remove", "modal-open");
    }

    private async Task OpenAreaModal(string areaName)
    {
        var idx = _stories.FindIndex(s => s.Stage.AreaName == areaName);
        await OpenJourneyModal(idx >= 0 ? idx : 0);
    }

    // ---- Descripción ----
    private void StartEditContent()
    {
        if (_detail is null) return;
        _contentDraft = _detail.Content.Select(b => new ArticleContentBlock
        {
            Id = b.Id, Type = b.Type, Order = b.Order, Text = b.Text, Meta = b.Meta,
            Urls = new List<string>(b.Urls),
            TableRows = b.TableRows.Select(r => new List<string>(r)).ToList()
        }).ToList();
        _editingContent = true;
    }

    private async Task SaveContent()
    {
        if (_detail is null) return;
        await Incidents.UpdateIncidentContentAsync(_detail.Id, _contentDraft, ActorId);
        _editingContent = false;
        await LoadDetail();
    }

    private void CancelEditContent() => _editingContent = false;

    // ---- Acciones ----
    private async Task TakeAction()
    {
        if (_detail is null) return;
        var ok = await Incidents.AddResponsibleAsync(_detail.Id, _currentUserId, ActorId);
        if (ok)
        {
            await LoadDetail();
            Toast.Show("Ahora eres responsable de esta incidencia.", ToastVariant.Success, "user-check");
        }
        else
        {
            Toast.Show("No se pudo tomar la incidencia.", ToastVariant.Warning, "alert-triangle");
        }
    }

    private async Task AddResponsibleAction()
    {
        if (!_addResponsibleUserId.HasValue || _detail is null) return;

        var ok = await Incidents.AddResponsibleAsync(_detail.Id, _addResponsibleUserId.Value, ActorId);
        _addResponsibleUserId = null;

        if (ok)
        {
            await LoadDetail();
            Toast.Show("Responsable agregado.", ToastVariant.Success, "user-check");
        }
        else
        {
            Toast.Show("No se pudo agregar. Verifica que pertenezca a este equipo.", ToastVariant.Warning, "alert-triangle");
        }
    }

    private async Task RemoveResponsibleAction()
    {
        if (_detail is null) return;

        var ok = await Incidents.RemoveResponsibleAsync(_detail.Id, _currentUserId, ActorId);
        if (ok)
        {
            await LoadDetail();
            Toast.Show("Dejaste de ser responsable de la incidencia.", ToastVariant.Info, "user-x");
        }
        else
        {
            Toast.Show("No se pudo completar la acción.", ToastVariant.Warning, "alert-triangle");
        }
    }

    private void RequestSelfRemoveConfirmation()
    {
        var isLast = _detail!.Responsibles.Count == 1;
        _confirmTitle = "Dejar de ser responsable";
        _confirmMessage = isLast
            ? "Eres la última persona responsable: la incidencia quedará sin responsables y el tiempo contará como espera. ¿Continuar?"
            : "¿Seguro que quieres dejar de ser responsable? Tus compañeros de equipo seguirán a cargo.";
        _confirmButtonText = "Sí, dejar";
        _confirmButtonClass = "btn--danger";
        _pendingAction = RemoveResponsibleAction;
        _showConfirmModal = true;
    }

    private async Task OnDelegateAreaChanged(ChangeEventArgs e)
    {
        _delegateAreaId = Guid.TryParse(e.Value?.ToString(), out var areaId) ? areaId : null;
        _delegateUserIds.Clear();
        _delegateAreaUsers = _delegateAreaId.HasValue
            ? (await Incidents.GetUsersByAreaAsync(_delegateAreaId.Value)).OrderBy(u => u.FullName).ToList()
            : new();
    }

    private void ToggleDelegateUser(Guid userId)
    {
        if (!_delegateUserIds.Remove(userId))
            _delegateUserIds.Add(userId);
    }

    private async Task DelegateAction()
    {
        if (_detail is null || !_delegateAreaId.HasValue || _delegateUserIds.Count == 0) return;

        var ok = await Incidents.DelegateToAreaAsync(_detail.Id, _delegateAreaId.Value, _delegateUserIds.ToList(), _delegateReason, ActorId);

        if (ok)
        {
            _delegateAreaId = null;
            _delegateUserIds.Clear();
            _delegateReason = string.Empty;
            _delegateAreaUsers = new();
            await LoadDetail();
            Toast.Show("Incidencia reenviada.", ToastVariant.Info, "arrow-right");
        }
        else
        {
            Toast.Show("No se pudo reenviar. Verifica que seas responsable actual.", ToastVariant.Warning, "alert-triangle");
        }
    }

    private async Task SetStatusAction(IncidentStatus status)
    {
        if (_detail is null) return;

        var ok = await Incidents.ChangeStatusAsync(_detail.Id, status, ActorId);
        if (ok)
        {
            await LoadDetail();
            Toast.Show($"Estado actualizado a {IncidentLabels.Status(status)}.", ToastVariant.Info, "refresh-cw");
        }
        else
        {
            Toast.Show("Solo un responsable activo puede cambiar el estado.", ToastVariant.Warning, "alert-triangle");
        }
    }

    private async Task CloseIncidentAction()
    {
        if (_detail is null) return;
        var ok = await Incidents.CloseIncidentAsync(_detail.Id, ActorId);
        if (ok)
        {
            await LoadDetail();
            Toast.Show("Incidencia cerrada.", ToastVariant.Success, "check-circle");
        }
        else
        {
            Toast.Show("Solo un responsable activo puede cerrar la incidencia.", ToastVariant.Warning, "alert-triangle");
        }
    }

    private async Task ReactivateAction()
    {
        if (_detail is null) return;
        // El servicio valida que el actor sea quien la reportó.
        var ok = await Incidents.ReactivateIncidentAsync(_detail.Id, ActorId);
        if (ok)
        {
            await LoadDetail();
            Toast.Show("Incidencia reactivada.", ToastVariant.Warning, "rotate-ccw");
        }
        else
        {
            Toast.Show("Solo quien reportó la incidencia puede reactivarla.", ToastVariant.Warning, "alert-triangle");
        }
    }

    private async Task AddCommentAction()
    {
        if (string.IsNullOrWhiteSpace(_newComment) || _detail is null) return;
        await Incidents.AddCommentAsync(_detail.Id, ActorId, _newComment);
        _newComment = string.Empty;
        await LoadDetail();
        Toast.Show("Comentario agregado.", ToastVariant.Success, "message-circle");
    }

    private void RequestCloseConfirmation()
    {
        _confirmTitle = "Cerrar incidencia";
        _confirmMessage = $"¿Seguro que quieres cerrar \"{_detail!.Title}\"? Solo quien la reportó podrá reactivarla.";
        _confirmButtonText = "Sí, cerrar";
        _confirmButtonClass = "btn--danger";
        _pendingAction = CloseIncidentAction;
        _showConfirmModal = true;
    }

    private void RequestReactivateConfirmation()
    {
        _confirmTitle = "Reactivar incidencia";
        _confirmMessage = $"¿Seguro que quieres reactivar \"{_detail!.Title}\"? Volverá a estar abierta.";
        _confirmButtonText = "Sí, reactivar";
        _confirmButtonClass = "btn--secondary";
        _pendingAction = ReactivateAction;
        _showConfirmModal = true;
    }

    private async Task ConfirmPendingAction()
    {
        if (_pendingAction != null) await _pendingAction.Invoke();
        CloseConfirmModal();
    }

    private void CloseConfirmModal()
    {
        _showConfirmModal = false;
        _pendingAction = null;
    }
}