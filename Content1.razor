using CorpWiki.Domain.Entities.Incidents;
using CorpWiki.Domain.Entities.Security;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace CorpWiki.Infrastructure.Persistence.Configurations.Incidents;

public class IncidentTransferConfiguration : IEntityTypeConfiguration<IncidentTransfer>
{
    public void Configure(EntityTypeBuilder<IncidentTransfer> builder)
    {
        builder.ToTable("IncidentTransfers");
        builder.HasKey(t => t.Id);
        builder.Property(t => t.Reason).HasMaxLength(500);

        builder.HasOne<Incident>()
            .WithMany()
            .HasForeignKey(t => t.IncidentId)
            .HasConstraintName("FK_IncidentTransfers_Incidents")
            .OnDelete(DeleteBehavior.Cascade);

        builder.HasOne<SecurityUser>()
            .WithMany()
            .HasForeignKey(t => t.FromUserId)
            .HasConstraintName("FK_IncidentTransfers_SecurityUsers_FromUser")
            .OnDelete(DeleteBehavior.Restrict);

        builder.HasOne<SecurityUser>()
            .WithMany()
            .HasForeignKey(t => t.ToUserId)
            .HasConstraintName("FK_IncidentTransfers_SecurityUsers_ToUser")
            .OnDelete(DeleteBehavior.Restrict);

        builder.HasOne<Area>()
            .WithMany()
            .HasForeignKey(t => t.FromAreaId)
            .HasConstraintName("FK_IncidentTransfers_Areas_FromArea")
            .OnDelete(DeleteBehavior.Restrict);

        builder.HasOne<Area>()
            .WithMany()
            .HasForeignKey(t => t.ToAreaId)
            .HasConstraintName("FK_IncidentTransfers_Areas_ToArea")
            .OnDelete(DeleteBehavior.Restrict);
    }
}





