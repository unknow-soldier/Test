    public async Task<Incident> CreateIncidentAsync(
        string title, string description, Guid areaId, IncidentPriority priority,
        Guid createdByUserId, Guid? initialResponsibleUserId, List<ArticleContentBlock>? content = null)
    {
        await using var db = await _dbFactory.CreateDbContextAsync();

        var now = DateTime.Now;
        var count = await db.Incidents.CountAsync();
        var code = $"INC-{(count + 1):D4}";

        var incident = new Incident
        {
            Id = Guid.NewGuid(),
            Code = code,
            Title = title.Trim(),
            Description = description?.Trim() ?? string.Empty,
            OriginAreaId = areaId,
            CurrentAreaId = areaId,
            CreatedByUserId = createdByUserId,
            Priority = priority,
            Status = IncidentStatus.EnDesarrollo,
            CreatedAt = now,
            UpdatedAt = now,
            Content = content ?? new()
        };

        db.Incidents.Add(incident);

        db.IncidentParticipants.Add(new IncidentParticipant
        {
            Id = Guid.NewGuid(), IncidentId = incident.Id, SecurityUserId = createdByUserId,
            AreaId = areaId, Role = IncidentParticipantRole.Colaborador, AssignedAt = now
        });

        var creator = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == createdByUserId);
        await LogActivityAsync(db, incident.Id, IncidentActivityType.Creada, createdByUserId,
            $"{creator?.FullName ?? "Alguien"} creó la incidencia \"{incident.Title}\".", now);

        db.IncidentTimeSegments.Add(new IncidentTimeSegment
        {
            Id = Guid.NewGuid(), IncidentId = incident.Id, AreaId = areaId,
            UserId = initialResponsibleUserId, StartedAt = now, IsActiveWork = initialResponsibleUserId.HasValue
        });

        SecurityUser? respUser = null;
        if (initialResponsibleUserId.HasValue)
        {
            respUser = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == initialResponsibleUserId.Value);
            if (respUser != null && respUser.AreaId == areaId)
            {
                if (initialResponsibleUserId.Value == createdByUserId)
                {
                    var creatorRow = await db.IncidentParticipants.FirstOrDefaultAsync(p =>
                        p.IncidentId == incident.Id && p.SecurityUserId == createdByUserId && p.RemovedAt == null);
                    if (creatorRow != null) creatorRow.Role = IncidentParticipantRole.Responsable;
                }
                else
                {
                    db.IncidentParticipants.Add(new IncidentParticipant
                    {
                        Id = Guid.NewGuid(), IncidentId = incident.Id, SecurityUserId = initialResponsibleUserId.Value,
                        AreaId = areaId, Role = IncidentParticipantRole.Responsable, AssignedAt = now
                    });
                }

                await LogActivityAsync(db, incident.Id, IncidentActivityType.Asignada, createdByUserId,
                    $"{respUser.FullName} quedó como responsable al crearse.", now);
            }
        }

        await db.SaveChangesAsync();

        var area = await db.Areas.FirstOrDefaultAsync(a => a.Id == areaId);
        if (respUser != null && respUser.Id != createdByUserId)
            NotifyResponsibleAssigned(incident.Id, incident.Code, incident.Title, area?.Name ?? "-",
                respUser, createdByUserId, creator?.FullName ?? "-", NotificationType.IncidentAssigned);

        return incident;
    }

    public async Task<bool> ChangeStatusAsync(Guid incidentId, IncidentStatus newStatus, Guid actorUserId, bool actingAsAdmin = false)
    {
        if (newStatus != IncidentStatus.EnDesarrollo && newStatus != IncidentStatus.Resuelta) return false;

        await using var db = await _dbFactory.CreateDbContextAsync();
        var incident = await db.Incidents.FirstOrDefaultAsync(i => i.Id == incidentId);
        if (incident == null || incident.Status == IncidentStatus.Cerrada) return false;
        if (incident.Status == newStatus) return true;

        if (!actingAsAdmin)
        {
            var isResponsible = await db.IncidentParticipants.AnyAsync(p =>
                p.IncidentId == incidentId && p.SecurityUserId == actorUserId &&
                p.Role == IncidentParticipantRole.Responsable && p.RemovedAt == null);
            if (!isResponsible) return false;
        }

        var now = DateTime.Now;
        var wasResolved = incident.Status == IncidentStatus.Resuelta;
        incident.Status = newStatus;
        incident.UpdatedAt = now;

        if (newStatus == IncidentStatus.Resuelta)
            await CloseTimeSegmentAsync(db, incidentId, now);
        else if (wasResolved)
            await OpenSegmentForCurrentStateAsync(db, incident, now);

        var actor = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == actorUserId);
        await LogActivityAsync(db, incidentId, IncidentActivityType.CambioEstado, actorUserId,
            $"{actor?.FullName ?? "-"} cambió el estado a {IncidentLabels.Status(newStatus)}.", now);

        await db.SaveChangesAsync();
        return true;
    }

    public async Task AddCommentAsync(Guid incidentId, Guid authorUserId, string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        await using var db = await _dbFactory.CreateDbContextAsync();
        var now = DateTime.Now;

        db.IncidentComments.Add(new IncidentComment
        {
            Id = Guid.NewGuid(), IncidentId = incidentId, AuthorUserId = authorUserId,
            Text = text.Trim(), CreatedAt = now
        });

        var incident = await db.Incidents.FirstOrDefaultAsync(i => i.Id == incidentId);
        if (incident != null) incident.UpdatedAt = now;

        var author = await db.SecurityUsers.FirstOrDefaultAsync(u => u.Id == authorUserId);
        await LogActivityAsync(db, incidentId, IncidentActivityType.ComentarioAgregado, authorUserId,
            $"{author?.FullName ?? "-"} comentó en la incidencia.", now);

        await db.SaveChangesAsync();
    }

