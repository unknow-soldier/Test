@using CorpWiki.Domain.Entities.Security

@code {
    private readonly List<string> _steps = new() { "Qué pasó", "Área y gravedad", "Personas", "Confirmar" };
    private int _step;
    private string? _error;

    private List<Area> _areas = new();
    private List<SecurityUser> _users = new();
    private List<SecurityUser> _responsibleOptions = new();

    private readonly CreateIncidentViewModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        _areas = (await Incidents.GetAreasAsync()).ToList();
        _users = (await Incidents.GetUsersAsync()).OrderBy(u => u.FullName).ToList();
    }

    private async Task OnAreaChanged(ChangeEventArgs e)
    {
        _model.AreaId = Guid.TryParse(e.Value?.ToString(), out var areaId) ? areaId : null;
        _model.ResponsibleUserId = null;

        _responsibleOptions = _model.AreaId.HasValue
            ? (await Incidents.GetUsersByAreaAsync(_model.AreaId.Value)).OrderBy(u => u.FullName).ToList()
            : new();
    }

    private void NextStep()
    {
        _error = null;

        if (_step == 0 && (string.IsNullOrWhiteSpace(_model.Title) || string.IsNullOrWhiteSpace(_model.Description)))
        {
            _error = "Completá el título y la descripción antes de continuar.";
            return;
        }

        if (_step == 1 && !_model.AreaId.HasValue)
        {
            _error = "Seleccioná el área responsable antes de continuar.";
            return;
        }

        if (_step == 2 && !_model.CreatedByUserId.HasValue)
        {
            _error = "Seleccioná quién reporta la incidencia antes de continuar.";
            return;
        }

        _step = Math.Min(_step + 1, _steps.Count - 1);
    }

    private void PrevStep()
    {
        _error = null;
        _step = Math.Max(_step - 1, 0);
    }

    private async Task Save()
    {
        if (!_model.AreaId.HasValue || !_model.CreatedByUserId.HasValue ||
            string.IsNullOrWhiteSpace(_model.Title) || string.IsNullOrWhiteSpace(_model.Description))
        {
            _error = "Faltan datos obligatorios. Revisá los pasos anteriores.";
            return;
        }

        var created = await Incidents.CreateIncidentAsync(
            _model.Title,
            _model.Description,
            _model.AreaId.Value,
            _model.Priority,
            _model.CreatedByUserId.Value,
            _model.ResponsibleUserId,
            _model.Content);

        Toast.Show("Incidencia creada correctamente.", ToastVariant.Success, "plus-circle");

        Nav.NavigateTo($"/incidencias/{created.Id}");
    }
}






