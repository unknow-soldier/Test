SELECT TRIM(CUX1CS) AS CIF, CUX1AP AS APLIC,
       CUX1AC AS CUENTA, CUX1TY AS RELACION
  FROM BNKPRD01.CUP00901
 WHERE CUXBK = 1
   AND CUX1AC = 110008108750



SELECT TRIM(c.CUX1CS) AS CIF, c.CUX1AP AS APLIC,
       t.SJ0NUM AS CUENTA16, c.CUX1AC AS CUENTA12
  FROM BNKPRD01.CUP00901 c
  JOIN EVERTECDTA.SJ0TRA t
    ON TRIM(t.SJ0NU2) = TRIM(c.CUX1CS)
   AND SUBSTR(t.SJ0NUM, 7, 10) = SUBSTR(DIGITS(c.CUX1AC), 3, 10)
 WHERE c.CUXBK = 1
   AND c.CUX1AP IN (85, 89, 90)
   AND TRIM(c.CUX1CS) = '0001159706'
