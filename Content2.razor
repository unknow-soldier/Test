REUN001002R   H  REFFLD($REUN01/REUN001002 BCAH96DTA/REUN01)




EXEC SQL SET OPTION COMMIT=*NONE, CLOSQLCSR=*ENDMOD, DATFMT=*ISO;




DCL-PROC PRCARGASFL01;
  DCL-PI *N;
  END-PI;
  DCL-S wUsuario CHAR(10);
  DCL-S wPgm     CHAR(10);
  DCL-S wLib     CHAR(10);
  DCL-S wDes     CHAR(50);

  *IN63 = *OFF;
  *IN25 = *OFF;
  wUsuario = USER;

  EXEC SQL DECLARE C1 CURSOR FOR
    SELECT P.REUN001001, P.REUN001002, P.REUN001003
      FROM BCAH96DTA.REUN04 U
      JOIN BCAH96DTA.REUN01 P
        ON P.REUN001001 = U.REUN04002
     WHERE U.REUN04001 = :wUsuario
     ORDER BY P.REUN001001
     FETCH FIRST 9999 ROWS ONLY
     FOR READ ONLY;

  EXEC SQL OPEN C1;
  IF SQLCODE < 0;
    TITLEMSG1 = ' ERROR ';
    WERRMSG = 'ERROR SQL AL ABRIR LISTA. SQLCODE ' + %CHAR(SQLCODE);
    EXFMT MSGERROR;
  ELSE;
    DOW '1';
      EXEC SQL FETCH C1 INTO :wPgm, :wLib, :wDes;
      IF SQLCODE <> 0;
        LEAVE;
      ENDIF;
      OPC = ' ';
      REUN001001 = wPgm;
      REUN001002 = wLib;
      REUN001003 = wDes;
      NRR += 1;
      WRITE WRCD1;
    ENDDO;
    EXEC SQL CLOSE C1;
  ENDIF;

  *IN63 = *ON;
  SFLSIZ01 = NRR;

  IF NRR = 0;
    OPC = ' ';
    REUN001001 = ' ';
    REUN001002 = ' ';
    REUN001003 = '( LA LISTA ESTÁ VACÍA. )';
    *IN25 = *ON;
    NRR = 1;
    WRITE WRCD1;
  ENDIF;

  *IN61 = *ON;
  *IN60 = *ON;
END-PROC;





    IF *IN03 = *OFF AND *IN12 = *OFF AND *IN25 = *OFF;
      READC WRCD1;
      DOW NOT %EOF(REUNITMENU);
        SELECT;
          WHEN OPC = '1';
            PREJECUTARPROGRAMA();
          WHEN OPC <> ' ';
            TITLEMSG1 = ' ERROR ';
            WERRMSG = 'OPCIÓN NO VÁLIDA. USE 1=SELECCIONAR';
            EXFMT MSGERROR;
        ENDSL;
        OPC = ' ';
        UPDATE WRCD1;
        READC WRCD1;
      ENDDO;
    ENDIF;