D vHoy            S               D
D vMeses          S             10I 0
D vTxt            S              8A


-----------------------------------------------------

 // REIMPRESION: la CNBS exige emision >= hoy
 vHoy = %date();
 if vFecEmi < vHoy;
    vMeses     = %diff(vFecVen : vFecEmi : *MONTHS);  // plazo original
    vFecEmi    = vHoy;
    vFecVen    = vHoy + %months(vMeses);
    $pFemision = %char(vFecEmi : *EUR0);              // ddmmyyyy
    $pFvencimi = %char(vFecVen : *EUR0);
    vTxt       = $pFemision;
    $pFecha    = %subst(vTxt:1:2) + '-' + %subst(vTxt:3:2)
                 + '-' + %subst(vTxt:5:4);            // dd-mm-yyyy
    $pDia      = %subst(vTxt:1:2);
    $pMes      = %subst(vTxt:3:2);
    $pAno      = %subst(vTxt:5:4);
 endif;

----------------------------------------------------------
Opción 2: Se actualiza título y campo 
----------------------------------------------------------
D vReimp          S               N

 // REIMPRESION: la CNBS exige emision >= hoy
 vReimp = *off;
 vHoy = %date();
 if vFecEmi < vHoy;
    vReimp     = *on;
    vMeses     = %diff(vFecVen : vFecEmi : *MONTHS);  // plazo original
    vFecEmi    = vHoy;
    vFecVen    = vHoy + %months(vMeses);
    $pFemision = %char(vFecEmi : *EUR0);              // ddmmyyyy
    $pFvencimi = %char(vFecVen : *EUR0);
    vTxt       = $pFemision;
    $pFecha    = %subst(vTxt:1:2) + '-' + %subst(vTxt:3:2)
                 + '-' + %subst(vTxt:5:4);            // dd-mm-yyyy
    $pDia      = %subst(vTxt:1:2);
    $pMes      = %subst(vTxt:3:2);
    $pAno      = %subst(vTxt:5:4);
 endif;


 /Free
 // REIMPRESION: reflejar fechas nuevas en DAB01GLF solo si el POST fue exitoso
 if vReimp and $Error = 'false';
    chain $pGuid DAB01GLF;                 // relee el registro vigente
    if %found(DAB01GLF);
       FEMISION = %char(vFecEmi : *ISO0);  // yyyymmdd
       FVENCIO  = %char(vFecVen : *ISO0);
       DABFEC   = $pFecha;                 // dd-mm-yyyy
       DABDIA   = $pDia;
       DABMES   = $pMes;
       DAANIO   = $pAno;
       update RDAB01;
    endif;
 endif;
 /End-Free


--------------------------------------------------------------
Opción 3: No se actualiza fecha en título
--------------------------------------------------------------

 // REIMPRESION (variante B): solo cambia la emision enviada;
 // vencimiento, pFecha, pDia/pMes/pAno y fechas del titulo no se tocan
 vHoy = %date();
 if vFecEmi < vHoy;
    $pFemision = %char(vHoy : *EUR0);     // ddmmyyyy
 endif;
