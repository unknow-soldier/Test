SELECT COUNT(*) AS Total_Sin_Beneficiarios
FROM BCAH96DTA.TTLC001 A
LEFT JOIN BCAH96DTA.TTLC008LF B
       ON A.TTLCTIPCTA = B.CAMPO_TIPCTA
      AND A.TTLCCTA    = B.CAMPO_CTA
WHERE B.CAMPO_CTA IS NULL;




SELECT COUNT(*) AS Total_Sin_Beneficiarios
FROM BCAH96DTA.TTLC001 A
WHERE NOT EXISTS (
    SELECT 1
    FROM BCAH96DTA.TTLC008LF B
    WHERE B.CAMPO_TIPCTA = A.TTLCTIPCTA
      AND B.CAMPO_CTA    = A.TTLCCTA
);
