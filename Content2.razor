select distinct c.CUX1CS as cif, c.CUX1AP as aplic, c.CUX1AC as cuenta12,
       t.SJ0NUM,
       hex(cast(mod(c.CUX1AC, 10000000000) as decimal(16,0))) as parm_hex
  from bnkprd01.cup00901 c
  join evertecdta.sj0tra t
    on t.SJ0NUM = mod(c.CUX1AC, 10000000000)
 where c.CUXBK = 1
   and c.CUX1AP = 20
 fetch first 10 rows only