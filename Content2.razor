DCL-DS VNDINDIC QUALIFIED;
    Salir     ind pos(3);
    Renovar   ind pos(5);
    Regresar  ind pos(12);
    SflClr    ind pos(81);
    SflDsp    ind pos(82);
    SflCtl    ind pos(83);
    SflEnd    ind pos(84);
END-DS;

// SUBFILE Y OPCIONES
DCL-S wRrn     PACKED(4:0);
// *ON = ENMASCARA LA TARJETA (PRIMEROS 6 Y ULTIMOS 4)
DCL-S wMascara IND INZ(*OFF);






PASO 5
--------------
DCL-F FMTCPRCLI2 WORKSTN SFILE(SFLREC:wRrn) INDDS(VNDINDIC);