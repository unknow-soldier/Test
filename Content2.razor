SELECT FTTSKY, FTTSDT, FTTSBT, FTTSOR, FTTSST, FTTSDI, FTTSCI, FTTSID, FTTSIC
FROM BNKPRD01.POP801 WHERE FTTSKY = 'ADQ_INTERFAZ' ORDER BY FTTSDT DESC;




SELECT TSTTDT, TSBTCH, COUNT(*) FROM BNKPRD01.POP802
WHERE TSTSKY = 'ADQ_INTERFAZ' GROUP BY TSTTDT, TSBTCH ORDER BY 1 DESC, 2;




SELECT AQLFIL, AQLFEP, AQLSTS, AQLPERF, AQLLOTE, AQLFICJ
FROM BCAH96DTA.IADQLOG ORDER BY AQLFEP DESC FETCH FIRST 10 ROWS ONLY;




SELECT TABLE_SCHEMA, TABLE_NAME FROM QSYS2.SYSTABLES
WHERE TABLE_SCHEMA = 'BNKPRDHI' AND TABLE_NAME LIKE 'POP80%';