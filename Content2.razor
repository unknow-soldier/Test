PGM
  DCL VAR(&GUID)  TYPE(*CHAR) LEN(100)
  DCL VAR(&NUMD)  TYPE(*CHAR) LEN(1)   VALUE('4')
  DCL VAR(&ENVC)  TYPE(*CHAR) LEN(1)   VALUE('N')
  DCL VAR(&CANAL) TYPE(*CHAR) LEN(1)   VALUE('T')
  DCL VAR(&RESP)  TYPE(*CHAR) LEN(15)
  DCL VAR(&ERR)   TYPE(*CHAR) LEN(5)
  DCL VAR(&MSG)   TYPE(*CHAR) LEN(100)
  DCL VAR(&TXT)   TYPE(*CHAR) LEN(132)

  ADDLIBLE LIB(PORREGPGM)
  MONMSG MSGID(CPF2103)
  ADDLIBLE LIB(PORREGDTA)
  MONMSG MSGID(CPF2103)
  ADDLIBLE LIB(BCAH96DTA)
  MONMSG MSGID(CPF2103)
  ADDLIBLE LIB(BCAH96)
  MONMSG MSGID(CPF2103)
  ADDLIBLE LIB(BNKPRD01)
  MONMSG MSGID(CPF2103)
  ADDLIBLE LIB(ICBSUSER)
  MONMSG MSGID(CPF2103)

  /* CASO 1: FEMISION en yyyymmdd */
  CHGVAR VAR(&GUID) VALUE('00013691121021214165')
  CALLSUBR SUBR(RUN)

  /* CASO 2: FEMISION en ddmmyyyy */
  CHGVAR VAR(&GUID) VALUE('5FDA45B1-CDF7-4FFE-A43E-E53BC2BEF285')
  CALLSUBR SUBR(RUN)

  SUBR SUBR(RUN)
    CHGVAR VAR(&RESP) VALUE(' ')
    CHGVAR VAR(&ERR)  VALUE(' ')
    CHGVAR VAR(&MSG)  VALUE(' ')
    CALL PGM(DAB11INICL) PARM(&GUID &NUMD &ENVC &CANAL +
         &RESP &ERR &MSG)
    CHGVAR VAR(&TXT) VALUE('ERR=' *CAT &ERR *CAT ' MSG=' *CAT &MSG)
    SNDPGMMSG MSG(&TXT) TOPGMQ(*EXT)
  ENDSUBR
ENDPGM