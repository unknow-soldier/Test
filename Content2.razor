     PGM                                                 
                                                         
     /* Declaración de variables con los tipos exactos */  
     DCL        VAR(&CIF) TYPE(*CHAR) LEN(10) VALUE('0000000123') 
     DCL        VAR(&APLIC) TYPE(*DEC) LEN(2 0) VALUE(85)        
     DCL        VAR(&CUENTA) TYPE(*DEC) LEN(16 0) VALUE(1234567890123456)
                                                         
     /* Llamada al programa RPGLE pasándole los parámetros */
     CALL       PGM(TU_BIBLIOTECA/TU_PROGRAMA) PARM(&CIF &APLIC &CUENTA)
                                                         
     ENDPGM                                              


