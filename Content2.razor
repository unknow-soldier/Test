**FREE
//* ===========================================================
//* PGUNITCNES - CONSULTA REMESAS EN LINEA UNITELLER
//* Pantallas : FMTUNITCEL (@CONSULTAR, @BENEFICIA,
//*             @REMITENTE, @REFERENCI)
//* Tabla     : BCAH96DTA.UTLRACTA (solo lectura)
//* Teclas    : F3 Salir | F5 Renovar | F12 Regresar/Cancelar
//* ===========================================================

//* CONFIGURACIONES Y COPYRIGHT
CTL-OPT
  OPTION(*NODEBUGIO:*SRCSTMT:*NOUNREF)
  DFTACTGRP(*NO) ACTGRP(*NEW) DATEDIT(*DMY) DATFMT(*ISO)
  ALWNULL(*USRCTL)
  COPYRIGHT('© BANCO DAVIVIENDA HONDURAS S.A.| V1.0.0 20250819 | EXTTCPG01');

//* INCLUDES
/COPY BCAH96/QRPGLESRC,COPYRIGHT

//* DECLARACION DE ARCHIVOS
// SFILE queda por herencia de la plantilla (el DDS aun tiene el
// formato MTCADISFL). No se usa en ninguna de las 4 pantallas.
DCL-F FMTUNITCEL WORKSTN USAGE(*INPUT:*OUTPUT)
             SFILE(MTCADISFL:NRR)
             INDDS(VNDINDIC);

//* VARIABLES GLOBALES
DCL-S NRR ZONED(5:0) INZ(0);

// INDICADORES DE TECLAS (numero de indicador = numero de tecla)
DCL-DS VNDINDIC QUALIFIED;
  Salir     IND POS(3);
  Renovar   IND POS(5);
  Regresar  IND POS(12);
END-DS;

//* CONSTANTES - PANTALLAS DEL FLUJO
DCL-C PAN_SALIR    0;
DCL-C PAN_CONSULTA 1;
DCL-C PAN_BENEF    2;
DCL-C PAN_REMIT    3;
DCL-C PAN_REFER    4;

//* PROGRAMAS EXTERNOS
// TRAE EL NOMBRE DEL BANCO
DCL-PR BCONAMEPGM EXTPGM('BCAH96/BCONAMEPGM');
  *N CHAR(40);
END-PR;

//* PROGRAM STATUS
DCL-DS PGM_STATUS PSDS;
  PROGRAM CHAR(10) POS(01);
END-DS;

//* MAINLINE
EXEC SQL SET OPTION COMMIT = *NONE;
PRINICIALIZA();
PRFLUJO();
*INLR = *ON;
RETURN;

//* ===========================================================
//* PROCEDURES
//* ===========================================================

//* DATOS DE CABECERA (PROGRAMA Y BANCO)
DCL-PROC PRINICIALIZA;
  DCL-PI *N; END-PI;
  DCL-S BCONAME CHAR(40) INZ('');

  CALLP BCONAMEPGM(BCONAME);
  NOMBCO = BCONAME;
  NOMPGM = PROGRAM;
END-PROC;

//* FLUJO PRINCIPAL: cada pantalla devuelve cual sigue
DCL-PROC PRFLUJO;
  DCL-PI *N; END-PI;
  DCL-S pantalla INT(5) INZ(PAN_CONSULTA);

  DOW pantalla <> PAN_SALIR;
    SELECT;
      WHEN pantalla = PAN_CONSULTA;
        pantalla = PRPANCONSULTA();
      WHEN pantalla = PAN_BENEF;
        pantalla = PRPANBENEF();
      WHEN pantalla = PAN_REMIT;
        pantalla = PRPANREMIT();
      WHEN pantalla = PAN_REFER;
        pantalla = PRPANREFER();
      OTHER;
        pantalla = PAN_SALIR;
    ENDSL;
  ENDDO;
END-PROC;

//* PANTALLA 1: @CONSULTAR
DCL-PROC PRPANCONSULTA;
  DCL-PI *N INT(5); END-PI;

  CLEAR VNDINDIC;
  EXFMT @CONSULTAR;

  // F3 y F12 salen del programa; F5 limpia la referencia
  SELECT;
    WHEN VNDINDIC.Salir OR VNDINDIC.Regresar;
      RETURN PAN_SALIR;
    WHEN VNDINDIC.Renovar;
      REFREMESA = 0;
      RETURN PAN_CONSULTA;
  ENDSL;

  // Enter: la referencia debe tener 10 digitos e iniciar con 5
  IF REFREMESA < 5000000000 OR REFREMESA > 5999999999;
    PRMENSAJE('REFERENCIA INVALIDA');
    RETURN PAN_CONSULTA;
  ENDIF;

  IF PRCARGADATOS();
    RETURN PAN_BENEF;
  ENDIF;

  RETURN PAN_CONSULTA;
END-PROC;

//* PANTALLA 2: @BENEFICIA
DCL-PROC PRPANBENEF;
  DCL-PI *N INT(5); END-PI;

  CLEAR VNDINDIC;
  EXFMT @BENEFICIA;

  SELECT;
    WHEN VNDINDIC.Salir;
      RETURN PAN_SALIR;
    WHEN VNDINDIC.Regresar;
      RETURN PAN_CONSULTA;
    WHEN VNDINDIC.Renovar;
      IF PRCARGADATOS();
        RETURN PAN_BENEF;
      ENDIF;
      RETURN PAN_CONSULTA;
  ENDSL;

  RETURN PAN_REMIT;
END-PROC;

//* PANTALLA 3: @REMITENTE
DCL-PROC PRPANREMIT;
  DCL-PI *N INT(5); END-PI;

  CLEAR VNDINDIC;
  EXFMT @REMITENTE;

  SELECT;
    WHEN VNDINDIC.Salir;
      RETURN PAN_SALIR;
    WHEN VNDINDIC.Regresar;
      RETURN PAN_BENEF;
    WHEN VNDINDIC.Renovar;
      IF PRCARGADATOS();
        RETURN PAN_REMIT;
      ENDIF;
      RETURN PAN_CONSULTA;
  ENDSL;

  RETURN PAN_REFER;
END-PROC;

//* PANTALLA 4: @REFERENCI
DCL-PROC PRPANREFER;
  DCL-PI *N INT(5); END-PI;

  CLEAR VNDINDIC;
  EXFMT @REFERENCI;

  SELECT;
    WHEN VNDINDIC.Salir;
      RETURN PAN_SALIR;
    WHEN VNDINDIC.Regresar;
      RETURN PAN_REMIT;
    WHEN VNDINDIC.Renovar;
      IF PRCARGADATOS();
        RETURN PAN_REFER;
      ENDIF;
      RETURN PAN_CONSULTA;
  ENDSL;

  // Enter en la ultima pantalla: nueva consulta
  RETURN PAN_CONSULTA;
END-PROC;

//* CARGA LOS DATOS DE LA REFERENCIA (UN SOLO SELECT)
//* Devuelve *ON si encontro la referencia, *OFF si no.
DCL-PROC PRCARGADATOS;
  DCL-PI *N IND; END-PI;

  UPAYERCD = %CHAR(REFREMESA);

  EXEC SQL
    SELECT COALESCE(USTSREM,  ''),
           COALESCE(UBENFNAM, ''),
           COALESCE(UBENMNAM, ''),
           COALESCE(UBENLNAM, ''),
           COALESCE(UBEN2NAM, ''),
           COALESCE(UBENCTRY, ''),
           COALESCE(UBENSTAT, ''),
           COALESCE(UBENPOST, ''),
           COALESCE(UBENPHON, ''),
           COALESCE(UBENCITY, ''),
           COALESCE(UBENADR1, ''),
           COALESCE(UORGCUR,  ''),
           COALESCE(UORGCNTR, ''),
           COALESCE(UORGAMT,  ''),
           COALESCE(USNDFNAM, ''),
           COALESCE(USNDMNAM, ''),
           COALESCE(USNDLNAM, ''),
           COALESCE(USND2NAM, ''),
           COALESCE(USNDSTAT, ''),
           COALESCE(USNDPOST, ''),
           COALESCE(USNDPHON, ''),
           COALESCE(USNDCITY, ''),
           COALESCE(USNDADDR, ''),
           COALESCE(UDATRECI, '')
      INTO :USTSREM,  :UBENFNAM, :UBENMNAM, :UBENLNAM, :UBEN2NAM,
           :UBENCTRY, :UBENSTAT, :UBENPOST, :UBENPHON, :UBENCITY,
           :UBENADR1, :UORGCUR,  :UORGCNTR, :UORGAMT,
           :USNDFNAM, :USNDMNAM, :USNDLNAM, :USND2NAM,
           :USNDSTAT, :USNDPOST, :USNDPHON, :USNDCITY, :USNDADDR,
           :UDATRECI
      FROM BCAH96DTA.UTLRACTA
     WHERE UPAYERCD = :UPAYERCD
     FETCH FIRST 1 ROW ONLY;

  // SQLCODE positivo (excepto 100) es solo aviso, p.ej. texto truncado
  SELECT;
    WHEN SQLCODE = 100;
      PRMENSAJE('REFERENCIA NO EXISTE');
      RETURN *OFF;
    WHEN SQLCODE < 0;
      PRMENSAJE('ERROR SQL ' + %CHAR(SQLCODE));
      RETURN *OFF;
  ENDSL;

  // Campos gemelos (sufijo 2): SQL solo llena la variable base
  UORGCNTR2 = UORGCNTR;
  UORGCUR2  = UORGCUR;
  UORGAMT2  = UORGAMT;

  RETURN *ON;
END-PROC;

//* MUESTRA UN MENSAJE EN LA VENTANA MENSAJE (max. 20 caracteres)
DCL-PROC PRMENSAJE;
  DCL-PI *N;
    pTexto CHAR(20) CONST;
  END-PI;

  MENSAJERR = pTexto;
  EXFMT MENSAJE;
  CLEAR VNDINDIC;
END-PROC;
