select column_name, data_type, length, numeric_scale
  from qsys2.syscolumns
 where table_schema = 'EVERTECDTA'
   and table_name = 'SJ0TRA'
   and column_name = 'SJ0NUM'


------------

select distinct c.CUX1CS as cif, c.CUX1AP as aplic, c.CUX1AC as cuenta12,
       t.SJ0NUM,
       hex(cast(mod(c.CUX1AC, 10000000000) as decimal(16,0))) as parm_hex
  from bnkprd01.cup00901 c
  join evertecdta.sj0tra t
    on trim(leading '0' from trim(t.SJ0NUM))
     = trim(leading '0' from trim(char(mod(c.CUX1AC, 10000000000))))
 where c.CUXBK = 1
   and c.CUX1AP = 20
 fetch first 10 rows only


