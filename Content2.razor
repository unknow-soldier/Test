SELECT CUEDAB, DABIDE, TRIM(CORREO) AS CORREO, TRIM(TELEFO) AS TELEFO,
       TRIM(CELULA) AS CELULA, TRIM(PROFES) AS PROFES, GENERO, DAEDAD,
       MONTON, MTOTAL, CUOTAN, PLAZOM, DABPLAZO, CANTITIT, DAPRIMA,
       TITINI, TITFIN, NUMCUE,
       LENGTH(TRIM(CADBEN))  AS LEN_BENEF,
       LENGTH(TRIM(VALRESCA)) AS LEN_RESCATE,
       TRIM(VALTITUL) AS VALTITUL, FEMISION, FVENCIO
FROM PORREGDTA.DAB01GLF
WHERE CUEDAB IN ('1012227942', '1021214130');






