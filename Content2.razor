SELECT SJ0NUM, SJ0NU2, SJ0NU3, SJ0TIP, SJ0EST
  FROM EVERTECDTA.SJ0TRA
 WHERE TRIM(SJ0NU2) = (SELECT TRIM(SJ0NU2)
                         FROM EVERTECDTA.SJ0TRA
                        WHERE SJ0NUM = '<tarjeta de la cuenta TC>')
 ORDER BY SJ0NU3




SELECT CUX1AP, COUNT(*)
  FROM BNKPRD01.CUP00901
 WHERE CUXBK = 1 AND TRIM(CUX1CS) = '<cif>'
   AND CUX1AP IN (85,89,90)
 GROUP BY CUX1AP




SELECT SJ0NU3, SJ0TIP, SJ0EST, COUNT(*)
  FROM EVERTECDTA.SJ0TRA
 WHERE TRIM(SJ0NU2) = '<cif>'
 GROUP BY SJ0NU3, SJ0TIP, SJ0EST
 ORDER BY 1