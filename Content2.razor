SELECT A10FIID, A10FIDT, COUNT(*), SUM(A10IMTR), SUM(A10IVCD), SUM(A10IGCI), SUM(A10ICDE), SUM(A10NETD)
FROM BCAH96DTA/ADQ10DET WHERE A10FILE = '<archivo>' AND A10CLAT = 1 GROUP BY A10FIID, A10FIDT




SELECT D.A10FIDT, SUM(I.A13MIMP) FROM BCAH96DTA/ADQ10DET D JOIN BCAH96DTA/ADQ13IMP I
ON D.A10FILE=I.A13FILE AND D.A10FIID=I.A13FIID AND D.A10COME=I.A13COME
AND D.A10TERM=I.A13TERM AND D.A10LOTE=I.A13LOTE AND D.A10NUMR=I.A13NUMR
WHERE D.A10CLAT = 1 GROUP BY D.A10FIDT