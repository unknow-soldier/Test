DCL-PROC PREJECUTARPROGRAMA;
  DCL-PI *N;
  END-PI;
  DCL-S wPgm     CHAR(10);
  DCL-S wLib     CHAR(10);
  DCL-S COMANDO  CHAR(100);
  DCL-S LONGITUD PACKED(15:5);
  DCL-S llamando IND INZ(*OFF);

  TITLEMSG1 = ' ERROR ';
  wPgm = %TRIM(REUN001001);
  wLib = %TRIM(REUN001002);

  // Validaciones previas
  IF wPgm = ' ';
    WERRMSG = 'LA OPCIÓN NO TIENE PROGRAMA ASIGNADO';
    EXFMT MSGERROR;
    RETURN;
  ENDIF;

  IF wLib = ' ';
    wLib = '*LIBL';
  ENDIF;

  MONITOR;
    // 1. Verifica que el programa exista y se tenga autorización
    COMANDO = 'CHKOBJ OBJ(' + %TRIM(wLib) + '/' + %TRIM(wPgm) +
              ') OBJTYPE(*PGM)';
    LONGITUD = %LEN(%TRIMR(COMANDO));
    QCMDEXC(COMANDO : LONGITUD);

    // 2. Ejecuta el programa
    llamando = *ON;
    COMANDO = 'CALL PGM(' + %TRIM(wLib) + '/' + %TRIM(wPgm) + ')';
    LONGITUD = %LEN(%TRIMR(COMANDO));
    QCMDEXC(COMANDO : LONGITUD);

  ON-EXCP 'CPF9801';
    IF llamando;
      WERRMSG = 'ERROR: PGM ' + %TRIM(wPgm) + ' FALLÓ (CPF9801)';
    ELSE;
      WERRMSG = 'NO EXISTE EL PGM ' + %TRIM(wPgm);
    ENDIF;
    EXFMT MSGERROR;

  ON-EXCP 'CPF9810';
    WERRMSG = 'NO EXISTE LA LIBRERÍA ' + %TRIM(wLib);
    EXFMT MSGERROR;

  ON-EXCP 'CPF9802';
    WERRMSG = 'SIN AUTORIZACIÓN AL PGM ' + %TRIM(wPgm);
    EXFMT MSGERROR;

  ON-ERROR;
    IF llamando;
      WERRMSG = 'ERROR DURANTE EL PGM ' + %TRIM(wPgm);
    ELSE;
      WERRMSG = 'NO SE PUDO VALIDAR EL PGM ' + %TRIM(wPgm);
    ENDIF;
    EXFMT MSGERROR;
  ENDMON;
END-PROC;





