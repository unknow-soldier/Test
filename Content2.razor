SELECT FTTSKY, FTTSDT, FTTSBT, FTTSOR, FTTSST,
       HHANOTR, HHMESTR, HHDIATR
FROM BNKPRDHI.POP801HI
WHERE FTTSDT IN (2026317, 2026320)
   OR (HHMESTR = 11 AND HHDIATR >= 13)
ORDER BY HHDIATR DESC
FETCH FIRST 30 ROWS ONLY




SELECT TSTSKY, TSTTDT, TSBTCH, COUNT(*)
FROM BNKPRDHI.POP802HI
WHERE TSTSKY = 'ADQ_INTERFAZ'
GROUP BY TSTSKY, TSTTDT, TSBTCH
ORDER BY 2 DESC
FETCH FIRST 10 ROWS ONLY